
-- Dear ImGui-style Roblox UI Library
-- Reusable UI components only

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local ImGuiLib = {}
ImGuiLib.__index = ImGuiLib

local Style = {
    Font = Enum.Font.Code,
    FontSize = 14,
    FrameHeight = 20,
    Padding = 8,
    Spacing = 4,

    Text = Color3.fromRGB(255, 255, 255),
    WindowBg = Color3.fromRGB(15, 15, 15),
    PopupBg = Color3.fromRGB(20, 20, 20),
    Border = Color3.fromRGB(110, 110, 128),

    Title = Color3.fromRGB(41, 74, 122),
    TitleCollapsed = Color3.fromRGB(0, 0, 0),

    Frame = Color3.fromRGB(41, 74, 122),
    FrameHover = Color3.fromRGB(66, 150, 250),
    FrameActive = Color3.fromRGB(66, 150, 250),

    Button = Color3.fromRGB(66, 150, 250),
    Tab = Color3.fromRGB(42, 77, 129),
    TabHover = Color3.fromRGB(56, 123, 203),
    TabActive = Color3.fromRGB(51, 105, 173),

    CheckMark = Color3.fromRGB(66, 150, 250),
    Slider = Color3.fromRGB(61, 133, 224),
}

local function create(className, properties, parent)
    local obj = Instance.new(className)

    for key, value in pairs(properties or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function label(parent, properties)
    properties = properties or {}

    properties.BackgroundTransparency = 1
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Style.Font
    properties.TextSize = properties.TextSize or Style.FontSize
    properties.TextColor3 = properties.TextColor3 or Style.Text
    properties.TextXAlignment =
        properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.TextYAlignment =
        properties.TextYAlignment or Enum.TextYAlignment.Center

    return create("TextLabel", properties, parent)
end

local function button(parent, properties)
    properties = properties or {}
    properties.Font = properties.Font or Style.Font
    properties.TextSize = properties.TextSize or Style.FontSize
    properties.TextColor3 = properties.TextColor3 or Style.Text

    return create("TextButton", properties, parent)
end

local function inside(gui, point)
    local pos = gui.AbsolutePosition
    local size = gui.AbsoluteSize

    return point.X >= pos.X
        and point.X <= pos.X + size.X
        and point.Y >= pos.Y
        and point.Y <= pos.Y + size.Y
end

function ImGuiLib.new(title)
    local self = setmetatable({}, ImGuiLib)

    local previous = CoreGui:FindFirstChild("ImGuiCustomLib")
    if previous then
        previous:Destroy()
    end

    self.Size = Vector2.new(380, 330)
    self.Tabs = {}
    self.ClosePopups = {}
    self.Connections = {}
    self.Destroyed = false

    local function connect(signal, callback)
        local connection = signal:Connect(callback)
        table.insert(self.Connections, connection)
        return connection
    end

    self.ScreenGui = create("ScreenGui", {
        Name = "ImGuiCustomLib",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, CoreGui)

    self.MainFrame = create("Frame", {
        Size = UDim2.fromOffset(self.Size.X, self.Size.Y),
        Position = UDim2.new(0.5, -190, 0.5, -165),
        BackgroundColor3 = Style.WindowBg,
        BorderSizePixel = 0,
        ClipsDescendants = false,
    }, self.ScreenGui)

    create("UIStroke", {
        Color = Style.Border,
        Transparency = 0.5,
        Thickness = 1,
    }, self.MainFrame)

    self.TopBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, Style.FrameHeight),
        BackgroundColor3 = Style.Title,
        BorderSizePixel = 0,
    }, self.MainFrame)

    local collapse = button(self.TopBar, {
        Size = UDim2.fromOffset(Style.FrameHeight, Style.FrameHeight),
        BackgroundTransparency = 1,
        Text = "▼",
        TextSize = 10,
        AutoButtonColor = false,
    })

    label(self.TopBar, {
        Position = UDim2.fromOffset(Style.FrameHeight + 4, 0),
        Size = UDim2.new(1, -Style.FrameHeight - 4, 1, 0),
        Text = title or "Dear ImGui Window",
    })

    self.Body = create("Frame", {
        Position = UDim2.fromOffset(0, Style.FrameHeight),
        Size = UDim2.new(1, 0, 1, -Style.FrameHeight),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, self.MainFrame)

    self.TabBar = create("Frame", {
        Position = UDim2.fromOffset(Style.Padding, Style.Padding),
        Size = UDim2.new(1, -Style.Padding * 2, 0, Style.FrameHeight),
        BackgroundTransparency = 1,
    }, self.Body)

    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    }, self.TabBar)

    self.ContentTop = Style.Padding + Style.FrameHeight + 1

    create("Frame", {
        Position = UDim2.fromOffset(Style.Padding, self.ContentTop - 1),
        Size = UDim2.new(1, -Style.Padding * 2, 0, 1),
        BackgroundColor3 = Style.TabActive,
        BorderSizePixel = 0,
    }, self.Body)

    local resize = button(self.Body, {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        Text = "◢",
        TextSize = 15,
        AutoButtonColor = false,
        ZIndex = 50,
    })

    local collapsed = false
    connect(collapse.MouseButton1Click, function()
        collapsed = not collapsed
        collapse.Text = collapsed and "▶" or "▼"
        self.Body.Visible = not collapsed
        self.MainFrame.Size = collapsed
            and UDim2.fromOffset(self.Size.X, Style.FrameHeight)
            or UDim2.fromOffset(self.Size.X, self.Size.Y)
    end)

    local dragging, resizing = false, false
    local dragStart, startPos, resizeStart, sizeStart

    connect(self.TopBar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
        end
    end)

    connect(resize.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            resizeStart = input.Position
            sizeStart = self.Size
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        if dragging and dragStart and startPos then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        elseif resizing and resizeStart and sizeStart then
            local delta = input.Position - resizeStart

            self.Size = Vector2.new(
                math.max(260, sizeStart.X + delta.X),
                math.max(140, sizeStart.Y + delta.Y)
            )

            self.MainFrame.Size = UDim2.fromOffset(
                self.Size.X, self.Size.Y
            )

            for _, close in ipairs(self.ClosePopups) do
                close()
            end
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            resizing = false
        end
    end)

    self._connect = connect
    return self
end

function ImGuiLib:AddTab(tabName)
    local window = self

    local tab = {
        Active = false,
        Hovered = false,
    }

    local textSize = TextService:GetTextSize(
        tabName,
        Style.FontSize,
        Style.Font,
        Vector2.new(1000, 100)
    )

    tab.Button = button(self.TabBar, {
        Size = UDim2.fromOffset(textSize.X + 16, Style.FrameHeight),
        BackgroundColor3 = Style.Tab,
        BorderSizePixel = 0,
        Text = tabName,
        LayoutOrder = #self.Tabs + 1,
        AutoButtonColor = false,
    })

    create("UICorner", {
        CornerRadius = UDim.new(0, 3),
    }, tab.Button)

    tab.Content = create("ScrollingFrame", {
        Position = UDim2.fromOffset(0, self.ContentTop),
        Size = UDim2.new(1, 0, 1, -self.ContentTop),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 8,
        ScrollBarImageColor3 = Color3.fromRGB(79, 79, 79),
        Visible = false,
    }, self.Body)

    create("UIPadding", {
        PaddingLeft = UDim.new(0, Style.Padding),
        PaddingRight = UDim.new(0, Style.Padding),
        PaddingTop = UDim.new(0, Style.Spacing),
        PaddingBottom = UDim.new(0, Style.Padding),
    }, tab.Content)

    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, Style.Spacing),
    }, tab.Content)

    local function refresh()
        tab.Button.BackgroundColor3 = tab.Active
            and Style.TabActive
            or (tab.Hovered and Style.TabHover or Style.Tab)
    end

    local function selectTab()
        for _, other in ipairs(window.Tabs) do
            other.Active = false
            other.Content.Visible = false
            other.Button.BackgroundColor3 = Style.Tab
        end

        tab.Active = true
        tab.Content.Visible = true
        window.ActiveTabContent = tab.Content
        refresh()

        for _, close in ipairs(window.ClosePopups) do
            close()
        end
    end

    window._connect(tab.Button.MouseEnter, function()
        tab.Hovered = true
        refresh()
    end)

    window._connect(tab.Button.MouseLeave, function()
        tab.Hovered = false
        refresh()
    end)

    window._connect(tab.Button.MouseButton1Click, selectTab)

    table.insert(window.Tabs, tab)

    local api = {}

    function api:AddCheckbox(name, defaultState, callback)
        local value = defaultState == true

        local row = button(tab.Content, {
            Size = UDim2.new(1, 0, 0, Style.FrameHeight),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local box = create("Frame", {
            Size = UDim2.fromOffset(Style.FrameHeight, Style.FrameHeight),
            BackgroundColor3 = Style.Frame,
            BorderSizePixel = 0,
        }, row)

        local check = label(box, {
            Size = UDim2.fromScale(1, 1),
            Text = "✓",
            TextColor3 = Style.CheckMark,
            TextSize = 17,
            TextXAlignment = Enum.TextXAlignment.Center,
            Visible = value,
        })

        label(row, {
            Position = UDim2.fromOffset(Style.FrameHeight + 6, 0),
            Size = UDim2.new(1, -Style.FrameHeight - 6, 1, 0),
            Text = name,
        })

        local control = {}

        function control:GetValue()
            return value
        end

        function control:SetValue(newValue)
            value = newValue == true
            check.Visible = value
            if callback then
                task.spawn(callback, value)
            end
        end

        window._connect(row.MouseEnter, function()
            box.BackgroundColor3 = Style.FrameHover
        end)

        window._connect(row.MouseLeave, function()
            box.BackgroundColor3 = Style.Frame
        end)

        window._connect(row.MouseButton1Click, function()
            control:SetValue(not value)
        end)

        return control
    end

    function api:AddSlider(name, min, max, defaultValue, step, callback)
        min = tonumber(min) or 0
        max = tonumber(max) or 100
        step = math.max(tonumber(step) or 1, 0.0001)

        if max < min then
            min, max = max, min
        end

        local value = math.clamp(
            tonumber(defaultValue) or min, min, max
        )

        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, Style.FrameHeight),
            BackgroundTransparency = 1,
        }, tab.Content)

        local track = button(row, {
            Size = UDim2.new(0.65, 0, 1, 0),
            BackgroundColor3 = Style.Frame,
            Text = "",
            AutoButtonColor = false,
            ClipsDescendants = true,
        })

        local fill = create("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Style.Slider,
            BorderSizePixel = 0,
        }, track)

        local valueLabel = label(track, {
            Size = UDim2.fromScale(1, 1),
            Text = tostring(value),
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 2,
        })

        label(row, {
            Position = UDim2.new(0.65, 6, 0, 0),
            Size = UDim2.new(0.35, -6, 1, 0),
            Text = name,
        })

        local dragging = false
        local control = {}

        local function refresh()
            local alpha = max == min and 0 or (value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            valueLabel.Text = tostring(value)
        end

        local function setValue(newValue)
            newValue = math.clamp(newValue, min, max)
            newValue = min + math.floor((newValue - min) / step + 0.5) * step
            newValue = math.clamp(newValue, min, max)

            if value == newValue then
                refresh()
                return
            end

            value = newValue
            refresh()

            if callback then
                task.spawn(callback, value)
            end
        end

        local function updateFromMouse(x)
            local width = track.AbsoluteSize.X
            if width <= 0 then return end

            local alpha = math.clamp(
                (x - track.AbsolutePosition.X) / width, 0, 1
            )

            setValue(min + alpha * (max - min))
        end

        window._connect(track.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateFromMouse(input.Position.X)
            end
        end)

        window._connect(UserInputService.InputChanged, function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateFromMouse(input.Position.X)
            end
        end)

        window._connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        function control:GetValue()
            return value
        end

        function control:SetValue(newValue)
            setValue(tonumber(newValue) or min)
        end

        refresh()
        return control
    end

    api.AddArrowSlider = api.AddSlider

    function api:AddDropdown(name, options, defaultOption, callback)
        options = options or {}

        local selected = defaultOption
        local found = false

        for _, option in ipairs(options) do
            if option == selected then
                found = true
                break
            end
        end

        if not found then
            selected = options[1]
        end

        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, Style.FrameHeight),
            BackgroundTransparency = 1,
        }, tab.Content)

        local combo = button(row, {
            Size = UDim2.new(0.65, 0, 1, 0),
            BackgroundColor3 = Style.Frame,
            Text = "",
            AutoButtonColor = false,
        })

        label(combo, {
            Position = UDim2.fromOffset(4, 0),
            Size = UDim2.new(1, -28, 1, 0),
            Text = tostring(selected or ""),
        })

        local selectedLabel = combo:FindFirstChildOfClass("TextLabel")

        label(row, {
            Position = UDim2.new(0.65, 6, 0, 0),
            Size = UDim2.new(0.35, -6, 1, 0),
            Text = name,
        })

        local popup = create("Frame", {
            Size = UDim2.fromOffset(100, 100),
            BackgroundColor3 = Style.PopupBg,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 100,
        }, window.ScreenGui)

        create("UIStroke", {
            Color = Style.Border,
            Transparency = 0.35,
        }, popup)

        local layout = create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, popup)

        local open = false
        local control = {}

        local function setOpen(state)
            open = state
            popup.Visible = state

            if state then
                local pos = combo.AbsolutePosition
                popup.Position = UDim2.fromOffset(
                    pos.X,
                    pos.Y + combo.AbsoluteSize.Y
                )
                popup.Size = UDim2.fromOffset(
                    combo.AbsoluteSize.X,
                    math.max(1, #options * Style.FrameHeight)
                )
                popup.ZIndex = 100
            end
        end

        local function setValue(option)
            selected = option
            selectedLabel.Text = tostring(option)
            setOpen(false)

            if callback then
                task.spawn(callback, option)
            end
        end

        for _, option in ipairs(options) do
            local item = button(popup, {
                Size = UDim2.new(1, 0, 0, Style.FrameHeight),
                BackgroundTransparency = 1,
                Text = tostring(option),
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                ZIndex = 101,
            })

            item.MouseEnter:Connect(function()
                item.BackgroundTransparency = 0
                item.BackgroundColor3 = Style.FrameHover
            end)

            item.MouseLeave:Connect(function()
                item.BackgroundTransparency = 1
            end)

            item.MouseButton1Click:Connect(function()
                setValue(option)
            end)
        end

        window._connect(combo.MouseButton1Click, function()
            setOpen(not open)
        end)

        window._connect(UserInputService.InputBegan, function(input)
            if not open or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end

            local point = Vector2.new(input.Position.X, input.Position.Y)

            if not inside(popup, point) and not inside(combo, point) then
                setOpen(false)
            end
        end)

        window._connect(tab.Content:GetPropertyChangedSignal("CanvasPosition"), function()
            if open then setOpen(false) end
        end)

        table.insert(window.ClosePopups, function()
            if open then setOpen(false) end
        end)

        function control:GetValue()
            return selected
        end

        function control:SetValue(option)
            for _, validOption in ipairs(options) do
                if validOption == option then
                    setValue(option)
                    return true
                end
            end

            return false
        end

        return control
    end

    api.AddCheckbox = api.AddCheckbox
    tab.API = api

    if not self.ActiveTabContent then
        tab.Button.BackgroundColor3 = Style.TabActive
        tab.Active = true
        tab.Content.Visible = true
        self.ActiveTabContent = tab.Content
    end

    return api
end

function ImGuiLib:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for _, close in ipairs(self.ClosePopups) do
        pcall(close)
    end

    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

return ImGuiLib
