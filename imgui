local function create(className, properties, parent)
	local instance = Instance.new(className)

	for key, value in pairs(properties) do
		instance[key] = value
	end

	instance.Parent = parent
	return instance
end

local function paint(instance, pair)
	instance.BackgroundColor3 = pair[1]
	instance.BackgroundTransparency = pair[2]
end

local function label(parent, properties)
	local props = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Style.Font,
		TextSize = Style.FontSize,
		TextColor3 = Style.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}

	for key, value in pairs(properties) do
		props[key] = value
	end

	return create("TextLabel", props, parent)
end

local function isInside(guiObject, point)
	local pos = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize

	return point.X >= pos.X
		and point.X <= pos.X + size.X
		and point.Y >= pos.Y
		and point.Y <= pos.Y + size.Y
end

local function drawLine(parent, a, b, thickness, color)
	local delta = b - a

	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(
			(a.X + b.X) / 2,
			(a.Y + b.Y) / 2
		),
		Size = UDim2.fromOffset(
			delta.Magnitude + thickness * 0.5,
			thickness
		),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, parent)
end

local ImGuiLib = {}
ImGuiLib.__index = ImGuiLib

function ImGuiLib.CreateWindow(windowTitle)
	local self = setmetatable({}, ImGuiLib)

	local TITLE_H = Style.FrameHeight
	local MIN_SIZE = Vector2.new(260, 140)

	self.Size = Vector2.new(380, 330)
	self.Tabs = {}
	self.ClosePopups = {}
	self.ActiveTabContent = nil
	self._connections = {}

	self.ScreenGui = create("ScreenGui", {
		Name = "ImGuiCustomLib",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 100,
	}, CoreGui)

	-- Dedicated popup layer prevents dropdowns being clipped
	-- by the window's scrolling content.
	self.PopupLayer = create("Frame", {
		Name = "PopupLayer",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 500,
		Active = false,
	}, self.ScreenGui)

	self.MainFrame = create("Frame", {
		Size = UDim2.fromOffset(self.Size.X, self.Size.Y),
		Position = UDim2.new(
			0.5, -self.Size.X / 2,
			0.5, -self.Size.Y / 2
		),
		BorderSizePixel = 0,
		ClipsDescendants = false,
	}, self.ScreenGui)

	paint(self.MainFrame, Style.WindowBg)

	create("UIStroke", {
		Color = Style.Border[1],
		Transparency = Style.Border[2],
		Thickness = 1,
	}, self.MainFrame)

	self.TopBar = create("Frame", {
		Size = UDim2.new(1, 0, 0, TITLE_H),
		BorderSizePixel = 0,
		Active = true,
		ZIndex = 2,
	}, self.MainFrame)

	paint(self.TopBar, Style.TitleBgActive)

	local CollapseButton = create("TextButton", {
		Size = UDim2.fromOffset(TITLE_H, TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "▼",
		TextColor3 = Style.Text,
		TextSize = 10,
		Font = Style.Font,
		ZIndex = 3,
	}, self.TopBar)

	label(self.TopBar, {
		Position = UDim2.fromOffset(TITLE_H, 0),
		Size = UDim2.new(1, -TITLE_H, 1, 0),
		Text = windowTitle or "Dear ImGui Window",
		ZIndex = 2,
	})

	self.Body = create("Frame", {
		Position = UDim2.fromOffset(0, TITLE_H),
		Size = UDim2.new(1, 0, 1, -TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, self.MainFrame)

	self.TabBar = create("Frame", {
		Position = UDim2.fromOffset(
			Style.WindowPadding,
			Style.WindowPadding
		),
		Size = UDim2.new(
			1, -Style.WindowPadding * 2,
			0, Style.FrameHeight
		),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.Body)

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
	}, self.TabBar)

	local tabLineY = Style.WindowPadding + Style.FrameHeight

	local TabLine = create("Frame", {
		Position = UDim2.fromOffset(
			Style.WindowPadding,
			tabLineY
		),
		Size = UDim2.new(
			1, -Style.WindowPadding * 2,
			0, 1
		),
		BorderSizePixel = 0,
	}, self.Body)

	paint(TabLine, Style.TabActive)

	self.ContentTop = tabLineY + 1

	local ResizeGrip = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -1, 1, -1),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "◢",
		TextSize = 16,
		Font = Style.Font,
		TextColor3 = Style.ResizeGrip[1],
		TextTransparency = Style.ResizeGrip[2],
		ZIndex = 50,
	}, self.Body)

	-- Collapse
	local isCollapsed = false

	CollapseButton.MouseButton1Click:Connect(function()
		isCollapsed = not isCollapsed
		CollapseButton.Text = isCollapsed and "▶" or "▼"

		paint(
			self.TopBar,
			isCollapsed and Style.TitleBgCollapsed
				or Style.TitleBgActive
		)

		self.Body.Visible = not isCollapsed
		self.MainFrame.BackgroundTransparency =
			isCollapsed and 1 or Style.WindowBg[2]

		self.MainFrame.Size = isCollapsed
			and UDim2.fromOffset(self.Size.X, TITLE_H)
			or UDim2.fromOffset(self.Size.X, self.Size.Y)

		for _, closePopup in ipairs(self.ClosePopups) do
			closePopup()
		end
	end)

	-- Dragging and resizing
	local dragging = false
	local dragStart
	local startPos

	local resizing = false
	local resizeStart
	local sizeStart

	self.TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = UserInputService:GetMouseLocation()
			startPos = self.MainFrame.Position
		end
	end)

	ResizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = UserInputService:GetMouseLocation()
			sizeStart = self.Size
		end
	end)

	table.insert(self._connections,
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end

			local mouse = UserInputService:GetMouseLocation()

			if dragging and dragStart and startPos then
				local delta = mouse - dragStart

				self.MainFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			elseif resizing and resizeStart and sizeStart then
				local delta = mouse - resizeStart

				self.Size = Vector2.new(
					math.max(MIN_SIZE.X, sizeStart.X + delta.X),
					math.max(MIN_SIZE.Y, sizeStart.Y + delta.Y)
				)

				self.MainFrame.Size = UDim2.fromOffset(
					self.Size.X,
					self.Size.Y
				)

				for _, closePopup in ipairs(self.ClosePopups) do
					closePopup()
				end
			end
		end)
	)

	table.insert(self._connections,
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
				dragStart = nil
				startPos = nil

				resizing = false
				resizeStart = nil
				sizeStart = nil
				ResizeGrip.TextTransparency = Style.ResizeGrip[2]
			end
		end)
	)

	table.insert(self._connections,
		RunService.Heartbeat:Connect(function()
			if not UserInputService:IsMouseButtonPressed(
				Enum.UserInputType.MouseButton1
			) then
				dragging = false
				dragStart = nil
				startPos = nil

				resizing = false
				resizeStart = nil
				sizeStart = nil
				ResizeGrip.TextTransparency = Style.ResizeGrip[2]
			end
		end)
	)

	return self
end

function ImGuiLib:AddTab(tabName)
	local window = self

	local tab = {
		Active = false,
		Hovered = false,
	}

	local textWidth = TextService:GetTextSize(
		tabName,
		Style.FontSize,
		Style.Font,
		Vector2.new(1000, 100)
	).X

	tab.Button = create("TextButton", {
		Size = UDim2.fromOffset(textWidth + 12, Style.FrameHeight),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = #self.Tabs + 1,
	}, self.TabBar)

	create("UICorner", {
		CornerRadius = UDim.new(0, 4),
	}, tab.Button)

	tab.Filler = create("Frame", {
		Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, 0, 0, 4),
		BorderSizePixel = 0,
		ZIndex = 1,
	}, tab.Button)

	label(tab.Button, {
		Size = UDim2.fromScale(1, 1),
		Text = tabName,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})

	local function refreshColor()
		local pair = tab.Active and Style.TabActive
			or (tab.Hovered and Style.TabHovered or Style.Tab)

		paint(tab.Button, pair)
		paint(tab.Filler, pair)
	end

	local TabContent = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, window.ContentTop),
		Size = UDim2.new(1, 0, 1, -window.ContentTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Style.ScrollbarGrab,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Visible = false,
	}, window.Body)

	create("UIPadding", {
		PaddingLeft = UDim.new(0, Style.WindowPadding),
		PaddingRight = UDim.new(0, Style.WindowPadding),
		PaddingTop = UDim.new(0, Style.ItemSpacing),
		PaddingBottom = UDim.new(0, Style.WindowPadding),
	}, TabContent)

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, Style.ItemSpacing),
	}, TabContent)

	tab.Content = TabContent
	tab.Refresh = refreshColor

	local function selectTab()
		for _, other in ipairs(window.Tabs) do
			other.Active = false
			other.Content.Visible = false
			other.Refresh()
		end

		tab.Active = true
		TabContent.Visible = true
		window.ActiveTabContent = TabContent
		refreshColor()

		for _, closePopup in ipairs(window.ClosePopups) do
			closePopup()
		end
	end

	tab.Button.MouseEnter:Connect(function()
		tab.Hovered = true
		refreshColor()
	end)

	tab.Button.MouseLeave:Connect(function()
		tab.Hovered = false
		refreshColor()
	end)

	tab.Button.MouseButton1Click:Connect(selectTab)

	table.insert(window.Tabs, tab)
	refreshColor()

	if not window.ActiveTabContent then
		selectTab()
	end

	local tabProxy = {}

	function tabProxy:AddCheckbox(name, defaultState, callback)
		local toggled = defaultState or false
		local size = Style.FrameHeight

		local Row = create("TextButton", {
			Size = UDim2.new(1, 0, 0, size),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, TabContent)

		local Box = create("Frame", {
			Size = UDim2.fromOffset(size, size),
			BorderSizePixel = 0,
		}, Row)

		paint(Box, Style.FrameBg)

		local Check = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = toggled,
		}, Box)

		drawLine(
			Check,
			Vector2.new(3, 10),
			Vector2.new(7.7, 14.7),
			2,
			Style.CheckMark
		)

		drawLine(
			Check,
			Vector2.new(7.7, 14.7),
			Vector2.new(17.1, 5.3),
			2,
			Style.CheckMark
		)

		label(Row, {
			Position = UDim2.fromOffset(size + Style.ItemInnerSpacing, 0),
			Size = UDim2.new(1, -(size + Style.ItemInnerSpacing), 1, 0),
			Text = name,
		})

		Row.MouseButton1Click:Connect(function()
			toggled = not toggled
			Check.Visible = toggled

			if callback then
				local ok, err = pcall(callback, toggled)
				if not ok then
					warn("Checkbox callback error:", err)
				end
			end
		end)

		return Row
	end

	function tabProxy:AddSlider(name, min, max, defaultVal, callback)
		local value = math.clamp(defaultVal or min, min, max)
		local frameH = Style.FrameHeight
		local range = math.max(max - min, 1)

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Track = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)

		paint(Track, Style.FrameBg)

		local Grab = create("Frame", {
			BackgroundColor3 = Style.SliderGrab,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, Track)

		local ValueText = label(Track, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = tostring(value),
			ZIndex = 3,
		})

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local function refresh()
			local usable = math.max(Track.AbsoluteSize.X - 4, 1)
			local grabWidth = math.min(12, usable)
			local alpha = (value - min) / range

			Grab.Size = UDim2.fromOffset(grabWidth, frameH - 4)
			Grab.Position = UDim2.fromOffset(
				2 + math.max(0, usable - grabWidth) * alpha,
				2
			)

			ValueText.Text = tostring(value)
		end

		Track:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
		refresh()

		local dragging = false

		local function setFromMouse(mouseX)
			local usable = math.max(Track.AbsoluteSize.X - 4, 1)
			local grabWidth = math.min(12, usable)
			local travel = math.max(usable - grabWidth, 1)

			local alpha = math.clamp(
				(mouseX - Track.AbsolutePosition.X - 2 - grabWidth / 2) / travel,
				0,
				1
			)

			local newValue = math.floor(min + alpha * range + 0.5)

			if newValue ~= value then
				value = newValue
				refresh()

				if callback then
					pcall(callback, value)
				end
			end
		end

		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				setFromMouse(input.Position.X)
			end
		end)

		local moveConnection = UserInputService.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				setFromMouse(UserInputService:GetMouseLocation().X)
			end
		end)

		local endConnection = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)

		table.insert(window._connections, moveConnection)
		table.insert(window._connections, endConnection)

		return Row
	end


	-- FIXED DROPDOWN
	function tabProxy:AddDropdown(name, options, defaultOption, callback)
		assert(type(options) == "table" and #options > 0,
			"Dropdown requires options")

		local selected = defaultOption
		local validDefault = false

		for _, option in ipairs(options) do
			if option == selected then
				validDefault = true
				break
			end
		end

		if not validDefault then
			selected = options[1]
		end

		local frameH = Style.FrameHeight
		local itemH = 24
		local popupPad = 3
		local maxPopupHeight = 220

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = false,
		}, TabContent)

		local Combo = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 5,
		}, Row)

		paint(Combo, Style.FrameBg)

		local SelectedText = label(Combo, {
			Position = UDim2.fromOffset(Style.FramePaddingX, 0),
			Size = UDim2.new(1, -(frameH + Style.FramePaddingX), 1, 0),
			Text = tostring(selected),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 6,
		})

		local ArrowButton = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(frameH, frameH),
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = 9,
			TextColor3 = Style.Text,
			Text = "▼",
			ZIndex = 6,
		}, Combo)

		paint(ArrowButton, Style.Button)

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local Popup = create("ScrollingFrame", {
			Size = UDim2.fromOffset(100, 100),
			BackgroundColor3 = Style.PopupBg[1],
			BackgroundTransparency = Style.PopupBg[2],
			BorderSizePixel = 0,
			Visible = false,
			Active = true,
			ScrollingEnabled = true,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = Style.ScrollbarGrab,
			CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 500,
		}, window.PopupLayer)

		create("UIStroke", {
			Color = Style.Border[1],
			Transparency = Style.Border[2],
			Thickness = 1,
		}, Popup)

		create("UIPadding", {
			PaddingTop = UDim.new(0, popupPad),
			PaddingBottom = UDim.new(0, popupPad),
		}, Popup)

		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 0),
		}, Popup)

		local items = {}
		local open = false

		local function refreshItems()
			for _, item in ipairs(items) do
				if item.Option == selected then
					paint(item.Button, Style.Header)
				elseif item.Hovered then
					paint(item.Button, Style.HeaderHovered)
				else
					item.Button.BackgroundTransparency = 1
				end
			end
		end

		local function updatePosition()
			if not Combo.Parent then
				return
			end

			local comboPos = Combo.AbsolutePosition
			local comboSize = Combo.AbsoluteSize
			local screenSize = window.ScreenGui.AbsoluteSize

			local availableBelow = screenSize.Y
				- (comboPos.Y + comboSize.Y)
			local availableAbove = comboPos.Y

			local totalHeight = #options * itemH + popupPad * 2
			local popupHeight = math.min(totalHeight, maxPopupHeight)

			local showAbove = availableBelow < popupHeight
				and availableAbove > availableBelow

			local availableSpace = showAbove
				and availableAbove
				or availableBelow

			popupHeight = math.max(
				0,
				math.min(popupHeight, availableSpace - 4)
			)

			local x = math.clamp(
				comboPos.X,
				0,
				math.max(0, screenSize.X - comboSize.X)
			)

			local y

			if showAbove then
				y = comboPos.Y - popupHeight
			else
				y = comboPos.Y + comboSize.Y
			end

			y = math.clamp(
				y,
				0,
				math.max(0, screenSize.Y - popupHeight)
			)

			Popup.Position = UDim2.fromOffset(x, y)
			Popup.Size = UDim2.fromOffset(comboSize.X, popupHeight)
			Popup.CanvasPosition = Vector2.new(0, 0)
		end

		local function setOpen(state)
			if state == open then
				return
			end

			if state then
				for _, closePopup in ipairs(window.ClosePopups) do
					closePopup()
				end

				open = true
				updatePosition()
				Popup.Visible = true
				refreshItems()
			else
				open = false
				Popup.Visible = false
			end

			paint(
				Combo,
				open and Style.FrameBgHovered or Style.FrameBg
			)

			ArrowButton.Text = open and "▲" or "▼"
		end

		for index, option in ipairs(options) do
			local item = {
				Option = option,
				Hovered = false,
			}

			item.Button = create("TextButton", {
				Size = UDim2.new(1, -2, 0, itemH),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = tostring(option),
				TextColor3 = Style.Text,
				TextSize = Style.FontSize,
				Font = Style.Font,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = index,
				ZIndex = 501,
				Active = true,
			}, Popup)

			create("UIPadding", {
				PaddingLeft = UDim.new(0, Style.FramePaddingX),
				PaddingRight = UDim.new(0, Style.FramePaddingX),
			}, item.Button)

			item.Button.MouseEnter:Connect(function()
				item.Hovered = true
				refreshItems()
			end)

			item.Button.MouseLeave:Connect(function()
				item.Hovered = false
				refreshItems()
			end)

			item.Button.Activated:Connect(function()
				selected = option
				SelectedText.Text = tostring(selected)

				setOpen(false)
				refreshItems()

				if callback then
					local ok, err = pcall(callback, selected)

					if not ok then
						warn("Dropdown callback error:", err)
					end
				end
			end)

			table.insert(items, item)
		end

		Combo.Activated:Connect(function()
			setOpen(not open)
		end)

		-- Close when clicking outside, without deferring the test.
		local outsideConnection = UserInputService.InputBegan:Connect(function(input)
			if not open then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local point

			if input.UserInputType == Enum.UserInputType.Touch then
				point = input.Position
			else
				point = UserInputService:GetMouseLocation()
			end

			if not isInside(Popup, point) and not isInside(Combo, point) then
				setOpen(false)
			end
		end)

		table.insert(window._connections, outsideConnection)

		local function refreshPopupPosition()
			if open then
				updatePosition()
			end
		end

		table.insert(window._connections,
			Combo:GetPropertyChangedSignal("AbsolutePosition"):Connect(
				refreshPopupPosition
			)
		)

		table.insert(window._connections,
			Combo:GetPropertyChangedSignal("AbsoluteSize"):Connect(
				refreshPopupPosition
			)
		)

		table.insert(window._connections,
			TabContent:GetPropertyChangedSignal("CanvasPosition"):Connect(
				refreshPopupPosition
			)
		)

		table.insert(window.ClosePopups, function()
			setOpen(false)
		end)

		local api = {}

		function api:GetValue()
			return selected
		end

		function api:SetValue(value)
			for _, option in ipairs(options) do
				if option == value then
					selected = value
					SelectedText.Text = tostring(selected)
					refreshItems()
					return true
				end
			end

			return false
		end

		return api
	end
	return tabProxy
end

return ImGuiLib
