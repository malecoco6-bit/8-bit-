
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local ESP_Cache = {}

getgenv().Settings = getgenv().Settings or {
    CornerBoxEnabled = false,
    HealthBarEnabled = false
}

local Settings = getgenv().Settings

local CornerBoxActive = Settings.CornerBoxEnabled == true
local HealthBarActive = Settings.HealthBarEnabled == true

local CornerNames = {
    "TL1_O", "TL2_O", "TR1_O", "TR2_O",
    "BL1_O", "BL2_O", "BR1_O", "BR2_O",
    "TL1", "TL2", "TR1", "TR2",
    "BL1", "BL2", "BR1", "BR2"
}

local function hideObjects(objects)
    for _, obj in pairs(objects) do
        obj.Visible = false
    end
end

local function createDrawingObjects()
    local objects = {}

    -- Black outlines
    for _, name in ipairs({
        "TL1_O", "TL2_O", "TR1_O", "TR2_O",
        "BL1_O", "BL2_O", "BR1_O", "BR2_O"
    }) do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 3
        line.Color = Color3.fromRGB(0, 0, 0)
        objects[name] = line
    end

    -- White corner lines
    for _, name in ipairs({
        "TL1", "TL2", "TR1", "TR2",
        "BL1", "BL2", "BR1", "BR2"
    }) do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        line.Color = Color3.fromRGB(255, 255, 255)
        objects[name] = line
    end

    -- Health bar background
    objects.HealthBarBg = Drawing.new("Line")
    objects.HealthBarBg.Visible = false
    objects.HealthBarBg.Thickness = 3
    objects.HealthBarBg.Color = Color3.fromRGB(0, 0, 0)

    -- Health bar foreground
    objects.HealthBar = Drawing.new("Line")
    objects.HealthBar.Visible = false
    objects.HealthBar.Thickness = 1
    objects.HealthBar.Color = Color3.fromRGB(0, 255, 0)

    return objects
end

-- ==========================================================
-- CLEANUP
-- ==========================================================

local function removePlayerDrawings(player)
    local objects = ESP_Cache[player]

    if objects then
        for _, obj in pairs(objects) do
            pcall(function()
                obj:Remove()
            end)
        end

        ESP_Cache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removePlayerDrawings)

-- ==========================================================
-- PROJECT CHARACTER BOUNDING BOX
-- ==========================================================

local function getScreenBounds(character, camera)
    local cf, size = character:GetBoundingBox()
    local half = size / 2

    local corners = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y,  half.Z),
        Vector3.new(-half.X,  half.Y, -half.Z),
        Vector3.new(-half.X,  half.Y,  half.Z),
        Vector3.new( half.X, -half.Y, -half.Z),
        Vector3.new( half.X, -half.Y,  half.Z),
        Vector3.new( half.X,  half.Y, -half.Z),
        Vector3.new( half.X,  half.Y,  half.Z)
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    for _, offset in ipairs(corners) do
        local worldPosition = cf:PointToWorldSpace(offset)
        local screenPosition =
            camera:WorldToViewportPoint(worldPosition)

        if screenPosition.Z <= 0 then
            return nil
        end

        minX = math.min(minX, screenPosition.X)
        minY = math.min(minY, screenPosition.Y)
        maxX = math.max(maxX, screenPosition.X)
        maxY = math.max(maxY, screenPosition.Y)
    end

    local width = maxX - minX
    local height = maxY - minY

    if width < 1 or height < 1 then
        return nil
    end

    return minX, minY, maxX, maxY, width, height
end

-- ==========================================================
-- CORNER BOX
-- ==========================================================

local function updateCornerBox(objects, x, y, width, height)
    if not CornerBoxActive then
        for _, name in ipairs(CornerNames) do
            objects[name].Visible = false
        end
        return
    end

    local lineLen = math.clamp(
        math.min(width, height) * 0.22,
        4,
        14
    )

    local left = x
    local top = y
    local right = x + width
    local bottom = y + height

    local corners = {
        {
            {Vector2.new(left, top),
             Vector2.new(left + lineLen, top)},
            {Vector2.new(left, top),
             Vector2.new(left, top + lineLen)}
        },
        {
            {Vector2.new(right, top),
             Vector2.new(right - lineLen, top)},
            {Vector2.new(right, top),
             Vector2.new(right, top + lineLen)}
        },
        {
            {Vector2.new(left, bottom),
             Vector2.new(left + lineLen, bottom)},
            {Vector2.new(left, bottom),
             Vector2.new(left, bottom - lineLen)}
        },
        {
            {Vector2.new(right, bottom),
             Vector2.new(right - lineLen, bottom)},
            {Vector2.new(right, bottom),
             Vector2.new(right, bottom - lineLen)}
        }
    }

    local keys = {"TL", "TR", "BL", "BR"}

    for i, corner in ipairs(corners) do
        local key = keys[i]

        for j = 1, 2 do
            local from = corner[j][1]
            local to = corner[j][2]

            local outline = objects[key .. j .. "_O"]
            local foreground = objects[key .. j]

            outline.From = from
            outline.To = to
            outline.Visible = true

            foreground.From = from
            foreground.To = to
            foreground.Visible = true
        end
    end
end

-- ==========================================================
-- HEALTH BAR
-- ==========================================================

local function updateHealthBar(objects, x, y, height, humanoid)
    if not HealthBarActive or humanoid.MaxHealth <= 0 then
        objects.HealthBarBg.Visible = false
        objects.HealthBar.Visible = false
        return
    end

    local healthPct = math.clamp(
        humanoid.Health / humanoid.MaxHealth,
        0,
        1
    )

    local barX = x - 5
    local bottomY = y + height

    objects.HealthBarBg.From = Vector2.new(barX, y)
    objects.HealthBarBg.To = Vector2.new(barX, bottomY)
    objects.HealthBarBg.Visible = true

    objects.HealthBar.From = Vector2.new(
        barX,
        bottomY - height * healthPct
    )

    objects.HealthBar.To = Vector2.new(barX, bottomY)

    objects.HealthBar.Color =
        Color3.fromRGB(255, 0, 0):Lerp(
            Color3.fromRGB(0, 255, 0),
            healthPct
        )

    objects.HealthBar.Visible = true
end

-- ==========================================================
-- RENDER LOOP
-- ==========================================================

local RenderConnection = RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then
            continue
        end

        if not ESP_Cache[player] then
            local success, result = pcall(createDrawingObjects)

            if success then
                ESP_Cache[player] = result
            else
                warn("ESP creation error: " .. tostring(result))
                continue
            end
        end

        local objects = ESP_Cache[player]
        local character = player.Character

        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not character or not humanoid
            or humanoid.Health <= 0
            or (not CornerBoxActive and not HealthBarActive) then
            hideObjects(objects)
            continue
        end

        local success, x, y, right, bottom, width, height =
            pcall(function()
                return getScreenBounds(character, camera)
            end)

        if not success or not x then
            hideObjects(objects)
            continue
        end

        local viewport = camera.ViewportSize

        if right < 0 or x > viewport.X
            or bottom < 0 or y > viewport.Y then
            hideObjects(objects)
            continue
        end

        updateCornerBox(objects, x, y, width, height)
        updateHealthBar(objects, x, y, height, humanoid)
    end
end)

local function setCornerBox(state)
    CornerBoxActive = state == true
    Settings.CornerBoxEnabled = CornerBoxActive
end

local function setHealthBar(state)
    HealthBarActive = state == true
    Settings.HealthBarEnabled = HealthBarActive
end

VisualTab:AddCheckbox(
    "Corner Box ESP",
    CornerBoxActive,
    setCornerBox
)

VisualTab:AddCheckbox(
    "Health Bar Side ESP",
    HealthBarActive,
    setHealthBar
)
