local function styleChrome(self)
	local window = self.Window
	local body, top = window.Body, window.TopBar

	window.TabBar.Visible = false
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("Frame") and c.Size.Y.Offset == 1 then c.Visible = false end
		if c:IsA("TextButton") and c.Text == "◢" then c:Destroy() end
	end
	for _, c in ipairs(top:GetChildren()) do
		if c:IsA("GuiObject") then c.Visible = false end
	end
	top.Size = UDim2.new(1, 0, 0, 12)
	body.Position = UDim2.fromOffset(0, 12)
	body.Size = UDim2.new(1, 0, 1, -12)

	local line = Instance.new("Frame")
	line.Size = UDim2.new(1, 0, 0, 2)
	line.BorderSizePixel = 0
	line.BackgroundColor3 = Color3.new(1, 1, 1)
	line.Parent = top
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 34, 34)),
		ColorSequenceKeypoint.new(0.22, Color3.fromRGB(63, 208, 201)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 90, 224)),
		ColorSequenceKeypoint.new(0.78, Color3.fromRGB(224, 90, 160)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(34, 34, 34)),
	})
	grad.Parent = line

	local t0 = os.clock()
	window._connect(RunService.Heartbeat, function()
		if line.Parent then
			grad.Offset = Vector2.new(math.sin((os.clock() - t0) * 0.8) * 0.25, 0)
		end
	end)

	local bg = Instance.new("UIGradient")
	bg.Rotation = 90
	bg.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 205, 205))
	bg.Parent = window.MainFrame

	local pageTex = Instance.new("ImageLabel")
	pageTex.Name = "PageTexture"
	pageTex.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	pageTex.BorderSizePixel = 0
	pageTex.Position = UDim2.fromOffset(SIDE_W, 0)
	pageTex.Size = UDim2.new(1, -SIDE_W, 1, 0)
	pageTex.Image = self.Options.Texture or "rbxassetid://8547666218"
	pageTex.ImageColor3 = Color3.fromRGB(12, 12, 12)
	pageTex.ScaleType = Enum.ScaleType.Tile
	pageTex.TileSize = UDim2.fromOffset(8, 8)
	pageTex.ZIndex = 0
	pageTex.Parent = body

	-- visibility lock (keeps the menu hidden even if the lib tries to show it)
	local function applyVisible()
		local gui = window.MainFrame:FindFirstAncestorOfClass("ScreenGui")
		if gui then
			if gui.Enabled ~= self.Visible then gui.Enabled = self.Visible end
		elseif window.MainFrame.Visible ~= self.Visible then
			window.MainFrame.Visible = self.Visible
		end
	end
	self._applyVisible = applyVisible
	window._connect(RunService.Heartbeat, applyVisible)
end

local function relayout(self, root)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("Frame") and obj.Size.Y.Offset == H then
			local lbl, ctl
			for _, c in ipairs(obj:GetChildren()) do
				if c:IsA("TextLabel") and c.Position.X.Scale > 0.6 and c.Position.X.Scale < 0.7 then
					lbl = c
				end
			end
			if lbl then
				for _, c in ipairs(obj:GetChildren()) do
					if c ~= lbl and c:IsA("GuiObject") and math.abs(c.Size.X.Scale - 0.65) < 0.01 then
						ctl = c
						break
					end
				end
			end
			if lbl and ctl then
				lbl.TextColor3 = Color3.fromRGB(205, 205, 205)
				if lbl.Text ~= "" then
					obj.Size = UDim2.new(1, 0, 0, H * 2)
					lbl.Position = UDim2.fromOffset(2, 0)
					lbl.Size = UDim2.new(1, 0, 0, H)
					ctl.Position = UDim2.fromOffset(0, H)
				else
					ctl.Position = UDim2.fromOffset(0, 0)
				end
				ctl.Size = UDim2.new(CTL_W, 0, 0, H)
			end
		elseif obj:IsA("TextButton") and obj.Text == "" and obj.Size.Y.Offset == H then
			local box, lbl
			for _, c in ipairs(obj:GetChildren()) do
				if c:IsA("Frame") and c.Size.X.Offset == H and not c:FindFirstChildOfClass("UICorner") then box = c end
				if c:IsA("TextLabel") then lbl = c end
			end
			local check = box and box:FindFirstChildOfClass("Frame")
			if box and lbl and check and #check:GetChildren() == 2 then
				for _, l in ipairs(check:GetChildren()) do l:Destroy() end

				check.BackgroundTransparency = 0
				check.BackgroundColor3 = Color3.new(1, 1, 1)
				check.ZIndex = 3
				local cg = Instance.new("UIGradient")
				cg.Rotation = 90
				cg.Color = self.FillGrad
				cg.Parent = check
				table.insert(self._fillGrads, cg)

				local Face = Instance.new("Frame")
				Face.Size = UDim2.fromScale(1, 1)
				Face.BorderSizePixel = 0
				Face.BackgroundColor3 = FACE_IDLE
				Face.ZIndex = 1
				Face.Parent = box
				addFaceGradient(Face)

				local entry = { Face = Face, hovered = false }
				obj.MouseEnter:Connect(function() entry.hovered = true end)
				obj.MouseLeave:Connect(function() entry.hovered = false end)
				table.insert(self._checkFaces, entry)

				box.AnchorPoint = Vector2.new(0, 0.5)
				box.Position = UDim2.new(0, 4, 0.5, 0)
				box.Size = UDim2.fromOffset(9, 9)
				lbl.Position = UDim2.fromOffset(22, 0)
				lbl.Size = UDim2.new(1, -22, 1, 0)
				lbl.TextColor3 = Color3.fromRGB(190, 190, 190)
			end
		elseif obj:IsA("ScrollingFrame") then
			obj.BackgroundTransparency = 0
			obj.BackgroundColor3 = BOX_BG
			obj.ScrollBarThickness = 4
		end
	end
end

local function styleDropdowns(self, root)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("TextButton") and obj.ClipsDescendants and obj.Text == "" and not obj:GetAttribute("DDStyled") then
			local arrow, txt
			for _, c in ipairs(obj:GetChildren()) do
				if c:IsA("Frame") and c.AnchorPoint.X == 1 then arrow = c end
				if c:IsA("TextLabel") then txt = c end
			end
			if arrow and txt then
				obj:SetAttribute("DDStyled", true)
				arrow.Visible = false

				local Face = Instance.new("Frame")
				Face.Size = UDim2.fromScale(1, 1)
				Face.BorderSizePixel = 0
				Face.BackgroundColor3 = FACE_IDLE
				Face.ZIndex = 2
				Face.Parent = obj
				addFaceGradient(Face)

				txt.Size = UDim2.new(1, -18, 1, 0)
				txt.Position = UDim2.fromOffset(6, 0)
				txt.TextColor3 = DIM
				txt.ZIndex = 3

				local Arrow = Instance.new("TextLabel")
				Arrow.AnchorPoint = Vector2.new(1, 0.5)
				Arrow.Position = UDim2.new(1, -6, 0.5, 0)
				Arrow.Size = UDim2.fromOffset(10, 10)
				Arrow.BackgroundTransparency = 1
				Arrow.Font = Enum.Font.SourceSans
				Arrow.TextSize = 9
				Arrow.Text = "▼"
				Arrow.TextColor3 = ARROW_IDLE
				Arrow.ZIndex = 4
				Arrow.Parent = obj

				local entry = { Combo = obj, Face = Face, Arrow = Arrow, hovered = false, open = false }
				obj.MouseEnter:Connect(function() entry.hovered = true end)
				obj.MouseLeave:Connect(function() entry.hovered = false end)
				table.insert(self._combos, entry)
			end
		end
	end
end

local function stylePopups(self)
	local window = self.Window
	local opened = {}
	for _, p in ipairs(window.MainFrame:GetChildren()) do
		if p:IsA("Frame") and p.ZIndex == 100 and p:FindFirstChildOfClass("ScrollingFrame") and not p:GetAttribute("PopStyled") then
			p:SetAttribute("PopStyled", true)
			p.ClipsDescendants = true
			addFaceGradient(p)

			p:GetPropertyChangedSignal("Visible"):Connect(function()
				if p.Visible then
					local mx = window.MainFrame.AbsolutePosition.X
					local my = window.MainFrame.AbsolutePosition.Y
					for _, e in ipairs(self._combos) do
						local c = e.Combo
						local px = c.AbsolutePosition.X - mx
						local py = c.AbsolutePosition.Y + c.AbsoluteSize.Y - my
						if math.abs(px - p.Position.X.Offset) < 3 and math.abs(py - p.Position.Y.Offset) < 3 then
							e.open = true
							opened[p] = e
							break
						end
					end
					local target = p.Size
					if target.Y.Offset > 0 then
						p.Size = UDim2.new(target.X.Scale, target.X.Offset, 0, 0)
						TweenService:Create(p, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = target }):Play()
					end
				elseif opened[p] then
					opened[p].open = false
					opened[p] = nil
				end
			end)
		end
	end
end

local function startAnimations(self)
	self.Window._connect(RunService.Heartbeat, function(dt)
		local a = math.clamp(dt * SMOOTH, 0, 1)
		for _, e in ipairs(self._combos) do
			if e.Face.Parent then
				local want = e.open and FACE_OPEN or (e.hovered and FACE_HOVER or FACE_IDLE)
				e.Face.BackgroundColor3 = e.Face.BackgroundColor3:Lerp(want, a)
				local goal = e.open and 180 or 0
				e.Arrow.Rotation = e.Arrow.Rotation + (goal - e.Arrow.Rotation) * a
				e.Arrow.TextColor3 = e.Arrow.TextColor3:Lerp(e.open and self.Accent or ARROW_IDLE, a)
			end
		end
		for _, e in ipairs(self._checkFaces) do
			if e.Face.Parent then
				e.Face.BackgroundColor3 = e.Face.BackgroundColor3:Lerp(e.hovered and FACE_HOVER or FACE_IDLE, a)
			end
		end
	end)
end

local function styleSlider(self, api, min, max, suffix)
	if not api or not api.Row then return end
	local Row = api.Row
	local Track
	for _, c in ipairs(Row:GetChildren()) do
		if c:IsA("TextButton") then Track = c break end
	end
	if not Track then return end

	local hasLabel = Row.Size.Y.Offset > H
	Row.Size = UDim2.new(1, 0, 0, hasLabel and (H + 10) or 12)
	Track.Position = UDim2.fromOffset(0, hasLabel and (H + 2) or 3)
	Track.Size = UDim2.new(CTL_W, 0, 0, 6)
	addFaceGradient(Track)

	for _, c in ipairs(Track:GetChildren()) do
		if (c:IsA("Frame") or c:IsA("TextLabel")) and not c:IsA("UIGradient") then c.Visible = false end
	end

	local Fill = Instance.new("Frame")
	Fill.BorderSizePixel = 0
	Fill.BackgroundColor3 = Color3.new(1, 1, 1)
	Fill.Size = UDim2.new(0, 0, 1, 0)
	Fill.ZIndex = 3
	Fill.Parent = Track
	local fg = Instance.new("UIGradient")
	fg.Rotation = 90
	fg.Color = self.FillGrad
	fg.Parent = Fill
	table.insert(self._fillGrads, fg)

	local Val = Instance.new("TextLabel")
	Val.BackgroundTransparency = 1
	Val.Size = UDim2.fromOffset(46, 14)
	Val.Font = FONT
	Val.TextSize = 11
	Val.TextColor3 = Color3.new(1, 1, 1)
	Val.TextStrokeTransparency = 0.5
	Val.ZIndex = 6
	Val.Parent = Track
	bold(Val)

	local range = (max - min) ~= 0 and (max - min) or 1
	local target = math.clamp((api:Get() - min) / range, 0, 1)
	local shown = target
	local hovered = false

	local function draw()
		Fill.Size = UDim2.new(shown, 0, 1, 0)
		if shown > 0.2 then
			Val.AnchorPoint = Vector2.new(1, 0.5)
			Val.TextXAlignment = Enum.TextXAlignment.Right
		else
			Val.AnchorPoint = Vector2.new(0, 0.5)
			Val.TextXAlignment = Enum.TextXAlignment.Left
		end
		Val.Position = UDim2.new(shown, 0, 0.5, 0)
	end

	local function setText(v)
		v = tonumber(v) or min
		Val.Text = fmtNum(v) .. (suffix or "")
	end

	api:OnChanged(function(v)
		v = tonumber(v) or min
		target = math.clamp((v - min) / range, 0, 1)
		setText(v)
	end)
	setText(api:Get())
	draw()

	Track.MouseEnter:Connect(function() hovered = true end)
	Track.MouseLeave:Connect(function() hovered = false end)

	self.Window._connect(RunService.Heartbeat, function(dt)
		if not Track.Parent then return end
		if math.abs(target - shown) > 0.0004 then
			shown = shown + (target - shown) * math.clamp(dt * 18, 0, 1)
			draw()
		elseif shown ~= target then
			shown = target
			draw()
		end
		local want = hovered and FACE_HOVER or FACE_IDLE
		Track.BackgroundColor3 = Track.BackgroundColor3:Lerp(want, math.clamp(dt * SMOOTH, 0, 1))
	end)
end

-- the color swatch sits on the right end of its host (checkbox / label) row
local function moveSwatch(colorApi, hostApi, startColor)
	if not (colorApi and colorApi.Row and hostApi and hostApi.Row) then return end
	local swatch
	for _, c in ipairs(colorApi.Row:GetChildren()) do
		if c:IsA("TextButton") then swatch = c break end
	end
	if not swatch then return end
	colorApi.Row.Visible = false
	swatch.Parent = hostApi.Row
	swatch.AnchorPoint = Vector2.new(1, 0.5)
	swatch.Position = UDim2.new(1, -6, 0.5, 0)
	swatch.Size = UDim2.fromOffset(22, 12)
	swatch.ZIndex = 8
	swatch.AutoButtonColor = false
	swatch.BackgroundColor3 = startColor
	swatch.BackgroundTransparency = 0
	return swatch
end

