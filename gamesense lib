-- small [KEY] button on the right end of a checkbox row; the bound key toggles the checkbox
local function buildKeybind(self, item)
	local id, keyId = item.Id, item.KeyId
	local api = self.Widgets[id]
	local row = api and api.Row
	if not row then return end

	local kc = type(item.Opts.Keybind) == "table" and item.Opts.Keybind.Default or nil
	local key = kc
	local listening = false

	local btn = Instance.new("TextButton")
	btn.AnchorPoint = Vector2.new(1, 0.5)
	btn.Position = UDim2.new(1, item.ColorId and -34 or -6, 0.5, 0)
	btn.Size = UDim2.fromOffset(52, 14)
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Font = FONT
	btn.TextSize = 10
	btn.ZIndex = 8
	btn.Parent = row

	local function refresh()
		if not btn.Parent then return end
		if listening then
			btn.Text, btn.TextColor3 = "[...]", self.Accent
		elseif key then
			btn.Text = "[" .. (KEY_SHORT[key.Name] or key.Name:sub(1, 5):upper()) .. "]"
			btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		else
			btn.Text, btn.TextColor3 = "[NONE]", Color3.fromRGB(130, 130, 130)
		end
		self.Flags[keyId] = key
	end
	refresh()
	table.insert(self._accentHooks, refresh)
	btn.MouseButton1Click:Connect(function()
		listening = not listening
		refresh()
	end)

	self:_track(UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if listening then
			if input.KeyCode == Enum.KeyCode.Escape then
				key = nil
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				key = input.KeyCode
			end
			listening = false
			refresh()
		elseif key and input.KeyCode == key and not UserInputService:GetFocusedTextBox() then
			self.Controls[id].set(not self.Flags[id])
		end
	end))

	self.Controls[keyId] = {
		get = function() return key and key.Name or "None" end,
		set = function(name)
			key = nil
			if type(name) == "string" and name ~= "None" then
				local ok, k = pcall(function() return Enum.KeyCode[name] end)
				if ok and k then key = k end
			end
			listening = false
			refresh()
		end,
	}
end

-- =====================================================================
-- accent color
-- =====================================================================
function Library:SetAccent(c)
	self.Accent = c
	self.FillGrad = fillGradFor(c)
	for i = #self._fillGrads, 1, -1 do
		local g = self._fillGrads[i]
		if g.Parent then g.Color = self.FillGrad else table.remove(self._fillGrads, i) end
	end
	for _, f in ipairs(self._accentHooks) do pcall(f) end
end

-- =====================================================================
-- config tab (configs list + menu key + menu color + window size)
-- =====================================================================
local function cleanName(s)
	s = tostring(s or "")
	s = s:gsub("[^%w_ %-]", "")
	s = s:gsub("^%s+", "")
	s = s:gsub("%s+$", "")
	return s
end

function Library:_collect()
	local data = { values = {} }
	for id, c in pairs(self.Controls) do
		local ok, v = pcall(c.get)
		if ok and v ~= nil then data.values[id] = v end
	end
	data.menu = { key = self.MenuKey.Name, color = { self.Accent.R, self.Accent.G, self.Accent.B } }
	return data
end

function Library:_apply(data)
	for id, v in pairs(data.values or {}) do
		local c = self.Controls[id]
		if c then pcall(c.set, v) end
	end
	local m = data.menu
	if type(m) == "table" then
		if type(m.key) == "string" then
			local ok, kc = pcall(function() return Enum.KeyCode[m.key] end)
			if ok and kc then self.MenuKey = kc end
		end
		if self._refreshMenuKey then self._refreshMenuKey() end
		if type(m.color) == "table" and #m.color >= 3 then
			self:SetAccent(Color3.new(m.color[1], m.color[2], m.color[3]))
		end
	end
end

function Library:_buildConfigTab(cfgContent)
