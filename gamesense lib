	Swatch.Position = UDim2.new(1, -8, 0.5, 0)
	Swatch.Size = UDim2.fromOffset(16, 8)
	Swatch.Text = ""
	Swatch.AutoButtonColor = false
	Swatch.BorderSizePixel = 0
	Swatch.BackgroundColor3 = self.Accent
	Swatch.Parent = ColRow
	local sst = Instance.new("UIStroke")
	sst.Color = Color3.fromRGB(20, 20, 20)
	sst.Parent = Swatch
	table.insert(self._accentHooks, function()
		Swatch.BackgroundColor3 = self.Accent
		refreshKey()
		for j, r in ipairs(sizeRows) do
			r.TextColor3 = (j == sizeIndex) and self.Accent or Color3.fromRGB(190, 190, 190)
		end
	end)

	local palette = self.Options.Palette or {
		Color3.fromRGB(46, 214, 86), Color3.fromRGB(160, 200, 40), Color3.fromRGB(63, 208, 201), Color3.fromRGB(80, 140, 240),
		Color3.fromRGB(160, 90, 224), Color3.fromRGB(224, 90, 160), Color3.fromRGB(224, 70, 70), Color3.fromRGB(240, 150, 50),
	}
	local Pop = Instance.new("Frame")
	Pop.Size = UDim2.fromOffset(4 * 20 + 10, 2 * 20 + 10)
	Pop.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	Pop.BorderSizePixel = 0
	Pop.ZIndex = 200
	Pop.Visible = false
	Pop.Parent = window.MainFrame
	local pst = Instance.new("UIStroke")
	pst.Color = Color3.fromRGB(60, 60, 60)
	pst.Parent = Pop
	for i, col in ipairs(palette) do
		local Sw = Instance.new("TextButton")
		Sw.Size = UDim2.fromOffset(16, 16)
		Sw.Position = UDim2.fromOffset(5 + ((i - 1) % 4) * 20, 5 + math.floor((i - 1) / 4) * 20)
		Sw.BackgroundColor3 = col
		Sw.BorderSizePixel = 0
		Sw.Text = ""
		Sw.AutoButtonColor = false
		Sw.ZIndex = 201
		Sw.Parent = Pop
		Sw.MouseButton1Click:Connect(function()
			self:SetAccent(col)
			Pop.Visible = false
		end)
	end
	Swatch.MouseButton1Click:Connect(function()
		if Pop.Visible then Pop.Visible = false return end
		local rel = Swatch.AbsolutePosition - window.MainFrame.AbsolutePosition
		Pop.Position = UDim2.fromOffset(rel.X - Pop.Size.X.Offset + Swatch.AbsoluteSize.X, rel.Y - Pop.Size.Y.Offset - 4)
		Pop.Visible = true
	end)
end

-- =====================================================================
-- build
-- =====================================================================
function Library:Build()
	assert(not self.Built, "MenuLib: Build() was already called")

	-- 1. load ImGuiLib
	local ImGuiLib = self.Options.ImGuiLib
	if not ImGuiLib then
		local url = (self.Options.LibUrl or DEFAULT_LIB_URL) .. "?v=" .. tostring(os.time())
		local ok, res = pcall(function() return loadstring(game:HttpGet(url))() end)
		if not ok then error("MenuLib: ImGuiLib failed to load: " .. tostring(res)) end
		ImGuiLib = res
	end

	-- 2. handlers (flags are updated here, then the user callback runs)
	for _, tab in ipairs(self.Tabs) do
		for _, sec in ipairs(tab.Sections) do
			for _, it in ipairs(sec.Items) do
				local id, o = it.Id, it.Opts
				if it.Kind == "Checkbox" or it.Kind == "Slider" or it.Kind == "Dropdown" then
					self.Handlers[id] = function(v)
						self.Flags[id] = v
						if o.Callback then pcall(o.Callback, v) end
					end
				end
				if it.ColorId then
					self.Handlers[it.ColorId] = function(c, a)
						local st = self.ColorState[id]
						if typeof(c) == "Color3" then st.color = c end
						if typeof(a) == "number" then st.alpha = math.clamp(a, 0, 1) end
						self.Flags[id .. "_color"] = st.color
						self.Flags[id .. "_alpha"] = st.alpha
						if st.swatch and st.swatch.Parent then
							st.swatch.BackgroundColor3 = st.color
							st.swatch.BackgroundTransparency = 0
						end
						if st.callback then pcall(st.callback, st.color, st.alpha) end
					end
				end
			end
		end
	end

	-- 3. create the window
	self._tabIcons = {}
	for i, tab in ipairs(self.Tabs) do self._tabIcons[i] = tab.Icon end
	if self.Options.Config ~= false then self._tabIcons[#self.Tabs + 1] = self.Options.ConfigIcon end

	local window, widgets = ImGuiLib.FromJSON(self:_layout(), self.Handlers)
	self.Window, self.Widgets = window, widgets
	self:_cleanup(function()
		local gui = window.MainFrame and window.MainFrame:FindFirstAncestorOfClass("ScreenGui")
		if gui then gui:Destroy() end
	end)

	-- 4. style
	styleChrome(self)
	startAnimations(self)
	buildSideTabs(self)
	stylePopups(self)

	-- 5. controls
	for _, tab in ipairs(self.Tabs) do
		for _, sec in ipairs(tab.Sections) do
			for _, it in ipairs(sec.Items) do
				local id, o = it.Id, it.Opts
				if it.Kind == "Slider" then
					styleSlider(self, widgets[id], o.Min or 0, o.Max or 100, o.Suffix)
				end
				if it.Kind == "Checkbox" or it.Kind == "Slider" or it.Kind == "Dropdown" then
					self.Controls[id] = {
						get = function()
							local api = widgets[id]
							if api.Save then return api.Save() end
							return api:Get()
						end,
						set = function(v)
							local api = widgets[id]
							if api.Load then api.Load(v) else api:Set(v) end
							if api.Refire then api.Refire()
							elseif api.Changed then api.Changed:Fire(v)
							else self.Handlers[id](v) end
						end,
					}
				end
				if it.ColorId then
					local st = self.ColorState[id]
					st.swatch = moveSwatch(widgets[it.ColorId], widgets[id], st.color)
					self.Controls[it.ColorId] = {
						get = function() return { st.color.R, st.color.G, st.color.B, st.alpha } end,
						set = function(v)
							if type(v) == "table" and #v >= 3 then
								self.Handlers[it.ColorId](Color3.new(v[1], v[2], v[3]), tonumber(v[4]) or st.alpha)
							end
						end,
					}
				end
			end
		end
	end

	for _, tab in ipairs(self.Tabs) do
		for _, sec in ipairs(tab.Sections) do
			for _, it in ipairs(sec.Items) do
				if it.Kind == "Multi" then buildMulti(self, it)
				elseif it.Kind == "TextBox" then buildTextBox(self, it)
				elseif it.Kind == "Button" then buildButton(self, it) end
				if it.KeyId then buildKeybind(self, it) end
			end
		end
	end

	for _, tab in ipairs(self.Tabs) do
		for _, sec in ipairs(tab.Sections) do
			for _, it in ipairs(sec.Items) do
				if it.ColorId then
					local st = self.ColorState[it.Id]
					buildPicker(self, st.swatch, it.Id, st.useAlpha)
				end
			end
		end
	end

	-- close color popups when any tab scrolls
	for _, t in ipairs(window.Tabs) do
		t.Content:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			for _, close in ipairs(self._pickerClosers) do close() end
		end)
	end

	-- 6. config tab
	if self.Options.Config ~= false then
		local cfgTab = window.Tabs[#window.Tabs]
		if cfgTab then self:_buildConfigTab(cfgTab.Content) end
	end

	-- menu key works even if the config tab is disabled
	if self.Options.Config == false then
		window._connect(UserInputService.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.MenuKey
				and not UserInputService:GetFocusedTextBox() then
				self:Toggle()
			end
		end)
	end

	self.Built = true
	self._setActive(1)
	return self
end

-- =====================================================================
-- public helpers
-- =====================================================================
function Library:SetVisible(v)
	self.Visible = v and true or false
	if self._applyVisible then self._applyVisible() end
end

function Library:Toggle()
	self:SetVisible(not self.Visible)
end

function Library:SelectTab(nameOrIndex)
	if type(nameOrIndex) == "number" then
		self._setActive(nameOrIndex)
		return
	end
	for i, t in ipairs(self.Window.Tabs) do
		if t.Name == nameOrIndex then self._setActive(i) return end
	end
end

-- ScreenGui the menu lives in (parent your own overlays next to it)
function Library:GetGui()
	return self.Window and self.Window.MainFrame:FindFirstAncestorOfClass("ScreenGui")
end

function Library:Destroy()
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	table.clear(self.Conns)
end

return Library
