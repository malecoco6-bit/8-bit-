local Library = {}
Library.__index = Library
local Tab = {}
Tab.__index = Tab
local Section = {}
Section.__index = Section

local DEFAULT_LIB_URL = "https://raw.githubusercontent.com/malecoco6-bit/8-bit-/main/imgui%20lib"

-- layout constants
local H = 18
local SIDE_W = 88
local TAB_H = 72
local CTL_W = 0.62
local FONT = Enum.Font.Ubuntu
local DIM = Color3.fromRGB(170, 170, 170)
local PANEL = Color3.fromRGB(12, 12, 12)
local HOVER = Color3.fromRGB(17, 17, 17)
local BOX_BG = Color3.fromRGB(30, 30, 30)
local FACE_IDLE = Color3.fromRGB(44, 44, 44)
local FACE_HOVER = Color3.fromRGB(58, 58, 58)
local FACE_OPEN = Color3.fromRGB(52, 52, 52)
