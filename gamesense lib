			Icon.Size = UDim2.fromOffset(46, 46)
			Icon.BackgroundTransparency = 1
			Icon.Image = asset
			Icon.ScaleType = Enum.ScaleType.Fit
			Icon.ZIndex = 7
			Icon.Parent = Btn
			entry.Icon = Icon
		else
