		Btn.MouseButton1Click:Connect(function() setActive(i) end)
		sideTabs[i] = entry
	end
end

-- =====================================================================
-- GameSense-style color popup
-- =====================================================================
local function buildPicker(self, swatch, id, useAlpha)
	local window = self.Window
	local state = self.ColorState[id]
	local cid = id .. "_color"
	local gui = window.MainFrame:FindFirstAncestorOfClass("ScreenGui")
	if not gui or not swatch then return end

	local OUTLINE = Color3.fromRGB(10, 10, 10)
	local popH = useAlpha and 182 or 164

	local popup = Instance.new("Frame")
	popup.Name = "ColorPicker"
	popup.Size = UDim2.fromOffset(190, popH)
	popup.BackgroundColor3 = Color3.fromRGB(34, 34, 34)
	popup.BorderSizePixel = 0
	popup.Visible = false
	popup.ZIndex = 50
	popup.Parent = gui
	local popStroke = Instance.new("UIStroke")
	popStroke.Color = Color3.fromRGB(8, 8, 8)
	popStroke.Parent = popup
	table.insert(self._popups, popup)

	local function frame(parent, name, size, pos, color, z)
		local o = Instance.new("Frame")
		o.Name, o.Size, o.Position = name, size, pos
		o.BackgroundColor3 = color or Color3.new(1, 1, 1)
		o.BorderSizePixel = 0
		o.ZIndex = z or 51
		o.Parent = parent
		return o
	end
	local function outline(obj)
		local s = Instance.new("UIStroke")
		s.Color = OUTLINE
		s.Parent = obj
	end
	local function gradient(parent, colors, rotation, transparency)
		local g = Instance.new("UIGradient")
		local keypoints, count = {}, #colors
		for i, item in ipairs(colors) do
			local t = (count <= 1) and 0 or ((i - 1) / (count - 1))
			keypoints[i] = ColorSequenceKeypoint.new(t, item)
		end
		g.Color = ColorSequence.new(keypoints)
		g.Rotation = rotation or 0
		if transparency then g.Transparency = transparency end
		g.Parent = parent
	end
	local function checker(parent, w, h, cell, z)
		local back = frame(parent, "Checker", UDim2.fromOffset(w, h), UDim2.fromOffset(0, 0), Color3.fromRGB(150, 150, 150), z)
		back.ClipsDescendants = true
		for cx = 0, math.ceil(w / cell) - 1 do
			for cy = 0, math.ceil(h / cell) - 1 do
				if (cx + cy) % 2 == 1 then
					frame(back, "c", UDim2.fromOffset(cell, cell), UDim2.fromOffset(cx * cell, cy * cell), Color3.fromRGB(95, 95, 95), z + 1)
				end
			end
		end
		return back
	end
	local function ring(parent, size, z, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.fromOffset(size, size)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.ZIndex = z
		f.Parent = parent
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = f
		local s = Instance.new("UIStroke")
		s.Color = color
		s.Parent = f
		return f
	end

	local sv = frame(popup, "SaturationValue", UDim2.fromOffset(150, 148), UDim2.fromOffset(8, 8), Color3.fromHSV(0, 1, 1), 51)
	outline(sv)
	local white = frame(sv, "White", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.new(1, 1, 1), 52)
	gradient(white, { Color3.new(1, 1, 1), Color3.new(1, 1, 1) }, 0,
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }))
	local black = frame(sv, "Black", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.new(0, 0, 0), 53)
	gradient(black, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 90,
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }))
	local svCursor = Instance.new("Frame")
	svCursor.Size = UDim2.fromOffset(5, 5)
	svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
	svCursor.BackgroundTransparency = 1
	svCursor.ZIndex = 56
	svCursor.Parent = sv
	do
		local cc = Instance.new("UICorner")
		cc.CornerRadius = UDim.new(1, 0)
		cc.Parent = svCursor
		local rs = Instance.new("UIStroke")
		rs.Color = Color3.new(1, 1, 1)
		rs.Parent = svCursor
		ring(svCursor, 7, 55, Color3.new(0, 0, 0))
	end

	local hue = frame(popup, "Hue", UDim2.fromOffset(16, 148), UDim2.fromOffset(166, 8), Color3.new(1, 1, 1), 51)
	outline(hue)
	gradient(hue, {
		Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 0, 255),
		Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(255, 0, 0),
	}, 90)
	local hueMark = frame(hue, "HueMarker", UDim2.new(1, 2, 0, 2), UDim2.new(0, -1, 0, 0), Color3.new(1, 1, 1), 56)
	hueMark.AnchorPoint = Vector2.new(0, 0.5)
	outline(hueMark)

	local alphaBack, alphaFill, alphaMark
	if useAlpha then
		alphaBack = checker(popup, 150, 13, 4, 51)
		alphaBack.Position = UDim2.fromOffset(8, 161)
		outline(alphaBack)
		alphaFill = frame(alphaBack, "OpacityFill", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), state.color, 53)
		gradient(alphaFill, { Color3.new(1, 1, 1), Color3.new(1, 1, 1) }, 0,
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }))
		alphaMark = frame(alphaBack, "OpacityMarker", UDim2.new(0, 2, 1, 2), UDim2.new(0.5, -1, 0, -1), Color3.new(1, 1, 1), 56)
		outline(alphaMark)
	end

	local h, sat, val = Color3.toHSV(state.color)
	local opacity = state.alpha
	local dragMode
	local function update()
		local c = Color3.fromHSV(h, sat, val)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(sat, 1 - val)
		hueMark.Position = UDim2.new(0, -1, 1 - h, 0)
		if useAlpha then
			alphaFill.BackgroundColor3 = c
			alphaMark.Position = UDim2.new(opacity, -1, 0, -1)
		end
		self.Handlers[cid](c, opacity)
	end
	local function setFromPointer(mode, input)
		local obj = mode == "sv" and sv or (mode == "hue" and hue or alphaBack)
		local p, sz = obj.AbsolutePosition, obj.AbsoluteSize
		local x = math.clamp((input.Position.X - p.X) / sz.X, 0, 1)
		local y = math.clamp((input.Position.Y - p.Y) / sz.Y, 0, 1)
		if mode == "sv" then sat, val = x, 1 - y
		elseif mode == "hue" then h = 1 - y
		else opacity = x end
		update()
	end
	local function beginDrag(mode, input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragMode = mode
			setFromPointer(mode, input)
		end
	end
	sv.InputBegan:Connect(function(i) beginDrag("sv", i) end)
	hue.InputBegan:Connect(function(i) beginDrag("hue", i) end)
	if useAlpha then alphaBack.InputBegan:Connect(function(i) beginDrag("alpha", i) end) end

	self:_track(UserInputService.InputChanged:Connect(function(i)
		if dragMode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFromPointer(dragMode, i)
		end
	end))
	self:_track(UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragMode = nil
		end
	end))

	-- invisible hit target on top of the library's own swatch button
	local hit = Instance.new("TextButton")
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.BorderSizePixel = 0
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = swatch.ZIndex + 2
	hit.Parent = swatch
	hit.Activated:Connect(function()
		local willOpen = not popup.Visible
		for _, p in ipairs(self._popups) do p.Visible = false end
		for cs in pairs(self.ColorState) do
			local w = self.Widgets[cs .. "_color"]
			if w and w.Close then pcall(function() w:Close() end) end
		end
		popup.Visible = willOpen
		if willOpen then
			local p = swatch.AbsolutePosition
			local main = window.MainFrame
			local rightOfWindow = main.AbsolutePosition.X + main.AbsoluteSize.X + 8
			local maxX = math.max(4, gui.AbsoluteSize.X - popup.AbsoluteSize.X - 4)
			popup.Position = UDim2.fromOffset(
				math.clamp(rightOfWindow, 4, maxX),
				math.clamp(p.Y + 14, 4, math.max(4, gui.AbsoluteSize.Y - popup.AbsoluteSize.Y - 4)))
			h, sat, val = Color3.toHSV(state.color)
			opacity = state.alpha
			update()
		end
	end)
	self:_track(UserInputService.InputBegan:Connect(function(i)
		if popup.Visible and i.UserInputType == Enum.UserInputType.MouseButton1 then
			if not inside(popup, i.Position) and not inside(swatch, i.Position) then popup.Visible = false end
		end
	end))
	table.insert(self._pickerClosers, function() popup.Visible = false end)
	update()
end

