		local json
		if hasFS then
			local p = DIR .. "/" .. name .. ".json"
			if isfile(p) then json = readfile(p) end
		else
			json = memStore[name]
		end
		if not json then return nil end
		local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
		return ok and data or nil
