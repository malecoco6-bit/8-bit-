local KEY_SHORT = {
	RightShift = "RSHFT", LeftShift = "LSHFT", RightControl = "RCTRL", LeftControl = "LCTRL",
	RightAlt = "RALT", LeftAlt = "LALT", Insert = "INS", Delete = "DEL",
