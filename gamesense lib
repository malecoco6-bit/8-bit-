		Btn.BackgroundTransparency = 1
		Btn.BorderSizePixel = 0
		Btn.AutoButtonColor = false
		Btn.Text = ""
		Btn.LayoutOrder = i
		Btn.ZIndex = 6
		Btn.Parent = Side

		local entry = { Btn = Btn }
		tab.Content.BackgroundTransparency = 1

		local Box = Instance.new("ImageLabel")
