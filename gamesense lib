--[[
	MenuLib - GameSense-style menu built on top of ImGuiLib.

	local MenuLib = loadstring(readfile("MenuLib.lua"))()   -- or game:HttpGet(...)
	local win = MenuLib.new({ Title = "My menu", Accent = Color3.fromRGB(160, 200, 40) })

	local tab = win:AddTab("Main", "rbxassetid://123")        -- icon optional (id / url / nil -> text)
	local sec = tab:AddSection("Section", 1)                 -- column 1 or 2
	sec:AddCheckbox{ Id = "esp", Text = "ESP", Default = false, Callback = function(v) end,
	                 Color = { Default = Color3.new(1,0,0), Alpha = 0.5, Callback = function(c, a) end },
	                 Keybind = true }
	sec:AddSlider{ Id = "fov", Text = "FOV", Min = 10, Max = 500, Default = 120, Step = 1, Suffix = "" }
	sec:AddDropdown{ Id = "part", Text = "Part", Options = {"Head","Torso"}, Default = "Head" }
	sec:AddMultiDropdown{ Id = "teams", Text = "Teams", Options = function() ... end }
	sec:AddTextBox{ Id = "sound", Text = "Sound ID", Numeric = true }
	sec:AddButton{ Text = "Do it", Callback = function() end }
	win:Build()

	win.Flags.fov            -- current value of any control
	win.Flags.esp_color      -- color controls: <id>_color and <id>_alpha
	win.Flags.teams          -- multi dropdown: set table { [name] = true }
]]

