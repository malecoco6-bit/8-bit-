local function buildMulti(self, item)
	local o, id = item.Opts, item.Id
	local holder = makeHolder(self.Widgets[id], 36)
	if not holder then return end
	makeRowLabel(holder, o.Text or id)
	local combo, comboTxt, arrow = makeCombo(self, holder, 16)

	local list = Instance.new("ScrollingFrame")
	list.BackgroundColor3 = Color3.fromRGB(34, 34, 34)
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 3
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Visible = false
	list.ZIndex = 150
	list.Parent = self.Window.MainFrame
	local ls = Instance.new("UIStroke")
	ls.Color = Color3.fromRGB(8, 8, 8)
	ls.Parent = list
	local ll = Instance.new("UIListLayout")
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = list

	local selected = self.Flags[id] -- set table { [name] = true }
	local rows = {}

	local function options()
		local opts = o.Options
		if type(opts) == "function" then
			local ok, res = pcall(opts)
			opts = ok and res or {}
		end
		return opts or {}
	end

	local function fire()
		if o.Callback then pcall(o.Callback, selected) end
	end

	local function summary()
		local picked = {}
		for _, n in ipairs(options()) do
			if selected[n] then picked[#picked + 1] = n end
		end
		comboTxt.Text = (#picked == 0) and "None" or table.concat(picked, ", ")
	end

	local function paint()
		for n, r in pairs(rows) do
			r.TextColor3 = selected[n] and self.Accent or Color3.fromRGB(190, 190, 190)
		end
		summary()
	end

	local function setOpen(open)
		list.Visible = open
		arrow.Text = open and "▲" or "▼"
		arrow.TextColor3 = open and self.Accent or ARROW_IDLE
		if open then
			local rel = combo.AbsolutePosition - self.Window.MainFrame.AbsolutePosition
			local n = math.max(#options(), 1)
			list.Position = UDim2.fromOffset(rel.X, rel.Y + H + 2)
			list.Size = UDim2.fromOffset(combo.AbsoluteSize.X, math.min(n, 7) * H)
		end
	end

	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		rows = {}
		local opts = options()
		if #opts == 0 then
			local R = Instance.new("TextButton")
			R.Size = UDim2.new(1, 0, 0, H)
			R.BackgroundTransparency = 1
			R.BorderSizePixel = 0
			R.AutoButtonColor = false
			R.Font = FONT
			R.TextSize = 11
			R.Text = o.EmptyText or "Nothing to pick"
			R.TextColor3 = Color3.fromRGB(120, 120, 120)
			R.ZIndex = 151
			R.Parent = list
		end
		for i, name in ipairs(opts) do
			local R = Instance.new("TextButton")
			R.Size = UDim2.new(1, 0, 0, H)
			R.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			R.BackgroundTransparency = 1
			R.BorderSizePixel = 0
			R.AutoButtonColor = false
			R.Font = FONT
			R.TextSize = 11
			R.Text = name
			R.TextXAlignment = Enum.TextXAlignment.Left
			R.LayoutOrder = i
			R.ZIndex = 151
			R.Parent = list
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 6)
			pad.Parent = R
			R.MouseEnter:Connect(function() R.BackgroundTransparency = 0.5 end)
			R.MouseLeave:Connect(function() R.BackgroundTransparency = 1 end)
			R.MouseButton1Click:Connect(function()
				selected[name] = (not selected[name]) or nil
				paint()
				fire()
			end)
			rows[name] = R
		end
		paint()
	end

	self._refresh[id] = rebuild
	table.insert(self._accentHooks, paint)
	rebuild()

	combo.MouseButton1Click:Connect(function() setOpen(not list.Visible) end)
	combo:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		if list.Visible then setOpen(false) end
	end)
	self:_track(UserInputService.InputBegan:Connect(function(i)
