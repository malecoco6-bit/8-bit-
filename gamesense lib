		Box.BorderSizePixel = 0
		Box.Size = UDim2.new(1, 1, 1, 0)
		Box.Image = self.Options.Texture or "rbxassetid://8547666218"
		Box.ImageColor3 = Color3.fromRGB(12, 12, 12)
		Box.ScaleType = Enum.ScaleType.Tile
		Box.TileSize = UDim2.fromOffset(8, 8)
		Box.ZIndex = 6
		Box.Visible = false
		Box.Parent = Btn
