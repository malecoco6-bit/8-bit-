-- =====================================================================
-- small helpers
-- =====================================================================
local function hex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function fillGradFor(accent)
	return ColorSequence.new(accent:Lerp(Color3.new(1, 1, 1), 0.25), accent:Lerp(Color3.new(0, 0, 0), 0.35))
end

local function addFaceGradient(parent)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = FACE_GRAD
	g.Parent = parent
	return g
end

local function bold(inst)
	pcall(function()
		inst.FontFace = Font.new(inst.FontFace.Family, Enum.FontWeight.Bold)
	end)
end

local function inside(obj, m)
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

local function fmtNum(n)
	if n == math.floor(n) then return tostring(n) end
	local s = string.format("%.2f", n)
	s = s:gsub("0+$", "")
	s = s:gsub("%.$", "")
	return s
end

local function loadIcon(src)
	if src == nil or src == "" then return nil end
	if type(src) == "number" or tostring(src):match("^%d+$") then
		return "rbxassetid://" .. tostring(src)
	end
	src = tostring(src)
	if src:match("^https?://") then
		if not (writefile and getcustomasset and isfile) then return nil end
		local file = "MenuLib_" .. src:gsub("[^%w]", ""):sub(-40) .. ".png"
		local ok, res = pcall(function()
			if not isfile(file) then writefile(file, game:HttpGet(src)) end
			return getcustomasset(file)
		end)
		return ok and res or nil
	end
	return src
end

local function makeHolder(api, height)
	local host = api and api.Row
	if not (host and host.Parent) then return nil end
	host.Visible = false
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, height)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.LayoutOrder = host.LayoutOrder
	holder.ZIndex = host.ZIndex
	holder.Parent = host.Parent
	return holder
end

local function makeRowLabel(parent, text)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 14)
	lbl.Position = UDim2.fromOffset(2, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = FONT
	lbl.TextSize = 11
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(205, 205, 205)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = parent
	return lbl
end

-- =====================================================================
-- construction
-- =====================================================================
function Library.new(opts)
	opts = opts or {}
	local genv = (getgenv and getgenv()) or _G
	if genv.__menuLibConns then
		for _, c in ipairs(genv.__menuLibConns) do pcall(function() c:Disconnect() end) end
	end
	genv.__menuLibConns = {}

	local self = setmetatable({}, Library)
	self.Options = opts
	self.Conns = genv.__menuLibConns
	self.Accent = opts.Accent or Color3.fromRGB(160, 200, 40)
	self.FillGrad = fillGradFor(self.Accent)
	self.MenuKey = opts.MenuKey or Enum.KeyCode.RightShift
	self.Tabs = {}
	self.Flags = {}
	self.Controls = {}      -- id -> { get, set } (used by configs)
	self.Handlers = {}      -- id -> function handed to ImGuiLib
	self.Widgets = {}
	self.ColorState = {}
	self.Built = false
	self.Visible = true
	self._uid = 0
	self._fillGrads = {}
	self._combos = {}
	self._checkFaces = {}
	self._popups = {}
	self._accentHooks = {}
	self._pickerClosers = {}
	self._refresh = {}
	return self
end

function Library:_track(conn)
	table.insert(self.Conns, conn)
	return conn
end

function Library:_cleanup(fn)
	table.insert(self.Conns, { Disconnect = function() pcall(fn) end })
end

function Library:_id(o)
	local id = o.Id
	if not id then
		self._uid += 1
		id = "ctl" .. self._uid
	end
	return id
end

function Library:AddTab(name, icon)
	local tab = setmetatable({ Name = name, Icon = icon, Window = self, Sections = {} }, Tab)
	table.insert(self.Tabs, tab)
	return tab
end

function Tab:AddSection(title, column, height)
	local win = self.Window
	win._uid += 1
	local sec = setmetatable({
		Title = title, Column = column or 1, Height = height,
		Window = win, Items = {}, Uid = win._uid,
	}, Section)
	table.insert(self.Sections, sec)
	return sec
end

-- ---- control objects returned to the user ----
local function newCtl(win, id, kind)
	local ctl = { Id = id, Kind = kind }
	function ctl:Get() return win.Flags[id] end
	function ctl:Set(v)
		local c = win.Controls[id]
		if c then c.set(v) else win.Flags[id] = v end
	end
	return ctl
end

local function registerColor(win, id, o)
	local cs = o.Color
	if not cs then return end
	win.ColorState[id] = {
		color = cs.Default or Color3.new(1, 1, 1),
		alpha = type(cs.Alpha) == "number" and cs.Alpha or 1,
		useAlpha = type(cs.Alpha) == "number",
		callback = cs.Callback,
	}
	win.Flags[id .. "_color"] = win.ColorState[id].color
	win.Flags[id .. "_alpha"] = win.ColorState[id].alpha
end

function Section:_add(kind, o, default)
	local win = self.Window
	local id = win:_id(o)
	local item = { Kind = kind, Id = id, Opts = o }
	if o.Color then item.ColorId = id .. "_color" end
	if o.Keybind then item.KeyId = id .. "_key" end
	table.insert(self.Items, item)
	win.Flags[id] = default
	registerColor(win, id, o)
	local ctl = newCtl(win, id, kind)
	if o.Color then
		function ctl:GetColor()
			local st = win.ColorState[id]
			return st.color, st.alpha
		end
		function ctl:SetColor(c, a)
			local f = win.Controls[id .. "_color"]
			if f then f.set({ c.R, c.G, c.B, a }) end
		end
	end
	return ctl, item
end

function Section:AddCheckbox(o)
	return (self:_add("Checkbox", o, o.Default == true))
end

function Section:AddSlider(o)
	return (self:_add("Slider", o, o.Default or o.Min or 0))
end

function Section:AddDropdown(o)
	local opts = o.Options or {}
	return (self:_add("Dropdown", o, o.Default or opts[1] or ""))
end

function Section:AddLabel(o)
	if type(o) == "string" then o = { Text = o } end
	return (self:_add("Label", o, nil))
end

function Section:AddMultiDropdown(o)
	local ctl = self:_add("Multi", o, {})
	local win = self.Window
	function ctl:Refresh()
		local f = win._refresh[ctl.Id]
		if f then f() end
	end
	return ctl
end

function Section:AddTextBox(o)
	return (self:_add("TextBox", o, o.Default or ""))
end

function Section:AddButton(o)
	return (self:_add("Button", o, nil))
end

-- =====================================================================
-- layout JSON
-- =====================================================================
local EST = { Checkbox = 20, Slider = 30, Dropdown = 38, Multi = 40, TextBox = 38, Button = 26, Label = 18 }

local function itemJson(it)
	local o, id, k = it.Opts, it.Id, it.Kind
	local out = {}
	if k == "Checkbox" then
		out[1] = { type = "Checkbox", args = { o.Text or id, o.Default == true }, on = id, id = id }
	elseif k == "Slider" then
		local mn = o.Min or 0
		out[1] = { type = "Slider", args = { o.Text or "", mn, o.Max or 100, o.Default or mn, o.Step or 1 }, on = id, id = id }
	elseif k == "Dropdown" then
		local opts = o.Options or {}
		out[1] = { type = "Dropdown", args = { o.Text or id, opts, o.Default or opts[1] or "" }, on = id, id = id }
	elseif k == "Label" then
		out[1] = { type = "Label", args = { o.Text or "" }, id = id }
	else
		out[1] = { type = "Label", args = { "" }, id = id } -- placeholder replaced after build
	end
	return out
end

function Library:_layout()
	local tabs = {}
	for _, tab in ipairs(self.Tabs) do
		local cols = { {}, {} }
		local twoCol = false
		for _, sec in ipairs(tab.Sections) do
			local items, h = {}, 14
			for _, it in ipairs(sec.Items) do
				for _, j in ipairs(itemJson(it)) do table.insert(items, j) end
				h += EST[it.Kind] or 20
			end
			local col = (sec.Column == 2) and 2 or 1
			if col == 2 then twoCol = true end
			table.insert(cols[col], { type = "Label", args = { sec.Title }, id = "t_" .. sec.Uid })
			table.insert(cols[col], { type = "Child", args = { sec.Title, sec.Height or h }, items = items })
		end
		local list
		if twoCol then
			list = { { type = "Row", widths = { 1, 1 }, columns = { cols[1], cols[2] } } }
		else
			list = cols[1]
		end
		table.insert(tabs, { name = tab.Name, items = list })
	end
	if self.Options.Config ~= false then
		table.insert(tabs, { name = "Config", items = { { type = "Label", args = { "Config" } } } })
	end

	local a = self.Accent
	local style = {
		Font = "Ubuntu", FontSize = 12, FrameHeight = 18, WindowPadding = 8, ItemSpacing = 4,
		Text = "#C4C4C4", TextDisabled = "#707070",
		WindowBg = { "#1A1A1A", 0 }, PopupBg = { "#2A2A2A", 0 }, Border = { "#333333", 0 },
		TitleBgActive = { "#1A1A1A", 0 }, TitleBgCollapsed = { "#1A1A1A", 0 },
		FrameBg = { "#2A2A2A", 0 }, FrameBgHovered = { "#333333", 0 }, FrameBgActive = { "#3A3A3A", 0 },
		Button = { "#333333", 0 }, ButtonHovered = { "#444444", 0 },
		Header = { "#232323", 0 }, HeaderHovered = { "#2E2E2E", 0 },
		HeaderSelected = { hex(a:Lerp(Color3.new(0, 0, 0), 0.7)), 0 },
		Tab = { "#161616", 0 }, TabHovered = { "#2A2A2A", 0 }, TabActive = { hex(a), 0 },
		CheckMark = hex(a), SliderGrab = hex(a), SliderGrabActive = hex(a:Lerp(Color3.new(1, 1, 1), 0.3)),
		ScrollbarGrab = "#444444", PlotHistogram = hex(a),
	}
	for k, v in pairs(self.Options.Style or {}) do style[k] = v end

	local size = self.Options.Size or Vector2.new(760, 600)
	local pos = self.Options.Position or Vector2.new(60, 60)
	return HttpService:JSONEncode({
		size = { size.X, size.Y }, position = { pos.X, pos.Y },
		style = style, tabs = tabs,
	})
end

