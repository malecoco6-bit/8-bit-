	-- AddDragSlider(name, min, max, default, [speed], callback): click and drag sideways to change the value
	function proxy:AddDragSlider(name, min, max, defaultVal, speed, callback)
		if type(speed) == "function" then
			callback = speed
			speed = nil
		end
		if type(speed) ~= "number" or speed <= 0 then
			speed = math.max((max - min) / 200, 0.001)
		end
		local sig = newSignal(callback)
		local value = math.clamp(defaultVal or min, min, max)

		local Row = newRow()
		local Track = create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		paint(Track, Style.FrameBg)
		local ValueText = label(Track, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = fmt(value),
		})
		local NameLabel = nameLabel(Row, name)

		local hovered, dragging, lastX = false, false, 0
		local function refreshColors()
			paint(Track, dragging and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end
		local function setValue(newValue)
			newValue = math.clamp(newValue, min, max)
			newValue = math.floor(newValue * 10000 + 0.5) / 10000
			if newValue ~= value then
				value = newValue
				ValueText.Text = fmt(value)
				sig:Fire(value)
			end
		end

		Track.MouseEnter:Connect(function() hovered = true refreshColors() end)
		Track.MouseLeave:Connect(function() hovered = false refreshColors() end)
		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				lastX = input.Position.X
				refreshColors()
			end
		end)
		window._connect(UserInputService.InputChanged, function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local dx = input.Position.X - lastX
				lastX = input.Position.X
				setValue(value + dx * speed)
			end
		end)
		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
				dragging = false
				refreshColors()
			end
		end)

		local api = {Type = "number", Changed = sig}
		function api:Get() return value end
		function api:Set(newValue)
			value = math.clamp(tonumber(newValue) or value, min, max)
			ValueText.Text = fmt(value)
		end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- AddRangeSlider(name, min, max, lowDefault, highDefault, [step], callback) -> callback(low, high)
	function proxy:AddRangeSlider(name, min, max, lowDefault, highDefault, step, callback)
		if type(step) == "function" then
			callback = step
			step = 1
		end
		if type(step) ~= "number" or step <= 0 then step = 1 end
		local sig = newSignal(callback)
		local frameH = Style.FrameHeight
		local range = math.max(max - min, 1)
		local low = math.clamp(lowDefault or min, min, max)
		local high = math.clamp(highDefault or max, min, max)
		if low > high then low, high = high, low end
		local GRAB_W = 10

		local Row = newRow()
		local Track = create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		paint(Track, Style.FrameBg)

		local Fill = create("Frame", {BorderSizePixel = 0, ZIndex = 2}, Track)
		paint(Fill, Style.HeaderSelected)
		local GrabLow = create("Frame", {BackgroundColor3 = Style.SliderGrab, BorderSizePixel = 0, ZIndex = 3}, Track)
		local GrabHigh = create("Frame", {BackgroundColor3 = Style.SliderGrab, BorderSizePixel = 0, ZIndex = 3}, Track)
		local ValueText = label(Track, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 4,
		})
		local NameLabel = nameLabel(Row, name)

		local function travel()
			return math.max(Track.AbsoluteSize.X - 4 - GRAB_W, 1)
		end
		local function posOf(value)
			return 2 + travel() * (value - min) / range
		end
		local function refresh()
			local a, b = posOf(low), posOf(high)
			GrabLow.Size = UDim2.fromOffset(GRAB_W, frameH - 4)
			GrabHigh.Size = UDim2.fromOffset(GRAB_W, frameH - 4)
			GrabLow.Position = UDim2.fromOffset(a, 2)
			GrabHigh.Position = UDim2.fromOffset(b, 2)
			Fill.Position = UDim2.fromOffset(a + GRAB_W / 2, 2)
			Fill.Size = UDim2.fromOffset(math.max(b - a, 0), frameH - 4)
			ValueText.Text = fmt(low) .. " - " .. fmt(high)
		end
		Track:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
		refresh()

		local function valueFromX(x)
			local alpha = math.clamp((x - Track.AbsolutePosition.X - 2 - GRAB_W / 2) / travel(), 0, 1)
			local raw = min + alpha * range
			return math.clamp(math.floor((raw - min) / step + 0.5) * step + min, min, max)
		end

		local hovered, active = false, nil
		local function refreshColors()
			paint(Track, active and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
			GrabLow.BackgroundColor3 = active == "low" and Style.SliderGrabActive or Style.SliderGrab
			GrabHigh.BackgroundColor3 = active == "high" and Style.SliderGrabActive or Style.SliderGrab
		end
		table.insert(Restylers, refreshColors)

		local function drag(x)
			local newValue = valueFromX(x)
			local changed = false
			if active == "low" then
				newValue = math.min(newValue, high)
				if newValue ~= low then low = newValue changed = true end
			elseif active == "high" then
				newValue = math.max(newValue, low)
				if newValue ~= high then high = newValue changed = true end
			end
			if changed then
				refresh()
				sig:Fire(low, high)
			end
		end

		Track.MouseEnter:Connect(function() hovered = true refreshColors() end)
		Track.MouseLeave:Connect(function() hovered = false refreshColors() end)
		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local x = input.Position.X
				local centerLow = Track.AbsolutePosition.X + posOf(low) + GRAB_W / 2
				local centerHigh = Track.AbsolutePosition.X + posOf(high) + GRAB_W / 2
				if low == high then
					active = x >= centerLow and "high" or "low"
				else
					active = math.abs(x - centerLow) <= math.abs(x - centerHigh) and "low" or "high"
				end
				refreshColors()
				drag(x)
			end
		end)
		window._connect(UserInputService.InputChanged, function(input)
			if active and input.UserInputType == Enum.UserInputType.MouseMovement then
				drag(input.Position.X)
			end
		end)
		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and active then
				active = nil
				refreshColors()
			end
		end)

		local api = {Type = "range", Changed = sig}
		function api:Get() return low, high end
		function api:Set(newLow, newHigh)
			low = math.clamp(tonumber(newLow) or low, min, max)
			high = math.clamp(tonumber(newHigh) or high, min, max)
			if low > high then low, high = high, low end
			refresh()
		end
		api.Save = function() return {low = low, high = high} end
		api.Load = function(data)
			if type(data) == "table" then api:Set(data.low, data.high) end
		end
		api.Refire = function() sig:Fire(low, high) end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

