	-- ===== Sliders / numbers =====
	function proxy:AddSlider(name, min, max, defaultVal, step, callback)
		-- Allow calling without a step: AddSlider(name, min, max, default, callback)
		if type(step) == "function" then
			callback = step
			step = 1
		end
		if type(step) ~= "number" or step <= 0 then
			step = 1
		end
		local sig = newSignal(callback)
		local value = math.clamp(defaultVal or min, min, max)
		local frameH = Style.FrameHeight
		local range = math.max(max - min, 1)

		local Row = newRow()

		local Track = create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		paint(Track, Style.FrameBg)

		local Grab = create("Frame", {
			BackgroundColor3 = Style.SliderGrab,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, Track)

		local ValueText = label(Track, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = tostring(value),
			ZIndex = 3,
		})

		local NameLabel = nameLabel(Row, name)

		local function metrics()
			local usable = math.max(Track.AbsoluteSize.X - 4, 1)
			local grabWidth = math.max(usable / (max - min + 1), 12)
			return usable, grabWidth
		end

		local function refresh()
			local usable, grabWidth = metrics()
			local alpha = (value - min) / range
			Grab.Size = UDim2.fromOffset(grabWidth, frameH - 4)
			Grab.Position = UDim2.fromOffset(2 + (usable - grabWidth) * alpha, 2)
			ValueText.Text = tostring(value)
		end
		Track:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
		refresh()

		local hovered, dragging = false, false
		local function refreshColors()
			paint(Track, dragging and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
			Grab.BackgroundColor3 = dragging and Style.SliderGrabActive or Style.SliderGrab
		end
		table.insert(Restylers, refreshColors)

		local function setFromMouse(mouseX)
			local usable, grabWidth = metrics()
			local travel = usable - grabWidth
			if travel <= 0 then return end
			local alpha = math.clamp((mouseX - Track.AbsolutePosition.X - 2 - grabWidth / 2) / travel, 0, 1)
			local raw = min + alpha * range
			local newValue = math.clamp(math.floor((raw - min) / step + 0.5) * step + min, min, max)
			if newValue ~= value then
				value = newValue
				refresh()
				sig:Fire(value)
			end
		end

		Track.MouseEnter:Connect(function() hovered = true refreshColors() end)
		Track.MouseLeave:Connect(function() hovered = false refreshColors() end)

		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				refreshColors()
				setFromMouse(input.Position.X)
			end
		end)

		window._connect(UserInputService.InputChanged, function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				setFromMouse(input.Position.X)
			end
		end)

		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
				dragging = false
				refreshColors()
			end
		end)

		local api = {Type = "number", Changed = sig}
		function api:Get() return value end
		function api:Set(newValue)
			value = math.clamp(tonumber(newValue) or value, min, max)
			refresh()
		end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

