-- // Tooltip
local function attachTooltip(window, target, text)
	if not target then return end
	if window.Tips[target] == nil then
		target.MouseEnter:Connect(function()
			window.TipHover = target
			task.delay(0.4, function()
				if window.TipHover == target and window.Tips[target] and window.Tips[target] ~= "" then
					window:_showTip(window.Tips[target])
				end
			end)
		end)
		target.MouseLeave:Connect(function()
			if window.TipHover == target then
				window.TipHover = nil
				window:_hideTip()
			end
		end)
	end
	window.Tips[target] = text
end

-- // Shared widget decoration: Get/Set come from the widget, everything else is added here
local function decorate(window, Row, api, options)
	options = options or {}
	api.Row = Row
	api.Instance = Row

	function api:SetVisible(state)
		Row.Visible = state and true or false
		return self
	end

	local blocker
	function api:SetEnabled(state)
		state = state and true or false
		self.Enabled = state
		if not state then
			if not blocker then
				blocker = create("TextButton", {
					Name = "__blocker",
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 20,
				}, Row)
			end
			blocker.Visible = true
		elseif blocker then
			blocker.Visible = false
		end
		dimTree(Row, not state)
		return self
	end

	function api:SetName(text)
		if options.nameLabel then options.nameLabel.Text = tostring(text) end
		return self
	end

	function api:SetTooltip(text)
		attachTooltip(window, Row, text)
		return self
	end

	function api:SetFlag(flag)
		if self.FlagName then window.Flags[self.FlagName] = nil end
		self.FlagName = flag
		window.Flags[flag] = self
		return self
	end

	function api:OnChanged(fn)
		if self.Changed then return self.Changed:Connect(fn) end
	end

	function api:Destroy()
		if self.FlagName then window.Flags[self.FlagName] = nil end
		Row:Destroy()
	end

	if not api.Save then
		api.Save = function()
			if api.Get then return encode(api:Get()) end
		end
	end
	if not api.Load then
		api.Load = function(value)
			if api.Set then api:Set(decode(value)) end
		end
	end
	if not api.Refire then
		api.Refire = function()
			if api.Changed and api.Get then api.Changed:Fire(api:Get()) end
		end
	end
	return api
end

-- // Floating window (used by the color picker): draggable title bar, collapse arrow, resize grip
local function makeFloat(window, title, size, minSize, onResize)
	local f = {Size = size, Collapsed = false}
	local titleH = Style.FrameHeight

	f.Frame = create("Frame", {
		Size = UDim2.fromOffset(size.X, size.Y),
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 100,
	}, window.ScreenGui)
	paint(f.Frame, Style.PopupBg)
	border(f.Frame)

	f.TitleBar = create("Frame", {
		Size = UDim2.new(1, 0, 0, titleH),
		BorderSizePixel = 0,
		ZIndex = 101,
	}, f.Frame)
	paint(f.TitleBar, Style.TitleBgActive)

	local Collapse = themeText(create("TextButton", {
		Size = UDim2.fromOffset(titleH, titleH),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "▼",
		TextColor3 = Style.Text,
		TextSize = 10,
		Font = Style.Font,
		ZIndex = 102,
	}, f.TitleBar))

	f.TitleLabel = label(f.TitleBar, {
		Position = UDim2.fromOffset(titleH, 0),
		Size = UDim2.new(1, -titleH, 1, 0),
		Text = title,
		ZIndex = 102,
	})

	f.Body = create("Frame", {
		Position = UDim2.fromOffset(0, titleH),
		Size = UDim2.new(1, 0, 1, -titleH),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 101,
	}, f.Frame)

	local Grip = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -1, 1, -1),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "◢",
		TextSize = 16,
		Font = Style.Font,
		TextColor3 = Style.ResizeGrip[1],
		TextTransparency = Style.ResizeGrip[2],
		ZIndex = 150,
	}, f.Body)

	function f:SetCollapsed(value)
		self.Collapsed = value
		Collapse.Text = value and "▶" or "▼"
		paint(self.TitleBar, value and Style.TitleBgCollapsed or Style.TitleBgActive)
		self.Body.Visible = not value
		self.Frame.BackgroundTransparency = value and 1 or Style.PopupBg[2]
		self.Frame.Size = value
			and UDim2.fromOffset(self.Size.X, titleH)
			or UDim2.fromOffset(self.Size.X, self.Size.Y)
	end
	Collapse.MouseButton1Click:Connect(function() f:SetCollapsed(not f.Collapsed) end)

	local dragging, dragStart, startPos = false, nil, nil
	f.TitleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = f.Frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)

	local resizing, resizeStart, sizeStart = false, nil, nil
	Grip.MouseEnter:Connect(function()
		if not resizing then Grip.TextTransparency = Style.ResizeGripHovered[2] end
	end)
	Grip.MouseLeave:Connect(function()
		if not resizing then Grip.TextTransparency = Style.ResizeGrip[2] end
	end)
	Grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = Vector2.new(input.Position.X, input.Position.Y)
			sizeStart = f.Size
			Grip.TextTransparency = Style.ResizeGripActive[2]
		end
	end)

	window._connect(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		if dragging then
			local delta = input.Position - dragStart
			f.Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		elseif resizing then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStart
			f.Size = Vector2.new(
				math.max(minSize.X, sizeStart.X + delta.X),
				math.max(minSize.Y, sizeStart.Y + delta.Y)
			)
			f.Frame.Size = UDim2.fromOffset(f.Size.X, f.Size.Y)
			if onResize then onResize(f.Size) end
		end
	end)
	window._connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			if resizing then
				resizing = false
				Grip.TextTransparency = Style.ResizeGrip[2]
			end
		end
	end)

	return f
end

-- // Widgets. `Content` is any container with a vertical UIListLayout (tab, header body, row column).
local function buildProxy(window, Content)
	local proxy = {Content = Content}
	local SPLIT = 0.65

	local function newRow(height)
		return create("Frame", {
			Size = UDim2.new(1, 0, 0, height or Style.FrameHeight),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, Content)
	end

	local function nameLabel(Row, name)
		return label(Row, {
			Position = UDim2.new(SPLIT, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(1 - SPLIT, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})
	end

	local function newBox(parent, order)
		local box = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = order or 0,
		}, parent)
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Style.ItemSpacing),
		}, box)
		return box
	end

	-- ===== Text =====
	function proxy:AddLabel(text)
		local Label = label(Content, {
			Size = UDim2.new(1, 0, 0, Style.FrameHeight),
			Text = text,
		})
		local api = {Type = "label"}
		function api:Get() return Label.Text end
		function api:Set(value) Label.Text = tostring(value) end
		return Label, decorate(window, Label, api, {nameLabel = Label})
	end

	function proxy:AddLabelColored(text, color)
		local Label, api = self:AddLabel(text)
		ThemedText[Label] = nil
		Label.TextColor3 = color or Style.Text
		function api:SetColor(newColor) Label.TextColor3 = newColor end
		return Label, api
	end

	function proxy:AddBulletText(text)
		local Label = label(Content, {
			Size = UDim2.new(1, 0, 0, Style.FrameHeight),
			Text = "• " .. tostring(text),
		})
		local api = {Type = "label"}
		function api:Get() return Label.Text end
		function api:Set(value) Label.Text = "• " .. tostring(value) end
		return Label, decorate(window, Label, api, {nameLabel = Label})
	end

	function proxy:AddTextWrapped(text)
		local Label = label(Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = text,
		})
		local api = {Type = "label"}
		function api:Get() return Label.Text end
		function api:Set(value) Label.Text = tostring(value) end
		return Label, decorate(window, Label, api, {nameLabel = Label})
	end

	function proxy:AddSeparator(text)
		if not text or text == "" then
			local Row = create("Frame", {
				Size = UDim2.new(1, 0, 0, 8),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, Content)
			local Line = create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.new(1, 0, 0, 1),
				BorderSizePixel = 0,
			}, Row)
			paint(Line, Style.Border)
			return Row
		end

