		function api:Get() return fraction end
		function api:Set(newFraction, newOverlay)
			fraction = math.clamp(tonumber(newFraction) or fraction, 0, 1)
			Fill.Size = UDim2.new(fraction, 0, 1, 0)
			Overlay.Text = newOverlay or string.format("%d%%", math.floor(fraction * 100 + 0.5))
		end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- ===== Dropdowns =====
	-- Shared builder (single + multi select). Lists longer than 8 get a scroll area and a search box.
	local function buildDropdown(name, options, default, callback, multi)
		local frameH = Style.FrameHeight
		local itemH = 18
		local popupPad = 4
		local MAX_VISIBLE = 8
		local sig = newSignal(callback)

		local opts = {}
		for index, option in ipairs(options) do opts[index] = option end

		local selected          -- single mode
		local set = {}          -- multi mode: set[option] = true
		if multi then
			if type(default) == "table" then
				for _, option in ipairs(default) do set[option] = true end
			end
		else
			selected = default ~= nil and default or opts[1]
		end

		local function isSelected(option)
			if multi then return set[option] == true end
			return option == selected
		end

		local function selectedList()
			local list = {}
			for _, option in ipairs(opts) do
				if set[option] then table.insert(list, option) end
			end
			return list
		end

		local function displayText()
			if not multi then return tostring(selected) end
			local names = {}
			for _, option in ipairs(selectedList()) do
				table.insert(names, tostring(option))
			end
			return #names > 0 and table.concat(names, ", ") or "None"
		end

		local Row = newRow()

		local Combo = create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ClipsDescendants = true,
		}, Row)
		paint(Combo, Style.FrameBg)

		local SelectedText = label(Combo, {
			Position = UDim2.fromOffset(Style.FramePaddingX, 0),
			Size = UDim2.new(1, -(frameH + Style.FramePaddingX), 1, 0),
			Text = displayText(),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})

		local ArrowButton = create("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(frameH, frameH),
			BorderSizePixel = 0,
		}, Combo)
		paint(ArrowButton, Style.Button)

		label(ArrowButton, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextSize = 9,
			Text = "▼",
		})

		local NameLabel = nameLabel(Row, name)

		local Popup = create("Frame", {
			Size = UDim2.fromOffset(100, 40),
			BorderSizePixel = 0,
			Visible = false,
			Active = true,
			ZIndex = 100,
		}, window.MainFrame)
		paint(Popup, Style.PopupBg)
		border(Popup)

		local SearchBox = themeText(create("TextBox", {
			Position = UDim2.fromOffset(popupPad, popupPad),
			Size = UDim2.new(1, -popupPad * 2, 0, itemH),
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			PlaceholderText = "Search...",
			PlaceholderColor3 = Style.TextDisabled,
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
			Visible = false,
			ZIndex = 101,
		}, Popup))
		paint(SearchBox, Style.FrameBg)
		create("UIPadding", {PaddingLeft = UDim.new(0, Style.FramePaddingX)}, SearchBox)

		local List = create("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = Style.ScrollbarGrab,
			ZIndex = 101,
		}, Popup)
		create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, List)

		local items = {}
		local popupHovered = false
		Popup.MouseEnter:Connect(function() popupHovered = true end)
		Popup.MouseLeave:Connect(function() popupHovered = false end)

		local function refreshItems()
			for _, item in ipairs(items) do
				item.Label.Text = tostring(item.Option)
				if item.Hovered then
					paint(item.Button, Style.HeaderHovered)
				elseif isSelected(item.Option) then
					paint(item.Button, Style.HeaderSelected)
				else
					item.Button.BackgroundTransparency = 1
				end
			end
		end

		local function resizePopup()
			local count = 0
			for _, item in ipairs(items) do
				if item.Button.Visible then count = count + 1 end
			end
			local hasSearch = #opts > MAX_VISIBLE
			SearchBox.Visible = hasSearch
			local top = popupPad + (hasSearch and (itemH + 2) or 0)
			local shown = math.clamp(count, 1, MAX_VISIBLE)
			List.Position = UDim2.fromOffset(0, top)
			List.Size = UDim2.new(1, 0, 0, shown * itemH)
			List.ScrollingEnabled = count > MAX_VISIBLE
			Popup.Size = UDim2.fromOffset(math.max(Combo.AbsoluteSize.X, 60), top + shown * itemH + popupPad)
		end

		local function applyFilter()
			local query = SearchBox.Text:lower()
			for _, item in ipairs(items) do
				item.Button.Visible = query == "" or tostring(item.Option):lower():find(query, 1, true) ~= nil
			end
			resizePopup()
		end
		SearchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

		local open = false
		local comboHovered = false
		local function refreshCombo()
			paint(Combo, (comboHovered or open) and Style.FrameBgHovered or Style.FrameBg)
			paint(ArrowButton, comboHovered and Style.ButtonHovered or Style.Button)
		end

		local setOpen

		local function rebuildItems()
			for _, item in ipairs(items) do item.Button:Destroy() end
			items = {}
			for index, option in ipairs(opts) do
				local item = {Option = option, Hovered = false}

				item.Button = create("TextButton", {
					Size = UDim2.new(1, 0, 0, itemH),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					LayoutOrder = index,
					ZIndex = 102,
				}, List)

				item.Label = label(item.Button, {
					Position = UDim2.fromOffset(Style.FramePaddingX + 4, 0),
					Size = UDim2.new(1, -(Style.FramePaddingX + 8), 1, 0),
					Text = tostring(option),
					ZIndex = 103,
				})

				item.Button.MouseEnter:Connect(function() item.Hovered = true refreshItems() end)
				item.Button.MouseLeave:Connect(function() item.Hovered = false refreshItems() end)
				item.Button.MouseButton1Click:Connect(function()
					if multi then
						-- stay open, toggle membership
						set[option] = (not set[option]) or nil
						SelectedText.Text = displayText()
						refreshItems()
						sig:Fire(selectedList())
					else
						selected = option
						SelectedText.Text = displayText()
						setOpen(false)
						sig:Fire(option)
					end
				end)

				table.insert(items, item)
			end
			refreshItems()
			applyFilter()
		end

		setOpen = function(state)
			open = state
			if open then
				SearchBox.Text = ""
				applyFilter()
				local main = window.MainFrame
				Popup.Position = UDim2.fromOffset(
					Combo.AbsolutePosition.X - main.AbsolutePosition.X,
					Combo.AbsolutePosition.Y + Combo.AbsoluteSize.Y - main.AbsolutePosition.Y
				)
				refreshItems()
			end
			Popup.Visible = open
			if not open then
				-- hover flags can get stuck when the popup hides under the cursor
				popupHovered = false
				for _, item in ipairs(items) do item.Hovered = false end
			end
			refreshCombo()
		end

		rebuildItems()

		Combo.MouseEnter:Connect(function() comboHovered = true refreshCombo() end)
		Combo.MouseLeave:Connect(function() comboHovered = false refreshCombo() end)
		Combo.MouseButton1Click:Connect(function() setOpen(not open) end)

		window._connect(UserInputService.InputBegan, function(input)
			if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
				-- hover-based hit test: no coordinate math, so it works in any executor
				local overItem = false
				for _, item in ipairs(items) do
					if item.Hovered then overItem = true break end
				end
				if not popupHovered and not comboHovered and not overItem then
					setOpen(false)
				end
			end
		end)

		table.insert(window.ClosePopups, function()
			if open then setOpen(false) end
		end)

		local api = {Type = multi and "table" or "string", Changed = sig}
		function api:Get()
			if multi then return selectedList() end
			return selected
		end
		function api:Set(value)
			if multi then
				set = {}
				if type(value) == "table" then
					for _, option in ipairs(value) do set[option] = true end
				end
			else
				selected = value
			end
			SelectedText.Text = displayText()
			refreshItems()
		end
		-- api:SetOptions({...}) replaces the list (keeps the selection when it still exists)
		function api:SetOptions(newOptions)
			opts = {}
			for index, option in ipairs(newOptions) do opts[index] = option end
			if multi then
				for option in pairs(set) do
					if not table.find(opts, option) then set[option] = nil end
				end
			elseif not table.find(opts, selected) then
				selected = opts[1]
			end
			rebuildItems()
			SelectedText.Text = displayText()
		end

		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- AddDropdown(name, options, [default], callback)           -> callback(option)
	function proxy:AddDropdown(name, options, defaultOption, callback)
		-- Allow AddDropdown(name, options, callback)
		if type(defaultOption) == "function" then
			callback = defaultOption
			defaultOption = nil
		end
		return buildDropdown(name, options, defaultOption, callback, false)
	end

	-- AddMultiDropdown(name, options, [defaultsList], callback) -> callback({selected options})
	function proxy:AddMultiDropdown(name, options, defaults, callback)
		if type(defaults) == "function" then
			callback = defaults
			defaults = nil
		end
		return buildDropdown(name, options, defaults, callback, true)
	end

	-- AddListBox(name, options, [visibleRows], callback) -> callback(option)
	function proxy:AddListBox(name, options, height, callback)
		if type(height) == "function" then
			callback = height
			height = nil
		end
		height = height or 6
		local itemH = 18
		local sig = newSignal(callback)
		local opts = {}
		for index, option in ipairs(options) do opts[index] = option end
		local selected = opts[1]

		local Row = newRow(height * itemH + 4)
		local Box = create("ScrollingFrame", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = Style.ScrollbarGrab,
		}, Row)
		paint(Box, Style.FrameBg)
		create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, Box)
		create("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2)}, Box)

		local NameLabel = label(Row, {
			Position = UDim2.new(SPLIT, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(1 - SPLIT, -Style.ItemInnerSpacing, 0, Style.FrameHeight),
			Text = name,
		})

		local items = {}
		local function refreshItems()
			for _, item in ipairs(items) do
				if item.Hovered then
					paint(item.Button, Style.HeaderHovered)
				elseif item.Option == selected then
					paint(item.Button, Style.HeaderSelected)
				else
					item.Button.BackgroundTransparency = 1
				end
			end
		end
		local function rebuild()
			for _, item in ipairs(items) do item.Button:Destroy() end
			items = {}
			for index, option in ipairs(opts) do
				local item = {Option = option, Hovered = false}
				item.Button = create("TextButton", {
					Size = UDim2.new(1, 0, 0, itemH),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					LayoutOrder = index,
				}, Box)
				label(item.Button, {
					Position = UDim2.fromOffset(Style.FramePaddingX, 0),
					Size = UDim2.new(1, -Style.FramePaddingX, 1, 0),
					Text = tostring(option),
				})
				item.Button.MouseEnter:Connect(function() item.Hovered = true refreshItems() end)
				item.Button.MouseLeave:Connect(function() item.Hovered = false refreshItems() end)
				item.Button.MouseButton1Click:Connect(function()
					selected = option
					refreshItems()
					sig:Fire(option)
				end)
				table.insert(items, item)
			end
			refreshItems()
		end
		rebuild()

		local api = {Type = "string", Changed = sig}
		function api:Get() return selected end
		function api:Set(value)
			selected = value
			refreshItems()
		end
		function api:SetOptions(newOptions)
			opts = {}
			for index, option in ipairs(newOptions) do opts[index] = option end
			if not table.find(opts, selected) then selected = opts[1] end
			rebuild()
		end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- ===== Color picker =====
	-- AddColorPicker(name, [defaultColor3], callback, [{Alpha = true | 0..1}]) -> callback(Color3 [, alpha])
	-- The swatch opens a floating ImGui-style window: drag the title bar to move it, drag the corner to resize it.
	-- Returns Row, api (api:Get() / api:GetAlpha() / api:Set(Color3, alpha))
	function proxy:AddColorPicker(name, defaultColor, callback, options)
		if type(defaultColor) == "function" then
			local fn = defaultColor
			options = callback
			callback = fn
			defaultColor = nil
		end
		options = type(options) == "table" and options or {}
		local withAlpha = options.Alpha ~= nil and options.Alpha ~= false
		local alpha = type(options.Alpha) == "number" and math.clamp(options.Alpha, 0, 1) or 1

		local sig = newSignal(callback)
		local color = typeof(defaultColor) == "Color3" and defaultColor or Color3.fromRGB(66, 150, 250)
		local h, s, v = color:ToHSV()
		local frameH = Style.FrameHeight

		local PAD, BAR_W, GAP, ROW_GAP, ALPHA_H = 8, 20, 4, 4, 14
		local SV0, MIN_SV = 146, 50
		local alphaExtra = withAlpha and (ALPHA_H + GAP) or 0
		local rowsH = frameH * 3 + ROW_GAP * 2
		local defaultSize = Vector2.new(PAD * 2 + SV0 + GAP + BAR_W, frameH + PAD + SV0 + GAP + alphaExtra + rowsH + PAD)
		local minSize = Vector2.new(170, frameH + PAD + MIN_SV + GAP + alphaExtra + rowsH + PAD)

		local Row = newRow()

		local Swatch = create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		local SwatchStroke = border(Swatch)

		local NameLabel = nameLabel(Row, name)

		local layout -- forward declaration
		local refresh -- forward declaration
		local float = makeFloat(window, name, defaultSize, minSize, function() layout() end)
		local Body = float.Body

		-- Saturation / Value square (not clipped so the cursor can hang over the edges)
		local SVBox = create("TextButton", {
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ClipsDescendants = false,
			ZIndex = 101,
		}, Body)

		local WhiteLayer = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 102,
		}, SVBox)
		create("UIGradient", {Transparency = NumberSequence.new(0, 1)}, WhiteLayer)

		local BlackLayer = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 103,
		}, SVBox)
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new(1, 0),
		}, BlackLayer)

		-- Cursor: white ring with a thin black outer ring (like Dear ImGui)
		local Cursor = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, SVBox)
		create("UICorner", {CornerRadius = UDim.new(1, 0)}, Cursor)
		create("UIStroke", {
			Color = Color3.new(1, 1, 1),
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, Cursor)

		local CursorOuter = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, Cursor)
		create("UICorner", {CornerRadius = UDim.new(1, 0)}, CursorOuter)
		create("UIStroke", {
			Color = Color3.new(0, 0, 0),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, CursorOuter)

		-- Hue bar with arrow markers on both sides (like Dear ImGui)
		local HueBar = create("TextButton", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 101,
		}, Body)
		create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
			}),
		}, HueBar)

		local ArrowL = label(HueBar, {
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(8, 12),
			TextSize = 8,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "▶",
			ZIndex = 102,
		})
		local ArrowR = label(HueBar, {
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.fromOffset(8, 12),
			TextSize = 8,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "◀",
			ZIndex = 102,
		})

		-- Alpha bar (only with {Alpha = ...})
		local AlphaBar, AlphaFill, AlphaMark
		if withAlpha then
			AlphaBar = create("TextButton", {
				BackgroundColor3 = Color3.fromRGB(90, 90, 90),
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 101,
			}, Body)
			AlphaFill = create("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = 102,
			}, AlphaBar)
			create("UIGradient", {Transparency = NumberSequence.new(1, 0)}, AlphaFill)
			AlphaMark = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Size = UDim2.new(0, 4, 1, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 103,
			}, AlphaBar)
			create("UIStroke", {
				Color = Color3.new(0, 0, 0),
				Thickness = 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, AlphaMark)
		end

		-- R/G/B/(A)/H/S/V numeric fields (0-255, same as Dear ImGui)
		local function makeField(letter, commit)
			local Field = create("Frame", {
				BorderSizePixel = 0,
				ZIndex = 101,
			}, Body)
			paint(Field, Style.FrameBg)

			label(Field, {
				Position = UDim2.fromOffset(Style.FramePaddingX + 2, 0),
				Size = UDim2.fromOffset(16, frameH),
				Text = letter .. ":",
				ZIndex = 102,
			})

			local Box = themeText(create("TextBox", {
				Position = UDim2.fromOffset(Style.FramePaddingX + 18, 0),
				Size = UDim2.new(1, -(Style.FramePaddingX * 2 + 18), 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Style.Font,
				TextSize = Style.FontSize,
				TextColor3 = Style.Text,
				TextXAlignment = Enum.TextXAlignment.Center,
				ClearTextOnFocus = false,
				Text = "0",
				ZIndex = 102,
			}, Field))

			local hovered, focused = false, false
			local function repaint()
				paint(Field, focused and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
			end
			Field.MouseEnter:Connect(function() hovered = true repaint() end)
			Field.MouseLeave:Connect(function() hovered = false repaint() end)
			Box.Focused:Connect(function() focused = true repaint() end)
			Box.FocusLost:Connect(function()
				focused = false
				repaint()
				local n = tonumber(Box.Text)
				if n then
					commit(math.clamp(math.floor(n + 0.5), 0, 255))
				else
					refresh(false)
				end
			end)
			return Box, Field
		end

		local function currentRGB()
			return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
		end

		-- keep the old hue when the new color is grey/black (hue is undefined there)
		local function setFromColor(c)
			local nh, ns, nv = c:ToHSV()
			if ns > 0 and nv > 0 then h = nh end
			s, v = ns, nv
			refresh(true)
		end

		local RBox, RField = makeField("R", function(n)
			local _, g, b = currentRGB()
			setFromColor(Color3.fromRGB(n, g, b))
		end)
		local GBox, GField = makeField("G", function(n)
			local r, _, b = currentRGB()
			setFromColor(Color3.fromRGB(r, n, b))
		end)
		local BBox, BField = makeField("B", function(n)
			local r, g = currentRGB()
			setFromColor(Color3.fromRGB(r, g, n))
		end)
		local ABox, AField
		if withAlpha then
			ABox, AField = makeField("A", function(n)
				alpha = n / 255
				refresh(true)
			end)
		end
		local HBox, HField = makeField("H", function(n)
			h = n / 255
			refresh(true)
		end)
		local SBox, SField = makeField("S", function(n)
			s = n / 255
			refresh(true)
		end)
		local VBox, VField = makeField("V", function(n)
			v = n / 255
			refresh(true)
		end)

		-- Hex input (#RRGGBB, or #RRGGBBAA with alpha)
		local Hex = themeText(create("TextBox", {
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Text = toHex(color, withAlpha and alpha or nil),
			ZIndex = 101,
		}, Body))
		paint(Hex, Style.FrameBg)
		create("UIPadding", {PaddingLeft = UDim.new(0, Style.FramePaddingX + 2)}, Hex)

		local rgbFields = {RField, GField, BField}
		if AField then table.insert(rgbFields, AField) end
		local hsvFields = {HField, SField, VField}

		-- Positions/sizes follow the window size so the picker scales when you resize it
		layout = function()
			local W, H = float.Size.X, float.Size.Y
			local innerW = W - PAD * 2
			local svW = innerW - GAP - BAR_W
			local svH = math.max(MIN_SV, H - frameH - PAD - GAP - alphaExtra - rowsH - PAD)

			SVBox.Position = UDim2.fromOffset(PAD, PAD)
			SVBox.Size = UDim2.fromOffset(svW, svH)
			HueBar.Position = UDim2.fromOffset(PAD + svW + GAP, PAD)
			HueBar.Size = UDim2.fromOffset(BAR_W, svH)

			local y = PAD + svH + GAP
			if withAlpha then
				AlphaBar.Position = UDim2.fromOffset(PAD, y)
				AlphaBar.Size = UDim2.fromOffset(innerW, ALPHA_H)
				y = y + ALPHA_H + GAP
			end

			local function place(list, rowY)
				local n = #list
				local w = math.floor((innerW - ROW_GAP * (n - 1)) / n)
				for index, field in ipairs(list) do
					local fieldW = (index == n) and (innerW - (w + ROW_GAP) * (n - 1)) or w
					field.Position = UDim2.fromOffset(PAD + (index - 1) * (w + ROW_GAP), rowY)
					field.Size = UDim2.fromOffset(fieldW, frameH)
				end
			end
			place(rgbFields, y)
			place(hsvFields, y + frameH + ROW_GAP)

			Hex.Position = UDim2.fromOffset(PAD, y + (frameH + ROW_GAP) * 2)
			Hex.Size = UDim2.fromOffset(innerW, frameH)
		end

		refresh = function(fire)
			color = Color3.fromHSV(h, s, v)
			Swatch.BackgroundColor3 = color
			Swatch.BackgroundTransparency = withAlpha and (1 - alpha) or 0
			SVBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			Cursor.Position = UDim2.fromScale(s, 1 - v)
			ArrowL.Position = UDim2.new(0, 3, h, 0)
			ArrowR.Position = UDim2.new(1, -3, h, 0)
			if withAlpha then
				AlphaFill.BackgroundColor3 = color
				AlphaMark.Position = UDim2.new(alpha, 0, 0, 0)
			end

			local r, g, b = currentRGB()
			local values = {
				{RBox, r}, {GBox, g}, {BBox, b},
				{HBox, math.floor(h * 255 + 0.5)},
				{SBox, math.floor(s * 255 + 0.5)},
				{VBox, math.floor(v * 255 + 0.5)},
			}
			if withAlpha then
				table.insert(values, {ABox, math.floor(alpha * 255 + 0.5)})
			end
			for _, pair in ipairs(values) do
				if not pair[1]:IsFocused() then pair[1].Text = tostring(pair[2]) end
			end
			if not Hex:IsFocused() then
				Hex.Text = toHex(color, withAlpha and alpha or nil)
			end
			if fire then
				if withAlpha then sig:Fire(color, alpha) else sig:Fire(color) end
			end
		end
		layout()
		refresh(false)

		Hex.Focused:Connect(function() paint(Hex, Style.FrameBgActive) end)
		Hex.FocusLost:Connect(function()
			paint(Hex, Style.FrameBg)
			local parsed, parsedAlpha = fromHex(Hex.Text)
			if parsed then
				if withAlpha and parsedAlpha then alpha = parsedAlpha end
				setFromColor(parsed)
			end
			Hex.Text = toHex(color, withAlpha and alpha or nil)
		end)

		-- Dragging
		local dragMode = nil
		local function updateFromMouse(m)
			if dragMode == "sv" then
				s = math.clamp((m.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
				v = 1 - math.clamp((m.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
			elseif dragMode == "hue" then
				h = math.clamp((m.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
			elseif dragMode == "alpha" then
				alpha = math.clamp((m.X - AlphaBar.AbsolutePosition.X) / AlphaBar.AbsoluteSize.X, 0, 1)
			else
				return
			end
			refresh(true)
		end

		SVBox.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = "sv"
				updateFromMouse(inputPoint(input))
			end
		end)
		HueBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = "hue"
				updateFromMouse(inputPoint(input))
			end
		end)
		if withAlpha then
			AlphaBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragMode = "alpha"
					updateFromMouse(inputPoint(input))
				end
			end)
		end

		window._connect(UserInputService.InputChanged, function(input)
			if dragMode and input.UserInputType == Enum.UserInputType.MouseMovement then
				updateFromMouse(inputPoint(input))
			end
		end)
		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = nil
			end
		end)

		-- Open / close (click the swatch again to close)
		local open = false
		local firstOpen = true
		local function setOpen(state)
			open = state
			if open then
				if firstOpen then
					firstOpen = false
					local main = window.MainFrame
					local screenW = window.ScreenGui.AbsoluteSize.X
					local x = main.AbsolutePosition.X + main.AbsoluteSize.X + 8
					if x + float.Size.X > screenW then
						x = main.AbsolutePosition.X - float.Size.X - 8
					end
					float.Frame.Position = UDim2.fromOffset(math.max(0, x), math.max(0, main.AbsolutePosition.Y))
				end
			else
				dragMode = nil
			end
			float.Frame.Visible = open
			SwatchStroke.Transparency = open and 0 or Style.Border[2]
		end

		-- Pressing the swatch (a 20px-tall element) tells us how mouse Y maps to GUI Y
		Swatch.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				calibrate(input, Swatch)
			end
		end)
		Swatch.MouseButton1Click:Connect(function() setOpen(not open) end)

		table.insert(window.CloseFloating, function()
			if open then setOpen(false) end
		end)

		local api = {Type = "color", Changed = sig, Float = float}
		function api:Get() return color end
		function api:GetAlpha() return alpha end
		function api:Set(newColor, newAlpha)
			if typeof(newColor) ~= "Color3" then return end
			h, s, v = newColor:ToHSV()
			if withAlpha and type(newAlpha) == "number" then alpha = math.clamp(newAlpha, 0, 1) end
			refresh(false)
		end
		function api:Open() setOpen(true) end
		function api:Close() setOpen(false) end
		api.Save = function() return {r = color.R, g = color.G, b = color.B, a = alpha} end
		api.Load = function(data)
			if type(data) == "table" and data.r then
				api:Set(Color3.new(data.r, data.g, data.b), data.a)
			end
		end
		api.Refire = function()
			if withAlpha then sig:Fire(color, alpha) else sig:Fire(color) end
		end

		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- ===== Text input / keybind =====
	-- AddInputText(name, [defaultText], [placeholder], callback) -> callback(text, enterPressed)
	-- Fires when the box loses focus.
	function proxy:AddInputText(name, defaultText, placeholder, callback)
		if type(defaultText) == "function" then
			callback = defaultText
			defaultText, placeholder = nil, nil
		elseif type(placeholder) == "function" then
			callback = placeholder
			placeholder = nil
		end
		local sig = newSignal(callback)

		local Row = newRow()

		local Box = themeText(create("TextBox", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			PlaceholderText = placeholder or "",
			PlaceholderColor3 = Style.TextDisabled,
			Text = defaultText or "",
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
		}, Row))
		paint(Box, Style.FrameBg)
		create("UIPadding", {PaddingLeft = UDim.new(0, Style.FramePaddingX)}, Box)

		local NameLabel = nameLabel(Row, name)

		local hovered, focused = false, false
		local function refreshBox()
			paint(Box, focused and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end
		Box.MouseEnter:Connect(function() hovered = true refreshBox() end)
		Box.MouseLeave:Connect(function() hovered = false refreshBox() end)
		Box.Focused:Connect(function() focused = true refreshBox() end)
		Box.FocusLost:Connect(function(enterPressed)
			focused = false
			refreshBox()
			sig:Fire(Box.Text, enterPressed)
		end)

		local api = {Type = "string", Changed = sig}
		function api:Get() return Box.Text end
		function api:Set(text) Box.Text = tostring(text) end
		api.Refire = function() sig:Fire(Box.Text, false) end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- AddKeybind(name, [defaultKeyCode], onPressed, [onChanged], [{Mode = "Press"|"Hold"|"Toggle"|"Always", OnState = fn}])
	-- Click the box, press a key to bind it (Escape clears). Right-click the box to cycle the mode.
	-- onPressed(keyCode) fires whenever the bound key is pressed; onChanged(keyCode|nil) fires on rebind.
	-- OnState(active) fires for Hold/Toggle/Always modes. api:IsActive() returns the current state.
	local KEYBIND_MODES = {"Press", "Hold", "Toggle", "Always"}
	function proxy:AddKeybind(name, defaultKey, onPressed, onChanged, options)
		if type(defaultKey) == "function" then
			local a, b, c = defaultKey, onPressed, onChanged
			onPressed, onChanged, options = a, b, c
			defaultKey = nil
		end
		if type(onChanged) == "table" then
			options, onChanged = onChanged, nil
		end
		options = type(options) == "table" and options or {}

		local sig = newSignal(onChanged)
		local key = defaultKey
		local mode = table.find(KEYBIND_MODES, options.Mode) and options.Mode or "Press"
		local active = mode == "Always"
		local listening = false

		local Row = newRow()

		local Button = themeText(create("TextButton", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			Text = "",
		}, Row))
		paint(Button, Style.FrameBg)

		local NameLabel = nameLabel(Row, name)

		local hovered = false
		local function refreshButton()
			local text = "[ " .. (key and key.Name or "None") .. " ]"
			if mode ~= "Press" then text = text .. " " .. mode end
			Button.Text = listening and "[ press a key... ]" or text
			paint(Button, listening and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end
		refreshButton()

		local function setActive(state)
			if active == state then return end
			active = state
			if options.OnState then pcall(options.OnState, active) end
		end

		Button.MouseEnter:Connect(function() hovered = true refreshButton() end)
		Button.MouseLeave:Connect(function() hovered = false refreshButton() end)
		Button.MouseButton1Click:Connect(function()
			listening = not listening
			refreshButton()
		end)
		Button.MouseButton2Click:Connect(function()
			local index = table.find(KEYBIND_MODES, mode) or 1
			mode = KEYBIND_MODES[index % #KEYBIND_MODES + 1]
			setActive(mode == "Always")
			refreshButton()
			sig:Fire(key)
		end)

		window._connect(UserInputService.InputBegan, function(input, gameProcessed)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					key = (input.KeyCode ~= Enum.KeyCode.Escape) and input.KeyCode or nil
					listening = false
					refreshButton()
					sig:Fire(key)
				elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
					if not hovered then
						listening = false
						refreshButton()
					end
				end
			elseif key and input.UserInputType == Enum.UserInputType.Keyboard
				and input.KeyCode == key
				and not gameProcessed
				and not UserInputService:GetFocusedTextBox() then
				if onPressed then pcall(onPressed, key) end
				if mode == "Hold" then
					setActive(true)
				elseif mode == "Toggle" then
					setActive(not active)
				end
			end
		end)
		window._connect(UserInputService.InputEnded, function(input)
			if mode == "Hold" and key and input.KeyCode == key then
				setActive(false)
			end
		end)

		table.insert(window.ClosePopups, function()
			if listening then
				listening = false
				refreshButton()
			end
		end)

		local api = {Type = "key", Changed = sig}
		function api:Get() return key end
		function api:Set(newKey)
			key = newKey
			refreshButton()
		end
		function api:GetMode() return mode end
		function api:SetMode(newMode)
			if table.find(KEYBIND_MODES, newMode) then
				mode = newMode
				setActive(mode == "Always")
				refreshButton()
			end
		end
		function api:IsActive() return active end
		api.Save = function() return {key = key and key.Name or false, mode = mode} end
		api.Load = function(data)
			if type(data) == "table" then
				key = data.key and Enum.KeyCode[data.key] or nil
				if table.find(KEYBIND_MODES, data.mode) then
					mode = data.mode
					setActive(mode == "Always")
				end
				refreshButton()
			end
		end
		api.Refire = function() sig:Fire(key) end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- ===== Graphs / tables =====
	-- AddPlotLines(name, values, [height], [{Min = n, Max = n}])  api:Set(list) / api:Push(value)
	function proxy:AddPlotLines(name, values, height, options)
		height = type(height) == "number" and height or 40
		options = type(options) == "table" and options or {}
		values = values or {}
		local MAX_POINTS = 200

		local Row = newRow(height)
		local Plot = create("Frame", {
			Size = UDim2.new(SPLIT, 0, 1, 0),
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, Row)
		paint(Plot, Style.FrameBg)
		local NameLabel = label(Row, {
			Position = UDim2.new(SPLIT, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(1 - SPLIT, -Style.ItemInnerSpacing, 0, Style.FrameHeight),
			Text = name,
		})

		local segments = {}
		local function redraw()
			local count = #values
			local size = Plot.AbsoluteSize
			local lo, hi = options.Min, options.Max
			if not lo or not hi then
				local dataLo, dataHi = math.huge, -math.huge
				for _, value in ipairs(values) do
					dataLo = math.min(dataLo, value)
					dataHi = math.max(dataHi, value)
				end
				lo = lo or (dataLo == math.huge and 0 or dataLo)
				hi = hi or (dataHi == -math.huge and 1 or dataHi)
			end
			if hi == lo then hi = lo + 1 end

			local used = 0
			if count >= 2 and size.X > 0 and size.Y > 0 then
				local pad = 4
				local function point(index)
					local x = pad + (size.X - pad * 2) * (index - 1) / (count - 1)
					local y = size.Y - pad - (size.Y - pad * 2) * (values[index] - lo) / (hi - lo)
					return Vector2.new(x, y)
				end
				for index = 1, count - 1 do
					used = used + 1
					local segment = segments[used]
					if not segment then
						segment = create("Frame", {BorderSizePixel = 0}, Plot)
						segments[used] = segment
					end
					segment.BackgroundColor3 = Style.PlotLines
					segment.Visible = true
					placeLine(segment, point(index), point(index + 1), 1)
				end
			end
			for index = used + 1, #segments do segments[index].Visible = false end
		end
		Plot:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw)
		table.insert(Restylers, redraw)
		redraw()

		local api = {Type = "list"}
		function api:Get() return values end
		function api:Set(list)
			values = {}
			for index, value in ipairs(list or {}) do values[index] = value end
			redraw()
		end
		function api:Push(value)
			table.insert(values, value)
			while #values > MAX_POINTS do table.remove(values, 1) end
			redraw()
		end
		return Row, decorate(window, Row, api, {nameLabel = NameLabel})
	end

	-- AddTable({"Col A", "Col B"}, {{1, 2}, {3, 4}})   api:Add(cells) / api:SetRows(rows) / api:Clear()
	function proxy:AddTable(columns, rows)
		local frameH = Style.FrameHeight
		local n = math.max(#columns, 1)

		local Holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, Content)
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 1),
		}, Holder)

		local function makeRow(cells, order, isHeader)
			local R = create("Frame", {
				Size = UDim2.new(1, 0, 0, frameH),
				BorderSizePixel = 0,
				LayoutOrder = order,
			}, Holder)
			if isHeader then
				paint(R, Style.Header)
			elseif order % 2 == 0 then
				R.BackgroundColor3 = Color3.new(1, 1, 1)
				R.BackgroundTransparency = 0.94
			else
				R.BackgroundTransparency = 1
			end
			for index = 1, n do
				local cell = cells[index]
				label(R, {
					Position = UDim2.new((index - 1) / n, Style.FramePaddingX, 0, 0),
					Size = UDim2.new(1 / n, -Style.FramePaddingX, 1, 0),
					Text = tostring(cell ~= nil and cell or ""),
					TextTruncate = Enum.TextTruncate.AtEnd,
				})
			end
			return R
		end

		makeRow(columns, 0, true)
		local dataRows = {}
		local api = {Type = "table"}
		function api:Add(cells)
			table.insert(dataRows, makeRow(cells, #dataRows + 1, false))
		end
		function api:Clear()
			for _, rowFrame in ipairs(dataRows) do rowFrame:Destroy() end
			dataRows = {}
		end
		function api:SetRows(newRows)
			self:Clear()
			for _, cells in ipairs(newRows or {}) do self:Add(cells) end
		end
		function api:Get() return dataRows end
		api.Save = function() return nil end
		api:SetRows(rows)
		return Holder, decorate(window, Holder, api, {})
	end

	-- ===== Containers =====
	local function buildSection(name, defaultOpen, isTree)
		local frameH = Style.FrameHeight
		local open = defaultOpen ~= false and defaultOpen ~= nil and true or (defaultOpen == true)
		if defaultOpen == nil then open = false end

		local Holder = newBox(Content)
		local Header = create("TextButton", {
			Size = UDim2.new(1, 0, 0, frameH),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = 1,
		}, Holder)
		if isTree then
			Header.BackgroundTransparency = 1
		else
			paint(Header, Style.Header)
		end

		local Arrow = label(Header, {
			Position = UDim2.fromOffset(Style.FramePaddingX, 0),
			Size = UDim2.fromOffset(14, frameH),
			TextSize = 9,
			Text = open and "▼" or "▶",
		})
		local Title = label(Header, {
			Position = UDim2.fromOffset(Style.FramePaddingX + 16, 0),
			Size = UDim2.new(1, -(Style.FramePaddingX + 16), 1, 0),
			Text = name,
		})

		local Body = newBox(Holder, 2)
		Body.Visible = open
		if isTree then
			create("UIPadding", {PaddingLeft = UDim.new(0, 14)}, Body)
		end

		local hovered = false
		local function refreshHeader()
			if isTree then
				if hovered then paint(Header, Style.HeaderHovered) else Header.BackgroundTransparency = 1 end
			else
				paint(Header, hovered and Style.HeaderHovered or Style.Header)
			end
		end
		Header.MouseEnter:Connect(function() hovered = true refreshHeader() end)
		Header.MouseLeave:Connect(function() hovered = false refreshHeader() end)

		local section = buildProxy(window, Body)
		section.Header = Header
		section.Holder = Holder
		function section:SetOpen(state)
			open = state and true or false
			Body.Visible = open
			Arrow.Text = open and "▼" or "▶"
			for _, closePopup in ipairs(window.ClosePopups) do closePopup() end
			return self
		end
		function section:IsOpen() return open end
		function section:Toggle() return self:SetOpen(not open) end
		function section:SetName(text) Title.Text = tostring(text) return self end
		function section:SetVisible(state) Holder.Visible = state and true or false return self end
		Header.MouseButton1Click:Connect(function() section:SetOpen(not open) end)
		return section
	end

	-- AddCollapsingHeader(name, [defaultOpen]) -> section (use it like a tab: section:AddButton(...))
	function proxy:AddCollapsingHeader(name, defaultOpen)
		return buildSection(name, defaultOpen, false)
	end

	-- AddTreeNode(name, [defaultOpen]) -> indented section, nestable
	function proxy:AddTreeNode(name, defaultOpen)
		return buildSection(name, defaultOpen, true)
	end

	-- AddRow(3) or AddRow({1, 2, 1}) -> one container per column; widgets added to them sit side by side.
	-- Optional builder: AddRow(2, function(left, right) left:AddButton(...) right:AddButton(...) end)
	function proxy:AddRow(widths, builder)
		local weights = {}
		if type(widths) == "number" then
			for index = 1, math.max(math.floor(widths), 1) do weights[index] = 1 end
		elseif type(widths) == "table" and #widths > 0 then
			weights = widths
		else
			weights = {1, 1}
		end
		local total = 0
		for _, weight in ipairs(weights) do total = total + weight end
		local n = #weights

		local Holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, Content)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, Style.ItemSpacing),
		}, Holder)

		local cols = {}
		for index, weight in ipairs(weights) do
			local fraction = weight / total
			local col = create("Frame", {
				Size = UDim2.new(fraction, -Style.ItemSpacing * (n - 1) * fraction, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = index,
			}, Holder)
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, Style.ItemSpacing),
			}, col)
			cols[index] = buildProxy(window, col)
		end
		if builder then builder(table.unpack(cols)) end
		return table.unpack(cols)
	end
	proxy.AddSameLine = proxy.AddRow

	-- AddTooltip(widgetRowOrApi, text): text shows next to the cursor after hovering for a moment.
	function proxy:AddTooltip(target, text)
		if type(target) == "table" and target.Row then target = target.Row end
		attachTooltip(window, target, text)
		return target
	end

	return proxy
end

function ImGuiLib.new(windowTitle)
	local self = setmetatable({}, ImGuiLib)

	local TITLE_H = Style.FrameHeight
	local MIN_SIZE = Vector2.new(260, 140)

	self.Size = Vector2.new(380, 330)
	self.Tabs = {}
	self.ClosePopups = {}      -- dropdowns/keybinds: closed when resizing, scrolling, switching tabs
	self.CloseFloating = {}    -- color picker windows: closed when switching tabs or collapsing
	self.Connections = {}
	self.Flags = {}
	self.Tips = {}
	self.ActiveTabContent = nil
	self.Title = windowTitle or "Dear ImGui Window"
	self._tabCounter = 0

	local function connect(signal, fn)
		local conn = signal:Connect(fn)
		table.insert(self.Connections, conn)
		return conn
	end
	self._connect = connect

	self.ScreenGui = create("ScreenGui", {
		Name = "ImGuiCustomLib",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
	}, CoreGui)

	self.MainFrame = create("Frame", {
		Size = UDim2.fromOffset(self.Size.X, self.Size.Y),
		Position = UDim2.new(0.5, -self.Size.X / 2, 0.5, -self.Size.Y / 2),
		BorderSizePixel = 0,
	}, self.ScreenGui)
	paint(self.MainFrame, Style.WindowBg)
	border(self.MainFrame)

	self.TopBar = create("Frame", {
		Size = UDim2.new(1, 0, 0, TITLE_H),
		BorderSizePixel = 0,
	}, self.MainFrame)
	paint(self.TopBar, Style.TitleBgActive)

	local CollapseButton = themeText(create("TextButton", {
		Size = UDim2.fromOffset(TITLE_H, TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "▼",
		TextColor3 = Style.Text,
		TextSize = 10,
		Font = Style.Font,
	}, self.TopBar))

	self.TitleLabel = label(self.TopBar, {
		Position = UDim2.fromOffset(TITLE_H, 0),
		Size = UDim2.new(1, -TITLE_H, 1, 0),
		Text = self.Title,
	})

	self.Body = create("Frame", {
		Position = UDim2.fromOffset(0, TITLE_H),
		Size = UDim2.new(1, 0, 1, -TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.MainFrame)

	self.TabBar = create("Frame", {
		Position = UDim2.fromOffset(Style.WindowPadding, Style.WindowPadding),
		Size = UDim2.new(1, -Style.WindowPadding * 2, 0, Style.FrameHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.Body)

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
	}, self.TabBar)

	local tabLineY = Style.WindowPadding + Style.FrameHeight
	local TabLine = create("Frame", {
		Position = UDim2.fromOffset(Style.WindowPadding, tabLineY),
		Size = UDim2.new(1, -Style.WindowPadding * 2, 0, 1),
		BorderSizePixel = 0,
	}, self.Body)
	paint(TabLine, Style.TabActive)

	self.ContentTop = tabLineY + 1

	-- Tooltip
	self.TipFrame = create("Frame", {
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 500,
	}, self.ScreenGui)
	paint(self.TipFrame, Style.PopupBg)
	border(self.TipFrame)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 3),
		PaddingBottom = UDim.new(0, 3),
	}, self.TipFrame)
	self.TipLabel = label(self.TipFrame, {
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Text = "",
		ZIndex = 501,
	})

	function self:_showTip(text)
		self.TipLabel.Text = tostring(text)
		self.TipFrame.Visible = true
	end
	function self:_hideTip()
		self.TipFrame.Visible = false
	end

	connect(RunService.RenderStepped, function()
		if self.TipFrame.Visible then
			local mouse = UserInputService:GetMouseLocation()
			local bounds = self.ScreenGui.AbsoluteSize
			local size = self.TipFrame.AbsoluteSize
			self.TipFrame.Position = UDim2.fromOffset(
				math.max(0, math.min(mouse.X + 14, bounds.X - size.X - 2)),
				math.max(0, math.min(mouse.Y + 16, bounds.Y - size.Y - 2))
			)
		end
	end)

	-- Toasts (window:Notify)
	self.Toasts = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 400,
	}, self.ScreenGui)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 6),
	}, self.Toasts)

	-- Resize grip
	local ResizeGrip = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -1, 1, -1),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "◢",
		TextSize = 16,
		Font = Style.Font,
		TextColor3 = Style.ResizeGrip[1],
		TextTransparency = Style.ResizeGrip[2],
		ZIndex = 50,
	}, self.Body)

	local resizing, resizeStart, sizeStart = false, nil, nil
	ResizeGrip.MouseEnter:Connect(function()
		if not resizing then ResizeGrip.TextTransparency = Style.ResizeGripHovered[2] end
	end)
	ResizeGrip.MouseLeave:Connect(function()
		if not resizing then ResizeGrip.TextTransparency = Style.ResizeGrip[2] end
	end)
	ResizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = Vector2.new(input.Position.X, input.Position.Y)
			sizeStart = self.Size
			ResizeGrip.TextTransparency = Style.ResizeGripActive[2]
		end
	end)

	local isCollapsed = false
	local function setCollapsed(value)
		isCollapsed = value
		CollapseButton.Text = isCollapsed and "▶" or "▼"
		paint(self.TopBar, isCollapsed and Style.TitleBgCollapsed or Style.TitleBgActive)
		self.Body.Visible = not isCollapsed
		self.MainFrame.BackgroundTransparency = isCollapsed and 1 or Style.WindowBg[2]
		self.MainFrame.Size = isCollapsed
			and UDim2.fromOffset(self.Size.X, TITLE_H)
			or UDim2.fromOffset(self.Size.X, self.Size.Y)
		for _, closePopup in ipairs(self.ClosePopups) do closePopup() end
		for _, closeFloating in ipairs(self.CloseFloating) do closeFloating() end
	end
	self._setCollapsed = setCollapsed

	CollapseButton.MouseButton1Click:Connect(function()
		setCollapsed(not isCollapsed)
	end)

	local dragging, dragStart, startPos
	self.TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = self.MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		if dragging then
			local delta = input.Position - dragStart
			self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		elseif resizing then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStart
			self.Size = Vector2.new(
				math.max(MIN_SIZE.X, sizeStart.X + delta.X),
				math.max(MIN_SIZE.Y, sizeStart.Y + delta.Y)
			)
			self.MainFrame.Size = UDim2.fromOffset(self.Size.X, self.Size.Y)
			for _, closePopup in ipairs(self.ClosePopups) do closePopup() end
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and resizing then
			resizing = false
			ResizeGrip.TextTransparency = Style.ResizeGrip[2]
		end
	end)

	-- Toggle key (window:SetToggleKey)
	connect(UserInputService.InputBegan, function(input, gameProcessed)
		if self.ToggleKey and input.KeyCode == self.ToggleKey
			and not gameProcessed and not UserInputService:GetFocusedTextBox() then
			self:Toggle()
		end
	end)

	return self
end

-- // Window methods
function ImGuiLib:SetVisible(state)
	self.ScreenGui.Enabled = state and true or false
end

function ImGuiLib:IsVisible()
	return self.ScreenGui.Enabled
end

function ImGuiLib:Toggle()
	self:SetVisible(not self.ScreenGui.Enabled)
end

-- window:SetToggleKey(Enum.KeyCode.RightShift) (nil removes it)
function ImGuiLib:SetToggleKey(keyCode)
	self.ToggleKey = keyCode
end

function ImGuiLib:SetTitle(text)
	self.Title = tostring(text)
	self.TitleLabel.Text = self.Title
end

function ImGuiLib:SetSize(x, y)
	self.Size = Vector2.new(math.max(260, x), math.max(140, y))
	self.MainFrame.Size = UDim2.fromOffset(self.Size.X, self.Size.Y)
	for _, closePopup in ipairs(self.ClosePopups) do closePopup() end
end

function ImGuiLib:SetPosition(x, y)
	self.MainFrame.Position = UDim2.fromOffset(x, y)
end

function ImGuiLib:SelectTab(name)
	for _, tab in ipairs(self.Tabs) do
		if tab.Name == name then
			tab.Select()
			return true
		end
	end
	return false
end

function ImGuiLib:RemoveTab(name)
	for index, tab in ipairs(self.Tabs) do
		if tab.Name == name then
			table.remove(self.Tabs, index)
			tab.Button:Destroy()
			tab.Content:Destroy()
			if tab.Active then
				self.ActiveTabContent = nil
				if self.Tabs[1] then self.Tabs[1].Select() end
			end
			return true
		end
	end
	return false
end

-- window:Notify("Saved!", 3, Color3.fromRGB(80, 200, 120)) - toast in the top-right corner
function ImGuiLib:Notify(text, duration, color)
	duration = duration or 3
	local Toast = create("Frame", {
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		LayoutOrder = os.clock() * 1000,
	}, self.Toasts)
	paint(Toast, Style.PopupBg)
	local stroke = border(Toast)
	local Accent = create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = color or Style.CheckMark,
		BorderSizePixel = 0,
	}, Toast)
	local Message = label(Toast, {
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -18, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		Text = tostring(text),
	})
	create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
	}, Message)

	task.delay(duration, function()
		if not Toast.Parent then return end
		local info = TweenInfo.new(0.4)
		TweenService:Create(Toast, info, {BackgroundTransparency = 1}):Play()
		TweenService:Create(Accent, info, {BackgroundTransparency = 1}):Play()
		TweenService:Create(Message, info, {TextTransparency = 1}):Play()
		TweenService:Create(stroke, info, {Transparency = 1}):Play()
		task.delay(0.45, function()
			if Toast.Parent then Toast:Destroy() end
		end)
	end)
	return Toast
end

-- window:SetStyle("Light" | "Dark" | "Classic" | {Key = value, ...})
function ImGuiLib:SetStyle(style)
	applyStyle(style)
	for _, tab in ipairs(self.Tabs) do tab.Refresh() end
end

-- // Config: widgets with a flag (api:SetFlag("speed")) are saved/loaded by name
local function configPath(name)
	return CONFIG_DIR .. "/" .. tostring(name) .. ".json"
end

-- window:SaveConfig("name") writes ImGuiLib/name.json (when writefile exists) and returns the JSON string
function ImGuiLib:SaveConfig(name)
	local data = {}
	for flag, api in pairs(self.Flags) do
		if api.Save then
			local ok, value = pcall(api.Save)
			if ok and value ~= nil then data[flag] = value end
		end
	end
	local json = HttpService:JSONEncode(data)
	if name and writefile then
		pcall(function()
			if makefolder and isfolder and not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
			writefile(configPath(name), json)
		end)
	end
	return json
end

-- window:LoadConfig("name") or window:LoadConfig(jsonString) -> true on success
function ImGuiLib:LoadConfig(source)
	local json
	if type(source) == "string" and source:sub(1, 1) == "{" then
		json = source
	elseif readfile and isfile then
		local ok, content = pcall(function()
			local path = configPath(source)
			if isfile(path) then return readfile(path) end
		end)
		if ok then json = content end
	end
	if not json then return false end

	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then return false end
	for flag, value in pairs(data) do
		local api = self.Flags[flag]
		if api then
			pcall(api.Load, value)
			if api.Refire then pcall(api.Refire) end
		end
	end
	return true
end

function ImGuiLib:ListConfigs()
	local names = {}
	if listfiles and isfolder and isfolder(CONFIG_DIR) then
		local ok, files = pcall(listfiles, CONFIG_DIR)
		if ok then
			for _, path in ipairs(files) do
				local fileName = path:match("([^/\\]+)%.json$")
				if fileName then table.insert(names, fileName) end
			end
		end
	end
	return names
end

function ImGuiLib:Destroy()
	for _, conn in ipairs(self.Connections) do
		pcall(function() conn:Disconnect() end)
	end
	self.Connections = {}
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
end

function ImGuiLib:AddTab(tabName)
	local window = self
	local tab = {Active = false, Hovered = false, Name = tabName}

	local textWidth = TextService:GetTextSize(tabName, Style.FontSize, Style.Font, Vector2.new(1000, 100)).X

	window._tabCounter = window._tabCounter + 1
	tab.Button = create("TextButton", {
		Size = UDim2.fromOffset(textWidth + 12, Style.FrameHeight),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = window._tabCounter,
	}, self.TabBar)
	create("UICorner", {CornerRadius = UDim.new(0, 4)}, tab.Button)

	tab.Filler = create("Frame", {
		Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, 0, 0, 4),
		BorderSizePixel = 0,
		ZIndex = 1,
	}, tab.Button)

	label(tab.Button, {
		Size = UDim2.fromScale(1, 1),
		Text = tabName,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})

	local function refreshColor()
		local pair = tab.Active and Style.TabActive or (tab.Hovered and Style.TabHovered or Style.Tab)
		paint(tab.Button, pair)
		paint(tab.Filler, pair)
	end

	local TabContent = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, window.ContentTop),
		Size = UDim2.new(1, 0, 1, -window.ContentTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Style.ScrollbarGrab,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Visible = false,
	}, window.Body)

	create("UIPadding", {
		PaddingLeft = UDim.new(0, Style.WindowPadding),
		PaddingRight = UDim.new(0, Style.WindowPadding),
		PaddingTop = UDim.new(0, Style.ItemSpacing),
		PaddingBottom = UDim.new(0, Style.WindowPadding),
	}, TabContent)

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, Style.ItemSpacing),
	}, TabContent)

	-- scrolling closes any open dropdown (their popups don't follow the content)
	TabContent:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		for _, closePopup in ipairs(window.ClosePopups) do closePopup() end
	end)

	tab.Content = TabContent
	tab.Refresh = refreshColor

	local function selectTab()
		for _, other in ipairs(window.Tabs) do
			other.Active = false
			other.Content.Visible = false
			other.Refresh()
		end
		tab.Active = true
		TabContent.Visible = true
		window.ActiveTabContent = TabContent
		refreshColor()
		for _, closePopup in ipairs(window.ClosePopups) do closePopup() end
		for _, closeFloating in ipairs(window.CloseFloating) do closeFloating() end
	end
	tab.Select = selectTab

	tab.Button.MouseEnter:Connect(function() tab.Hovered = true refreshColor() end)
	tab.Button.MouseLeave:Connect(function() tab.Hovered = false refreshColor() end)
	tab.Button.MouseButton1Click:Connect(selectTab)

	table.insert(window.Tabs, tab)
	refreshColor()
	if not window.ActiveTabContent then selectTab() end

	local proxy = buildProxy(window, TabContent)
	proxy.Name = tabName
	function proxy:Select() selectTab() end
	function proxy:Remove() window:RemoveTab(tabName) end
	return proxy
end

return ImGuiLib
