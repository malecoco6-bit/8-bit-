-- // Helpers
local function create(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function paint(instance, pair)
	instance.BackgroundColor3 = pair[1]
	instance.BackgroundTransparency = pair[2]
end

local function label(parent, properties)
	local props = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Style.Font,
		TextSize = Style.FontSize,
		TextColor3 = Style.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for key, value in pairs(properties) do
		props[key] = value
	end
	return create("TextLabel", props, parent)
end

local function isInside(guiObject, point)
	local position, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
	return point.X >= position.X and point.X <= position.X + size.X
		and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

-- Use the input's own Position (same coordinate space the GUI hit-testing uses here).
-- GetMouseLocation() is shifted by the top-bar inset and made popups/pickers read the wrong Y.
local function inputPoint(input)
	return Vector2.new(input.Position.X, input.Position.Y)
end

local function drawLine(parent, a, b, thickness, color)
	local delta = b - a
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2),
		Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.5, thickness),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, parent)
end

local function toHex(color)
	return string.format("#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
end

local function fromHex(text)
	local hex = tostring(text):gsub("^%s*#?", ""):gsub("%s*$", "")
	if #hex == 3 then
		hex = hex:gsub(".", function(c) return c .. c end)
	end
	if not hex:match("^%x%x%x%x%x%x$") then return nil end
	return Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16)
	)
end

local ImGuiLib = {}
ImGuiLib.__index = ImGuiLib
ImGuiLib.Style = Style

function ImGuiLib.new(windowTitle)
	local self = setmetatable({}, ImGuiLib)

	local TITLE_H = Style.FrameHeight
	local MIN_SIZE = Vector2.new(260, 140)

	self.Size = Vector2.new(380, 330)
	self.Tabs = {}
	self.ClosePopups = {}
	self.Connections = {}
	self.ActiveTabContent = nil

	local function connect(signal, fn)
		local conn = signal:Connect(fn)
		table.insert(self.Connections, conn)
		return conn
	end
	self._connect = connect

	self.ScreenGui = create("ScreenGui", {
		Name = "ImGuiCustomLib",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
	}, CoreGui)

	self.MainFrame = create("Frame", {
		Size = UDim2.fromOffset(self.Size.X, self.Size.Y),
		Position = UDim2.new(0.5, -self.Size.X / 2, 0.5, -self.Size.Y / 2),
		BorderSizePixel = 0,
	}, self.ScreenGui)
	paint(self.MainFrame, Style.WindowBg)

	create("UIStroke", {
		Color = Style.Border[1],
		Transparency = Style.Border[2],
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, self.MainFrame)

	self.TopBar = create("Frame", {
		Size = UDim2.new(1, 0, 0, TITLE_H),
		BorderSizePixel = 0,
	}, self.MainFrame)
	paint(self.TopBar, Style.TitleBgActive)

	local CollapseButton = create("TextButton", {
		Size = UDim2.fromOffset(TITLE_H, TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "▼",
		TextColor3 = Style.Text,
		TextSize = 10,
		Font = Style.Font,
	}, self.TopBar)

	label(self.TopBar, {
		Position = UDim2.fromOffset(TITLE_H, 0),
		Size = UDim2.new(1, -TITLE_H, 1, 0),
		Text = windowTitle or "Dear ImGui Window",
	})

	self.Body = create("Frame", {
		Position = UDim2.fromOffset(0, TITLE_H),
		Size = UDim2.new(1, 0, 1, -TITLE_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.MainFrame)

	self.TabBar = create("Frame", {
		Position = UDim2.fromOffset(Style.WindowPadding, Style.WindowPadding),
		Size = UDim2.new(1, -Style.WindowPadding * 2, 0, Style.FrameHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.Body)

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
	}, self.TabBar)

	local tabLineY = Style.WindowPadding + Style.FrameHeight
	local TabLine = create("Frame", {
		Position = UDim2.fromOffset(Style.WindowPadding, tabLineY),
		Size = UDim2.new(1, -Style.WindowPadding * 2, 0, 1),
		BorderSizePixel = 0,
	}, self.Body)
	paint(TabLine, Style.TabActive)

	self.ContentTop = tabLineY + 1

	local ResizeGrip = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -1, 1, -1),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "◢",
		TextSize = 16,
		Font = Style.Font,
		TextColor3 = Style.ResizeGrip[1],
		TextTransparency = Style.ResizeGrip[2],
		ZIndex = 50,
	}, self.Body)

	local resizing, resizeStart, sizeStart = false, nil, nil
	ResizeGrip.MouseEnter:Connect(function()
		if not resizing then ResizeGrip.TextTransparency = Style.ResizeGripHovered[2] end
	end)
	ResizeGrip.MouseLeave:Connect(function()
		if not resizing then ResizeGrip.TextTransparency = Style.ResizeGrip[2] end
	end)
	ResizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = Vector2.new(input.Position.X, input.Position.Y)
			sizeStart = self.Size
			ResizeGrip.TextTransparency = Style.ResizeGripActive[2]
		end
	end)

	local isCollapsed = false
	local function setCollapsed(value)
		isCollapsed = value
		CollapseButton.Text = isCollapsed and "▶" or "▼"
		paint(self.TopBar, isCollapsed and Style.TitleBgCollapsed or Style.TitleBgActive)
		self.Body.Visible = not isCollapsed
		self.MainFrame.BackgroundTransparency = isCollapsed and 1 or Style.WindowBg[2]
		self.MainFrame.Size = isCollapsed
			and UDim2.fromOffset(self.Size.X, TITLE_H)
			or UDim2.fromOffset(self.Size.X, self.Size.Y)
		for _, closePopup in ipairs(self.ClosePopups) do closePopup() end
	end

	CollapseButton.MouseButton1Click:Connect(function()
		setCollapsed(not isCollapsed)
	end)

	local dragging, dragStart, startPos
	self.TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = self.MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		if dragging then
			local delta = input.Position - dragStart
			self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		elseif resizing then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStart
			self.Size = Vector2.new(
				math.max(MIN_SIZE.X, sizeStart.X + delta.X),
				math.max(MIN_SIZE.Y, sizeStart.Y + delta.Y)
			)
			self.MainFrame.Size = UDim2.fromOffset(self.Size.X, self.Size.Y)
			for _, closePopup in ipairs(self.ClosePopups) do closePopup() end
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and resizing then
			resizing = false
			ResizeGrip.TextTransparency = Style.ResizeGrip[2]
		end
	end)

	return self
end

function ImGuiLib:SetVisible(state)
	self.ScreenGui.Enabled = state and true or false
end

function ImGuiLib:Destroy()
	for _, conn in ipairs(self.Connections) do
		pcall(function() conn:Disconnect() end)
	end
	self.Connections = {}
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
end

function ImGuiLib:AddTab(tabName)
	local window = self
	local tab = {Active = false, Hovered = false}

	local textWidth = TextService:GetTextSize(tabName, Style.FontSize, Style.Font, Vector2.new(1000, 100)).X

	tab.Button = create("TextButton", {
		Size = UDim2.fromOffset(textWidth + 12, Style.FrameHeight),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = #self.Tabs + 1,
	}, self.TabBar)
	create("UICorner", {CornerRadius = UDim.new(0, 4)}, tab.Button)

	tab.Filler = create("Frame", {
		Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, 0, 0, 4),
		BorderSizePixel = 0,
		ZIndex = 1,
	}, tab.Button)

	label(tab.Button, {
		Size = UDim2.fromScale(1, 1),
		Text = tabName,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})

	local function refreshColor()
		local pair = tab.Active and Style.TabActive or (tab.Hovered and Style.TabHovered or Style.Tab)
		paint(tab.Button, pair)
		paint(tab.Filler, pair)
	end

	local TabContent = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, window.ContentTop),
		Size = UDim2.new(1, 0, 1, -window.ContentTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Style.ScrollbarGrab,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Visible = false,
	}, window.Body)

	create("UIPadding", {
		PaddingLeft = UDim.new(0, Style.WindowPadding),
		PaddingRight = UDim.new(0, Style.WindowPadding),
		PaddingTop = UDim.new(0, Style.ItemSpacing),
		PaddingBottom = UDim.new(0, Style.WindowPadding),
	}, TabContent)

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, Style.ItemSpacing),
	}, TabContent)

	tab.Content = TabContent
	tab.Refresh = refreshColor

	local function selectTab()
		for _, other in ipairs(window.Tabs) do
			other.Active = false
			other.Content.Visible = false
			other.Refresh()
		end
		tab.Active = true
		TabContent.Visible = true
		window.ActiveTabContent = TabContent
		refreshColor()
		for _, closePopup in ipairs(window.ClosePopups) do closePopup() end
	end

	tab.Button.MouseEnter:Connect(function() tab.Hovered = true refreshColor() end)
	tab.Button.MouseLeave:Connect(function() tab.Hovered = false refreshColor() end)
	tab.Button.MouseButton1Click:Connect(selectTab)

	table.insert(window.Tabs, tab)
	refreshColor()
	if not window.ActiveTabContent then selectTab() end

	-- Shared dropdown builder (single + multi select)
	local function buildDropdown(name, options, default, callback, multi)
		local frameH = Style.FrameHeight
		local itemH = 18
		local popupPad = 4

		local selected          -- single mode
		local set = {}          -- multi mode: set[option] = true
		if multi then
			if type(default) == "table" then
				for _, option in ipairs(default) do set[option] = true end
			end
		else
			selected = default or options[1]
		end

		local function isSelected(option)
			if multi then return set[option] == true end
			return option == selected
		end

		local function selectedList()
			local list = {}
			for _, option in ipairs(options) do
				if set[option] then table.insert(list, option) end
			end
			return list
		end

		local function displayText()
			if not multi then return tostring(selected) end
			local names = {}
			for _, option in ipairs(selectedList()) do
				table.insert(names, tostring(option))
			end
			return #names > 0 and table.concat(names, ", ") or "None"
		end

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Combo = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ClipsDescendants = true,
		}, Row)
		paint(Combo, Style.FrameBg)

		local SelectedText = label(Combo, {
			Position = UDim2.fromOffset(Style.FramePaddingX, 0),
			Size = UDim2.new(1, -(frameH + Style.FramePaddingX), 1, 0),
			Text = displayText(),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})

		local ArrowButton = create("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(frameH, frameH),
			BorderSizePixel = 0,
		}, Combo)
		paint(ArrowButton, Style.Button)

		label(ArrowButton, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextSize = 9,
			Text = "▼",
		})

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local Popup = create("Frame", {
			Size = UDim2.fromOffset(100, #options * itemH + popupPad * 2),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 100,
		}, window.MainFrame)
		paint(Popup, Style.PopupBg)

		create("UIStroke", {
			Color = Style.Border[1],
			Transparency = Style.Border[2],
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, Popup)

		local items = {}
		local function itemText(option)
			return tostring(option)
		end

		local function refreshItems()
			for _, item in ipairs(items) do
				item.Label.Text = itemText(item.Option)
				if item.Hovered then
					paint(item.Button, Style.HeaderHovered)
				elseif isSelected(item.Option) then
					paint(item.Button, Style.HeaderSelected)
				else
					item.Button.BackgroundTransparency = 1
				end
			end
		end

		local open = false
		local comboHovered = false
		local function refreshCombo()
			paint(Combo, (comboHovered or open) and Style.FrameBgHovered or Style.FrameBg)
			paint(ArrowButton, comboHovered and Style.ButtonHovered or Style.Button)
		end

		local function setOpen(state)
			open = state
			if open then
				local main = window.MainFrame
				Popup.Position = UDim2.fromOffset(
					Combo.AbsolutePosition.X - main.AbsolutePosition.X,
					Combo.AbsolutePosition.Y + Combo.AbsoluteSize.Y - main.AbsolutePosition.Y
				)
				Popup.Size = UDim2.fromOffset(Combo.AbsoluteSize.X, #options * itemH + popupPad * 2)
				refreshItems()
			end
			Popup.Visible = open
			refreshCombo()
		end

		for index, option in ipairs(options) do
			local item = {Option = option, Hovered = false}

			item.Button = create("TextButton", {
				Position = UDim2.fromOffset(0, popupPad + (index - 1) * itemH),
				Size = UDim2.new(1, 0, 0, itemH),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 101,
			}, Popup)

			item.Label = label(item.Button, {
				Position = UDim2.fromOffset(Style.FramePaddingX + 4, 0),
				Size = UDim2.new(1, -(Style.FramePaddingX + 8), 1, 0),
				Text = itemText(option),
				ZIndex = 102,
			})

			item.Button.MouseEnter:Connect(function() item.Hovered = true refreshItems() end)
			item.Button.MouseLeave:Connect(function() item.Hovered = false refreshItems() end)
			item.Button.MouseButton1Click:Connect(function()
				if multi then
					-- stay open, toggle membership
					set[option] = (not set[option]) or nil
					SelectedText.Text = displayText()
					refreshItems()
					if callback then pcall(callback, selectedList()) end
				else
					selected = option
					SelectedText.Text = displayText()
					setOpen(false)
					if callback then pcall(callback, option) end
				end
			end)

			table.insert(items, item)
		end
		refreshItems()

		Combo.MouseEnter:Connect(function() comboHovered = true refreshCombo() end)
		Combo.MouseLeave:Connect(function() comboHovered = false refreshCombo() end)
		Combo.MouseButton1Click:Connect(function() setOpen(not open) end)

		window._connect(UserInputService.InputBegan, function(input)
			if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
				local point = inputPoint(input)
				if not isInside(Popup, point) and not isInside(Combo, point) then
					setOpen(false)
				end
			end
		end)

		TabContent:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			if open then setOpen(false) end
		end)

		table.insert(window.ClosePopups, function()
			if open then setOpen(false) end
		end)

		local api = {}
		function api:Get()
			if multi then return selectedList() end
			return selected
		end
		function api:Set(value)
			if multi then
				set = {}
				if type(value) == "table" then
					for _, option in ipairs(value) do set[option] = true end
				end
			else
				selected = value
			end
			SelectedText.Text = displayText()
			refreshItems()
		end

		return Row, api
	end

	local tabProxy = {}

	function tabProxy:AddLabel(text)
		return label(TabContent, {
			Size = UDim2.new(1, 0, 0, Style.FrameHeight),
			Text = text,
		})
	end

	function tabProxy:AddSeparator(text)
		if not text or text == "" then
			local Row = create("Frame", {
				Size = UDim2.new(1, 0, 0, 8),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, TabContent)
			local Line = create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.new(1, 0, 0, 1),
				BorderSizePixel = 0,
			}, Row)
			paint(Line, Style.Border)
			return Row
		end

		local width = TextService:GetTextSize(text, Style.FontSize, Style.Font, Vector2.new(1000, 100)).X
		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, Style.FrameHeight),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)
		local LeftLine = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(12, 1),
			BorderSizePixel = 0,
		}, Row)
		paint(LeftLine, Style.Border)
		label(Row, {
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.fromOffset(width + 2, Style.FrameHeight),
			Text = text,
		})
		local RightLine = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 18 + width + 8, 0.5, 0),
			Size = UDim2.new(1, -(18 + width + 8), 0, 1),
			BorderSizePixel = 0,
		}, Row)
		paint(RightLine, Style.Border)
		return Row
	end

	function tabProxy:AddButton(name, callback)
		local Button = create("TextButton", {
			Size = UDim2.new(1, 0, 0, Style.FrameHeight),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = name,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
		}, TabContent)
		paint(Button, Style.Button)

		Button.MouseEnter:Connect(function() paint(Button, Style.ButtonHovered) end)
		Button.MouseLeave:Connect(function() paint(Button, Style.Button) end)
		Button.MouseButton1Click:Connect(function()
			if callback then pcall(callback) end
		end)
		return Button
	end

	function tabProxy:AddCheckbox(name, defaultState, callback)
		-- Allow AddCheckbox(name, callback)
		if type(defaultState) == "function" then
			callback = defaultState
			defaultState = false
		end
		local toggled = defaultState and true or false
		local size = Style.FrameHeight

		local Row = create("TextButton", {
			Size = UDim2.new(1, 0, 0, size),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, TabContent)

		local Box = create("Frame", {
			Size = UDim2.fromOffset(size, size),
			BorderSizePixel = 0,
		}, Row)
		paint(Box, Style.FrameBg)

		local Check = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = toggled,
		}, Box)
		local scale = size / 20
		local p1 = Vector2.new(3, 10) * scale
		local p2 = Vector2.new(7.7, 14.7) * scale
		local p3 = Vector2.new(17.1, 5.3) * scale
		drawLine(Check, p1, p2, 2, Style.CheckMark)
		drawLine(Check, p2, p3, 2, Style.CheckMark)

		label(Row, {
			Position = UDim2.fromOffset(size + Style.ItemInnerSpacing, 0),
			Size = UDim2.new(1, -(size + Style.ItemInnerSpacing), 1, 0),
			Text = name,
		})

		local hovered, pressed = false, false
		local function refreshBox()
			paint(Box, pressed and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end

		Row.MouseEnter:Connect(function() hovered = true refreshBox() end)
		Row.MouseLeave:Connect(function() hovered, pressed = false, false refreshBox() end)
		Row.MouseButton1Down:Connect(function() pressed = true refreshBox() end)
		Row.MouseButton1Up:Connect(function() pressed = false refreshBox() end)

		Row.MouseButton1Click:Connect(function()
			toggled = not toggled
			Check.Visible = toggled
			if callback then pcall(callback, toggled) end
		end)

		return Row
	end

	function tabProxy:AddSlider(name, min, max, defaultVal, step, callback)
		-- Allow calling without a step: AddSlider(name, min, max, default, callback)
		if type(step) == "function" then
			callback = step
			step = 1
		end
		if type(step) ~= "number" or step <= 0 then
			step = 1
		end
		local value = math.clamp(defaultVal or min, min, max)
		local frameH = Style.FrameHeight
		local range = math.max(max - min, 1)

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Track = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		paint(Track, Style.FrameBg)

		local Grab = create("Frame", {
			BackgroundColor3 = Style.SliderGrab,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, Track)

		local ValueText = label(Track, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = tostring(value),
			ZIndex = 3,
		})

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local function metrics()
			local usable = math.max(Track.AbsoluteSize.X - 4, 1)
			local grabWidth = math.max(usable / (max - min + 1), 12)
			return usable, grabWidth
		end

		local function refresh()
			local usable, grabWidth = metrics()
			local alpha = (value - min) / range
			Grab.Size = UDim2.fromOffset(grabWidth, frameH - 4)
			Grab.Position = UDim2.fromOffset(2 + (usable - grabWidth) * alpha, 2)
			ValueText.Text = tostring(value)
		end
		Track:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
		refresh()

		local hovered, dragging = false, false
		local function refreshColors()
			paint(Track, dragging and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
			Grab.BackgroundColor3 = dragging and Style.SliderGrabActive or Style.SliderGrab
		end

		local function setFromMouse(mouseX)
			local usable, grabWidth = metrics()
			local travel = usable - grabWidth
			if travel <= 0 then return end
			local alpha = math.clamp((mouseX - Track.AbsolutePosition.X - 2 - grabWidth / 2) / travel, 0, 1)
			local raw = min + alpha * range
			local newValue = math.clamp(math.floor((raw - min) / step + 0.5) * step + min, min, max)
			if newValue ~= value then
				value = newValue
				refresh()
				if callback then pcall(callback, value) end
			end
		end

		Track.MouseEnter:Connect(function() hovered = true refreshColors() end)
		Track.MouseLeave:Connect(function() hovered = false refreshColors() end)

		Track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				refreshColors()
				setFromMouse(input.Position.X)
			end
		end)

		window._connect(UserInputService.InputChanged, function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				setFromMouse(input.Position.X)
			end
		end)

		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
				dragging = false
				refreshColors()
			end
		end)

		return Row
	end

	tabProxy.AddArrowSlider = tabProxy.AddSlider

	-- AddDropdown(name, options, [default], callback)           -> callback(option)
	function tabProxy:AddDropdown(name, options, defaultOption, callback)
		-- Allow AddDropdown(name, options, callback)
		if type(defaultOption) == "function" then
			callback = defaultOption
			defaultOption = nil
		end
		return buildDropdown(name, options, defaultOption, callback, false)
	end

	-- AddMultiDropdown(name, options, [defaultsList], callback) -> callback({selected options})
	-- Popup stays open while toggling items. Returns Row, api (api:Get() / api:Set(list))
	function tabProxy:AddMultiDropdown(name, options, defaults, callback)
		if type(defaults) == "function" then
			callback = defaults
			defaults = nil
		end
		return buildDropdown(name, options, defaults, callback, true)
	end

	-- AddColorPicker(name, [defaultColor3], callback) -> callback(Color3)
	-- Saturation/Value square, hue bar and hex input. Returns Row, api (api:Get() / api:Set(Color3))
	function tabProxy:AddColorPicker(name, defaultColor, callback)
		if type(defaultColor) == "function" then
			callback = defaultColor
			defaultColor = nil
		end
		local color = typeof(defaultColor) == "Color3" and defaultColor or Color3.fromRGB(66, 150, 250)
		local h, s, v = color:ToHSV()
		local frameH = Style.FrameHeight

		local PAD, SV_W, SV_H, BAR_W, GAP = 8, 144, 120, 16, 6
		local POPUP_W = PAD * 2 + SV_W + GAP + BAR_W
		local POPUP_H = PAD * 2 + SV_H + GAP + frameH

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Swatch = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, Row)
		local SwatchStroke = create("UIStroke", {
			Color = Style.Border[1],
			Transparency = Style.Border[2],
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, Swatch)

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local Popup = create("Frame", {
			Size = UDim2.fromOffset(POPUP_W, POPUP_H),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 100,
		}, window.MainFrame)
		paint(Popup, Style.PopupBg)
		create("UIStroke", {
			Color = Style.Border[1],
			Transparency = Style.Border[2],
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, Popup)

		-- Saturation / Value square
		local SVBox = create("TextButton", {
			Position = UDim2.fromOffset(PAD, PAD),
			Size = UDim2.fromOffset(SV_W, SV_H),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ClipsDescendants = true,
			ZIndex = 101,
		}, Popup)

		local WhiteLayer = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 102,
		}, SVBox)
		create("UIGradient", {Transparency = NumberSequence.new(0, 1)}, WhiteLayer)

		local BlackLayer = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 103,
		}, SVBox)
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new(1, 0),
		}, BlackLayer)

		local Cursor = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, SVBox)
		create("UICorner", {CornerRadius = UDim.new(1, 0)}, Cursor)
		create("UIStroke", {
			Color = Color3.new(1, 1, 1),
			Thickness = 1.5,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, Cursor)

		-- Hue bar
		local HueBar = create("TextButton", {
			Position = UDim2.fromOffset(PAD + SV_W + GAP, PAD),
			Size = UDim2.fromOffset(BAR_W, SV_H),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 101,
		}, Popup)
		create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
			}),
		}, HueBar)

		local HueMarker = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(1, 4, 0, 3),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 102,
		}, HueBar)
		create("UIStroke", {
			Color = Color3.new(0, 0, 0),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, HueMarker)

		-- Hex input
		local Hex = create("TextBox", {
			Position = UDim2.fromOffset(PAD, PAD + SV_H + GAP),
			Size = UDim2.fromOffset(POPUP_W - PAD * 2, frameH),
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			ClearTextOnFocus = false,
			Text = toHex(color),
			ZIndex = 101,
		}, Popup)
		paint(Hex, Style.FrameBg)

		local function refresh(fire)
			color = Color3.fromHSV(h, s, v)
			Swatch.BackgroundColor3 = color
			SVBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			Cursor.Position = UDim2.fromScale(s, 1 - v)
			HueMarker.Position = UDim2.new(0.5, 0, h, 0)
			if not Hex:IsFocused() then
				Hex.Text = toHex(color)
			end
			if fire and callback then pcall(callback, color) end
		end
		refresh(false)

		Hex.Focused:Connect(function() paint(Hex, Style.FrameBgActive) end)
		Hex.FocusLost:Connect(function()
			paint(Hex, Style.FrameBg)
			local parsed = fromHex(Hex.Text)
			if parsed then
				h, s, v = parsed:ToHSV()
				refresh(true)
			end
			Hex.Text = toHex(color)
		end)

		-- Dragging
		local dragMode = nil
		local function updateFromMouse(m)
			if dragMode == "sv" then
				s = math.clamp((m.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
				v = 1 - math.clamp((m.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
			elseif dragMode == "hue" then
				h = math.clamp((m.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
			else
				return
			end
			refresh(true)
		end

		SVBox.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = "sv"
				updateFromMouse(inputPoint(input))
			end
		end)
		HueBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = "hue"
				updateFromMouse(inputPoint(input))
			end
		end)

		window._connect(UserInputService.InputChanged, function(input)
			if dragMode and input.UserInputType == Enum.UserInputType.MouseMovement then
				updateFromMouse(inputPoint(input))
			end
		end)
		window._connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragMode = nil
			end
		end)

		-- Open / close
		local open = false
		local function setOpen(state)
			open = state
			if open then
				local main = window.MainFrame
				Popup.Position = UDim2.fromOffset(
					Swatch.AbsolutePosition.X - main.AbsolutePosition.X,
					Swatch.AbsolutePosition.Y + Swatch.AbsoluteSize.Y - main.AbsolutePosition.Y
				)
			else
				dragMode = nil
			end
			Popup.Visible = open
			SwatchStroke.Transparency = open and 0 or Style.Border[2]
		end

		Swatch.MouseButton1Click:Connect(function() setOpen(not open) end)

		window._connect(UserInputService.InputBegan, function(input)
			if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
				local point = inputPoint(input)
				if not isInside(Popup, point) and not isInside(Swatch, point) then
					setOpen(false)
				end
			end
		end)

		TabContent:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			if open then setOpen(false) end
		end)

		table.insert(window.ClosePopups, function()
			if open then setOpen(false) end
		end)

		local api = {}
		function api:Get() return color end
		function api:Set(newColor)
			if typeof(newColor) ~= "Color3" then return end
			h, s, v = newColor:ToHSV()
			refresh(false)
		end

		return Row, api
	end

	-- AddInputText(name, [defaultText], [placeholder], callback) -> callback(text, enterPressed)
	-- Fires when the box loses focus.
	function tabProxy:AddInputText(name, defaultText, placeholder, callback)
		if type(defaultText) == "function" then
			callback = defaultText
			defaultText, placeholder = nil, nil
		elseif type(placeholder) == "function" then
			callback = placeholder
			placeholder = nil
		end
		local frameH = Style.FrameHeight

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Box = create("TextBox", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			PlaceholderText = placeholder or "",
			PlaceholderColor3 = Style.TextDisabled,
			Text = defaultText or "",
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
		}, Row)
		paint(Box, Style.FrameBg)
		create("UIPadding", {PaddingLeft = UDim.new(0, Style.FramePaddingX)}, Box)

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local hovered, focused = false, false
		local function refreshBox()
			paint(Box, focused and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end
		Box.MouseEnter:Connect(function() hovered = true refreshBox() end)
		Box.MouseLeave:Connect(function() hovered = false refreshBox() end)
		Box.Focused:Connect(function() focused = true refreshBox() end)
		Box.FocusLost:Connect(function(enterPressed)
			focused = false
			refreshBox()
			if callback then pcall(callback, Box.Text, enterPressed) end
		end)

		local api = {}
		function api:Get() return Box.Text end
		function api:Set(text) Box.Text = tostring(text) end

		return Row, api
	end

	-- AddKeybind(name, [defaultKeyCode], onPressed, [onChanged])
	-- Click the box, press a key to bind it (Escape clears).
	-- onPressed(keyCode) fires when the bound key is pressed; onChanged(keyCode|nil) fires on rebind.
	function tabProxy:AddKeybind(name, defaultKey, onPressed, onChanged)
		if type(defaultKey) == "function" then
			onChanged = onPressed
			onPressed = defaultKey
			defaultKey = nil
		end
		local key = defaultKey
		local listening = false
		local frameH = Style.FrameHeight

		local Row = create("Frame", {
			Size = UDim2.new(1, 0, 0, frameH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, TabContent)

		local Button = create("TextButton", {
			Size = UDim2.new(0.65, 0, 1, 0),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = Style.Font,
			TextSize = Style.FontSize,
			TextColor3 = Style.Text,
			Text = "",
		}, Row)
		paint(Button, Style.FrameBg)

		label(Row, {
			Position = UDim2.new(0.65, Style.ItemInnerSpacing, 0, 0),
			Size = UDim2.new(0.35, -Style.ItemInnerSpacing, 1, 0),
			Text = name,
		})

		local hovered = false
		local function refreshButton()
			Button.Text = listening and "[ press a key... ]" or ("[ " .. (key and key.Name or "None") .. " ]")
			paint(Button, listening and Style.FrameBgActive or (hovered and Style.FrameBgHovered or Style.FrameBg))
		end
		refreshButton()

		Button.MouseEnter:Connect(function() hovered = true refreshButton() end)
		Button.MouseLeave:Connect(function() hovered = false refreshButton() end)
		Button.MouseButton1Click:Connect(function()
			listening = not listening
			refreshButton()
		end)

		window._connect(UserInputService.InputBegan, function(input, gameProcessed)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					key = (input.KeyCode ~= Enum.KeyCode.Escape) and input.KeyCode or nil
					listening = false
					refreshButton()
					if onChanged then pcall(onChanged, key) end
				elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
					if not isInside(Button, inputPoint(input)) then
						listening = false
						refreshButton()
					end
				end
			elseif key and input.UserInputType == Enum.UserInputType.Keyboard
				and input.KeyCode == key
				and not gameProcessed
				and not UserInputService:GetFocusedTextBox() then
				if onPressed then pcall(onPressed, key) end
			end
		end)

		table.insert(window.ClosePopups, function()
			if listening then
				listening = false
				refreshButton()
			end
		end)

		local api = {}
		function api:Get() return key end
		function api:Set(newKey)
			key = newKey
			refreshButton()
		end

		return Row, api
	end

	return tabProxy
end

return ImGuiLib
