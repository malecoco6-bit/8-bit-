-- // Theme registry: lets SetStyle repaint already-built widgets
local Themed = setmetatable({}, {__mode = "k"})      -- instance -> key of the Style pair it uses
local ThemedText = setmetatable({}, {__mode = "k"})  -- instance -> true (TextColor3 = Style.Text)
local Strokes = setmetatable({}, {__mode = "k"})     -- UIStroke -> true
local Restylers = {}
local PairKeys = {}
for key, value in pairs(Style) do
	if type(value) == "table" then PairKeys[value] = key end
end

-- // Helpers
local function create(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function paint(instance, pair)
	instance.BackgroundColor3 = pair[1]
	instance.BackgroundTransparency = pair[2]
	Themed[instance] = PairKeys[pair]
end

local function themeText(instance)
	ThemedText[instance] = true
	return instance
end

local function border(parent)
	local stroke = create("UIStroke", {
		Color = Style.Border[1],
		Transparency = Style.Border[2],
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
	Strokes[stroke] = true
	return stroke
end

local function label(parent, properties)
	local props = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Style.Font,
		TextSize = Style.FontSize,
		TextColor3 = Style.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for key, value in pairs(properties) do
		props[key] = value
	end
	local instance = create("TextLabel", props, parent)
	ThemedText[instance] = true
	return instance
end

local function setStyleValues(values)
	for key, value in pairs(values) do
		local current = Style[key]
		if type(current) == "table" and type(value) == "table" then
			current[1], current[2] = value[1], value[2]
		elseif current ~= nil and type(current) ~= "table" and type(value) ~= "table" then
			Style[key] = value
		end
	end
end

local function applyStyle(style)
	if type(style) == "string" then
		local preset = Themes[style]
		if not preset then return end
		setStyleValues(Themes.Dark)
		if style ~= "Dark" then setStyleValues(preset) end
	elseif type(style) == "table" then
		setStyleValues(style)
	else
		return
	end
	for instance, key in pairs(Themed) do
		if instance.Parent and instance.BackgroundTransparency < 0.999 then
			local pair = Style[key]
			instance.BackgroundColor3 = pair[1]
			instance.BackgroundTransparency = pair[2]
		end
	end
	for instance in pairs(ThemedText) do
		if instance.Parent then instance.TextColor3 = Style.Text end
	end
	for stroke in pairs(Strokes) do
		if stroke.Parent then
			stroke.Color = Style.Border[1]
			stroke.Transparency = Style.Border[2]
		end
	end
	for _, fn in ipairs(Restylers) do pcall(fn) end
end

local function dimTree(root, dim)
	local function apply(instance)
		if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
			and instance.Name ~= "__blocker" then
			instance.TextTransparency = dim and 0.5 or 0
		end
	end
	apply(root)
	for _, descendant in ipairs(root:GetDescendants()) do apply(descendant) end
end

local function fmt(n)
	if n == math.floor(n) then return tostring(n) end
	local s = string.format("%.3f", n)
	s = s:gsub("0+$", "")
	s = s:gsub("%.$", "")
	return s
end

-- Simple signal: constructor callback + extra listeners (api:OnChanged returns a connection)
local function newSignal(callback)
	local sig = {Listeners = {}}
	function sig:Fire(...)
		if callback then pcall(callback, ...) end
		for _, fn in ipairs({table.unpack(self.Listeners)}) do pcall(fn, ...) end
	end
	function sig:Connect(fn)
		table.insert(self.Listeners, fn)
		return {
			Disconnect = function()
				local index = table.find(sig.Listeners, fn)
				if index then table.remove(sig.Listeners, index) end
			end,
		}
	end
	return sig
end

-- Mouse coordinates and GUI coordinates can differ vertically (top-bar inset) depending on the
-- executor / Roblox version. Instead of guessing, learn the shift from a press on a small element:
-- whichever candidate shift puts the click inside that element is the right one.
-- Only used for color-picker drag math. Popups use hover state, not coordinates.
local DEBUG = false
local yShift = 0

local function calibrate(input, guiObject)
	local py = input.Position.Y
	local top = guiObject.AbsolutePosition.Y
	local bottom = top + guiObject.AbsoluteSize.Y
	local inset = GuiService:GetGuiInset().Y
	local diff = UserInputService:GetMouseLocation().Y - py
	for _, shift in ipairs({0, diff, -diff, inset, -inset}) do
		local y = py + shift
		if y >= top and y <= bottom then
			yShift = shift
			if DEBUG then print("[ImGuiLib] y shift =", shift) end
			return
		end
	end
end

local function inputPoint(input)
	return Vector2.new(input.Position.X, input.Position.Y + yShift)
end

local function placeLine(frame, a, b, thickness)
	local delta = b - a
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	frame.Size = UDim2.fromOffset(delta.Magnitude + thickness * 0.5, thickness)
	frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
end

local function drawLine(parent, a, b, thickness, color)
	local frame = create("Frame", {BackgroundColor3 = color, BorderSizePixel = 0}, parent)
	placeLine(frame, a, b, thickness)
	return frame
end

local function toHex(color, alpha)
	local text = string.format("#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
	if alpha then
		text = text .. string.format("%02X", math.floor(alpha * 255 + 0.5))
	end
	return text
end

-- returns Color3, alpha (alpha is nil for 3/6 digit hex)
local function fromHex(text)
	local hex = tostring(text):gsub("^%s*#?", ""):gsub("%s*$", "")
	if #hex == 3 then
		hex = hex:gsub(".", function(c) return c .. c end)
	end
	if not (hex:match("^%x%x%x%x%x%x$") or hex:match("^%x%x%x%x%x%x%x%x$")) then return nil end
	local color = Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16)
	)
	local alpha = #hex == 8 and tonumber(hex:sub(7, 8), 16) / 255 or nil
	return color, alpha
end

-- // Config (de)serialisation helpers
local function encode(value)
	local kind = typeof(value)
	if kind == "Color3" then
		return {__t = "Color3", r = value.R, g = value.G, b = value.B}
	elseif kind == "EnumItem" then
		return {__t = "Enum", name = value.Name}
	elseif kind == "table" then
		local out = {}
		for key, inner in pairs(value) do out[key] = encode(inner) end
		return out
	end
	return value
end

local function decode(value)
	if type(value) ~= "table" then return value end
	if value.__t == "Color3" then
		return Color3.new(value.r, value.g, value.b)
	elseif value.__t == "Enum" then
		return Enum.KeyCode[value.name]
	end
	local out = {}
	for key, inner in pairs(value) do out[key] = decode(inner) end
	return out
end

