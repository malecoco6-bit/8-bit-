            -- slider (with - and + ends, value drawn at the end of the fill)
            function Section:AddSlider(text, min, max, default, callback, fmt, step)
                callback = callback or function() end
                step = step or 1
                local function snap(x)
                    x = math.clamp(x, min, max)
                    x = math.floor((x - min) / step + 0.5) * step + min
                    x = math.floor(x * 1000 + 0.5) / 1000
                    return math.clamp(x, min, max)
                end
                local value = snap(default or min)

                local holder2 = row(30)
                local lbl = label(holder2, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 12),
