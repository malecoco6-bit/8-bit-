function Library:SetFontFile(regularFile, boldFile)
    regularFile = regularFile or Library.FontFile
    boldFile = boldFile or Library.FontFileBold
    if not (isfile and writefile and getcustomasset and isfile(regularFile)) then
        return false
    end
    local ok = pcall(function()
        local faces = {
            { name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(regularFile) },
        }
        if boldFile and isfile(boldFile) then
            faces[#faces + 1] = { name = "Bold", weight = 700, style = "normal", assetId = getcustomasset(boldFile) }
        end
        local fam = "gamesense_verdana.json"
        writefile(fam, HttpService:JSONEncode({ name = "Verdana", faces = faces }))
        Library.FontFace = Font.new(getcustomasset(fam), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
        Library.FontFaceBold = Font.new(getcustomasset(fam), Enum.FontWeight.Bold, Enum.FontStyle.Normal)
    end)
    return ok and Library.FontFace ~= nil
end

local function getHttpFn()
    return (syn and syn.request)
        or http_request
        or request
        or (fluxus and fluxus.request)
        or function(opts)
            return { Body = game:HttpGet(opts.Url), StatusCode = 200 }
        end
end

function Library:EnsureFont(urls)
    urls = urls or Library.FontURLs
    if not (writefile and isfile and getcustomasset) then
        return false
    end
    if Library.FontFace then
        return true
    end

    local function ensureFile(path, url)
        if isfile(path) then return true end
        local httpFn = getHttpFn()
        local ok, res = pcall(httpFn, { Url = url, Method = "GET" })
        if not ok or not res or not res.Body or #res.Body < 100 then
            return false
        end
        local okWrite = pcall(writefile, path, res.Body)
        return okWrite and isfile(path)
    end

    local regOk = ensureFile(Library.FontFile, urls.Regular)
    if not regOk then
        return false
    end
    local boldOk = urls.Bold and ensureFile(Library.FontFileBold, urls.Bold)

    return Library:SetFontFile(Library.FontFile, boldOk and Library.FontFileBold or nil)
end

