local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function emitter()
    local listeners = {}
    local function connect(fn) listeners[#listeners + 1] = fn end
    local function fire(...)
        for _, fn in ipairs(listeners) do task.spawn(fn, ...) end
    end
    return connect, fire
end

local function makeDraggable(handle, target, track, scaler)
    track = track or function(c) return c end
    local dragging, dragStart, startPos
    track(handle.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and isMove(input) then
            local d = (input.Position - dragStart) / ((scaler and scaler.Scale) or 1)
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if isPress(input) then dragging = false end
    end))
end

