-- 1 headshot, 2 crosshair, 3 visuals (sun), 4 gear, 5 karambit, 6 config
-- Tabs automatically use these in order (1st tab = 1st icon, ...).
local ICONS = { "110384580770025", "8547249956", "8547254518", "8547256547", "8547258459", "98519046048197" }
Library.Icons = ICONS

local ICON_NAMES = {
    headshot = 1, rage = 1,
    crosshair = 2, legit = 2,
    visuals = 3, sun = 3,
    gear = 4, settings = 4, misc = 4,
    karambit = 5, knife = 5, skins = 5,
    config = 6, save = 6,
}
Library.IconNames = ICON_NAMES

local function resolveIcon(icon)
    if type(icon) == "string" and ICON_NAMES[icon:lower()] then
        icon = ICON_NAMES[icon:lower()]
    end
    if type(icon) == "number" and ICONS[icon] then
        icon = ICONS[icon]
    end
    if icon == nil then return nil end
    icon = tostring(icon)
    if icon:match("^%d+$") then
        icon = "rbxassetid://" .. icon
    end
    return icon
end

