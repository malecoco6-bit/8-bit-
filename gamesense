                        update(i.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and isMove(i) then update(i.Position.X) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if isPress(i) then dragging = false end
                end)
