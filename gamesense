            local function row(h)
                return new("Frame", {
                    Size = UDim2.new(1, 0, 0, h),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    ZIndex = 7,
                    Parent = items,
                })
            end
            local INDENT = 19
            local RESERVE = 46

            local function reg(kind, text, obj)
                if name == "Config" and secName ~= "Menu" then return end
                register(name .. "/" .. secName .. "/" .. text, kind, obj)
            end

            local function vis(obj, frame)
                obj.Row = frame
                function obj:SetVisible(v) frame.Visible = v and true or false end

                local tipRec
                function obj:SetTooltip(t)
                    tipRec = tipRec or ctx.addTip(frame)
                    tipRec.Text = t
                    return obj
                end

                function obj:DependsOn(other, expected)
                    if expected == nil then expected = true end
                    local function check()
                        local val = other:Get()
                        local ok
                        if type(expected) == "function" then ok = expected(val) else ok = (val == expected) end
                        frame.Visible = ok and true or false
                    end
                    if other.OnChanged then other:OnChanged(check) end
                    check()
                    return obj
                end
                return obj
            end

            function Section:AddToggle(text, default, callback)
                callback = callback or function() end
                local state = default and true or false
                local onChanged, fire = emitter()
                local r = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    LayoutOrder = nextOrder(),
                    ZIndex = 7,
                    Parent = items,
                })
                local check = new("Frame", {
                    Size = UDim2.fromOffset(8, 8),
                    Position = UDim2.fromOffset(0, 4),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(check, Theme.Outline, 1)
                local cg = new("UIGradient", { Rotation = 90, Parent = check })

                local lblColor = Theme.Text
                local lbl = label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rbox = rightBox(r)
                rbox.ZIndex = 8

                local function paint()
                    local c = state and Theme.Accent or Theme.CheckOff
                    cg.Color = ColorSequence.new(c, shade(c, state and 0.55 or 0.6))
                end
                paint()
                onAccent(paint)

                r.MouseEnter:Connect(function() lbl.TextColor3 = Color3.new(1, 1, 1) end)
                r.MouseLeave:Connect(function() lbl.TextColor3 = lblColor end)

                local obj = {}
                function obj:Set(v)
                    state = v and true or false
                    paint()
                    task.spawn(callback, state)
                    fire(state)
                end
                function obj:Get() return state end
                function obj:Toggle() obj:Set(not state) end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetText(t) lbl.Text = t end
                function obj:SetTextColor(c) lblColor = c lbl.TextColor3 = c end
                function obj:AddKeybind(key, mode, cb)
                    local k = makeKeybind(rbox, key, mode, cb, ctx, text)
                    reg("keybind", text .. " key", k)
                    return k
                end
                function obj:AddColorPicker(color, alpha, cb)
                    local c = makeColorPicker(rbox, color, alpha, cb, ctx)
                    reg("color", text .. " colour", c)
                    return c
                end
                r.MouseButton1Click:Connect(function() obj:Set(not state) end)
                reg("toggle", text, obj)
                return vis(obj, r)
            end

            function Section:AddSlider(text, min, max, default, callback, fmt, step)
                callback = callback or function() end
                step = step or 1
                local onChanged, fire = emitter()
                local function snap(x)
                    x = math.clamp(x, min, max)
                    x = math.floor((x - min) / step + 0.5) * step + min
                    x = math.floor(x * 1000 + 0.5) / 1000
                    return math.clamp(x, min, max)
                end
                local value = snap(default or min)

                local holder2 = row(30)
                local lbl = label(holder2, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 12),
                    ZIndex = 8,
                })
                local bar = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT, 17),
                    Size = UDim2.new(1, -RESERVE, 0, 6),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                    Parent = holder2,
                })
                stroke(bar, Theme.Outline, 1)
                new("UIGradient", {
                    Color = ColorSequence.new(Color3.fromRGB(34, 34, 34), Color3.fromRGB(24, 24, 24)),
                    Rotation = 90,
                    Parent = bar,
                })
                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    Parent = bar,
                })
                local fillGrad = new("UIGradient", { Rotation = 90, Parent = fill })
                local function paintFill()
                    fillGrad.Color = ColorSequence.new(Theme.Accent, shade(Theme.Accent, 0.55))
                end
                paintFill()
                onAccent(paintFill)

                local valueLabel = label(bar, "", {
                    NoShadow = true,
                    AutomaticSize = Enum.AutomaticSize.X,
                    Size = UDim2.fromOffset(0, 12),
                    Font = Theme.FontBold,
                    TextSize = 11,
                    TextColor3 = Color3.new(1, 1, 1),
                    TextStrokeTransparency = 0,
                    TextStrokeColor3 = Color3.new(0, 0, 0),
                    ZIndex = 10,
                })
                local minus = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT - 8, 12),
                    Size = UDim2.fromOffset(8, 12),
                    BackgroundTransparency = 1,
                    Text = "-",
                    TextColor3 = Theme.TextDim,
                    Font = Theme.Font,
                    TextSize = 11,
                    ZIndex = 8,
                    Parent = holder2,
                })
                local plus = new("TextButton", {
                    Position = UDim2.new(1, -(RESERVE - INDENT) + 3, 0, 12),
                    Size = UDim2.fromOffset(8, 12),
                    BackgroundTransparency = 1,
                    Text = "+",
                    TextColor3 = Theme.TextDim,
                    Font = Theme.Font,
                    TextSize = 11,
                    ZIndex = 8,
                    Parent = holder2,
                })

                local function format(x)
                    if type(fmt) == "function" then return tostring(fmt(x)) end
                    return tostring(x) .. (fmt or "")
                end
                local obj = {}
                local function render()
                    local a = (max == min) and 0 or (value - min) / (max - min)
                    fill.Size = UDim2.new(a, 0, 1, 0)
                    valueLabel.AnchorPoint = Vector2.new(a, 0)
                    valueLabel.Position = UDim2.new(a, 0, 0, 0)
                    valueLabel.Text = format(value)
                end
                function obj:Set(x)
                    value = snap(x)
                    render()
                    task.spawn(callback, value)
                    fire(value)
                end
                function obj:Get() return value end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetText(t) lbl.Text = t end
                render()

                minus.MouseButton1Click:Connect(function() obj:Set(value - step) end)
                plus.MouseButton1Click:Connect(function() obj:Set(value + step) end)

                local dragging = false
                local function update(x)
                    local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    obj:Set(min + (max - min) * a)
                end
                bar.InputBegan:Connect(function(i)
                    if isPress(i) then
                        dragging = true
                        update(i.Position.X)
                    end
                end)
                track(UserInputService.InputChanged:Connect(function(i)
                    if dragging and isMove(i) then update(i.Position.X) end
                end))
                track(UserInputService.InputEnded:Connect(function(i)
                    if isPress(i) then dragging = false end
                end))
                reg("slider", text, obj)
                return vis(obj, holder2)
            end

            function Section:AddDropdown(text, options, default, callback, multi)
                callback = callback or function() end
                options = options or {}
                local onChanged, fire = emitter()
                local selectedValue
                if multi then
                    selectedValue = {}
                    if type(default) == "table" then
                        for _, o in ipairs(default) do selectedValue[o] = true end
                    end
                else
                    selectedValue = default or options[1]
                end

                local ROW, MAXROWS = 16, 10
                local holder2 = row(34)
                label(holder2, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 12),
                    ZIndex = 8,
                })
                local head = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT, 15),
                    Size = UDim2.new(1, -RESERVE, 0, 18),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                    Parent = holder2,
                })
                stroke(head, Theme.Outline, 1)
                shine(head, 200)
                local cur = label(head, "", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.fromOffset(6, 0),
                    TextColor3 = Theme.TextDim,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 9,
                })
                label(head, "▼", {
                    Size = UDim2.fromOffset(14, 18),
                    Position = UDim2.new(1, -16, 0, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextColor3 = Theme.TextDim,
                    TextSize = 10,
                    ZIndex = 9,
                })

                local list = makePanel(ctx, 100, 0)
                local scroll = new("ScrollingFrame", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Theme.ScrollBar,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    Parent = list,
                })
                new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
                new("UIPadding", { PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 1), Parent = scroll })

                local buttons = {}
                local obj = {}
                local function isOn(o)
                    if multi then return selectedValue[o] == true end
                    return selectedValue == o
                end
                local function refresh()
                    if multi then
                        local t = {}
                        for _, o in ipairs(options) do
                            if selectedValue[o] then t[#t + 1] = tostring(o) end
                        end
                        cur.Text = (#t > 0) and table.concat(t, ", ") or "-"
                    else
                        cur.Text = (selectedValue ~= nil) and tostring(selectedValue) or "-"
                    end
                    for o, b in pairs(buttons) do
                        b.TextColor3 = isOn(o) and Color3.new(1, 1, 1) or Theme.TextDim
                        b.Font = isOn(o) and Theme.FontBold or Theme.Font
                    end
                end
                local function build()
                    for _, b in pairs(buttons) do b:Destroy() end
                    table.clear(buttons)
                    for i, opt in ipairs(options) do
                        local b = new("TextButton", {
                            LayoutOrder = i,
                            Size = UDim2.new(1, 0, 0, ROW),
                            BackgroundTransparency = 1,
                            Text = "  " .. tostring(opt),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextColor3 = Theme.TextDim,
                            Font = Theme.Font,
                            TextSize = Theme.TextSize,
                            Parent = scroll,
                        })
                        buttons[opt] = b
                        b.MouseEnter:Connect(function() b.TextColor3 = Color3.new(1, 1, 1) end)
                        b.MouseLeave:Connect(function()
                            b.TextColor3 = isOn(opt) and Color3.new(1, 1, 1) or Theme.TextDim
                        end)
                        b.MouseButton1Click:Connect(function()
                            if multi then
                                selectedValue[opt] = (not selectedValue[opt]) or nil
                                refresh()
                                task.spawn(callback, selectedValue)
                                fire(selectedValue)
                            else
                                obj:Set(opt)
                                closePopup()
                            end
                        end)
                    end
                    refresh()
                end

                function obj:Set(v)
                    if multi then
                        selectedValue = {}
                        if type(v) == "table" then
                            for _, o in ipairs(v) do selectedValue[o] = true end
                        end
                    else
                        selectedValue = v
                    end
                    refresh()
                    task.spawn(callback, selectedValue)
                    fire(selectedValue)
                end
                function obj:Get() return selectedValue end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetOptions(newOptions)
                    options = newOptions or {}
                    if multi then
                        for k in pairs(selectedValue) do
                            if not table.find(options, k) then selectedValue[k] = nil end
                        end
                    elseif not table.find(options, selectedValue) then
                        selectedValue = options[1]
                    end
                    build()
                end

                head.MouseButton1Click:Connect(function()
                    local w = head.AbsoluteSize.X
                    local h = math.min(#options, MAXROWS) * ROW + 2
                    list.Size = UDim2.fromOffset(w, h)
                    ctx.place(list, head, w, h)
                    openPopup(list)
                end)
                build()
                reg(multi and "multi" or "dropdown", text, obj)
                return vis(obj, holder2)
            end

