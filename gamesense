local MODES = {
    { "Always on", "Always" },
    { "On hotkey", "Hold" },
    { "Toggle", "Toggle" },
    { "Off hotkey", "Off" },
}

local function keyText(k)
    if not k then return "[-]" end
    local n = k.Name
    if k == Enum.UserInputType.MouseButton2 then n = "M2" end
    if k == Enum.UserInputType.MouseButton3 then n = "M3" end
    return "[" .. n .. "]"
end

local function makeKeybind(container, key, mode, callback, ctx, name)
    callback = callback or function() end
    mode = mode or "Hold"
    local listening = false
    local active = (mode == "Always") or (mode == "Off")
    local obj = { Instance = nil }

    local btn = new("TextButton", {
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, 12),
        BackgroundTransparency = 1,
        Text = keyText(key),
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        AutoButtonColor = false,
        LayoutOrder = #container:GetChildren(),
        Parent = container,
    })
    obj.Instance = btn

    local function changed()
        if ctx.refreshKeybinds then ctx.refreshKeybinds() end
    end

    local function setActive(v)
        if v ~= active then
            active = v
            task.spawn(callback, active)
        end
        changed()
    end

    local PW, PH = 84, #MODES * 16 + 2
    local pop = makePanel(ctx, PW, PH)
    local modeButtons = {}
    local function refreshModes()
        for m, b in pairs(modeButtons) do
            b.TextColor3 = (m == mode) and Theme.Text or Theme.TextDim
            b.Font = (m == mode) and Theme.FontBold or Theme.Font
        end
    end
    for i, m in ipairs(MODES) do
        local b = new("TextButton", {
            Position = UDim2.fromOffset(0, (i - 1) * 16 + 1),
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text = "  " .. m[1],
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = Theme.TextDim,
            Font = Theme.Font,
            TextSize = 11,
            Parent = pop,
        })
        modeButtons[m[2]] = b
        b.MouseButton1Click:Connect(function()
            mode = m[2]
            if mode == "Always" or mode == "Off" then setActive(true) else setActive(false) end
            refreshModes()
            changed()
            ctx.close()
        end)
    end
    refreshModes()

    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "[...]"
        btn.TextColor3 = Theme.Accent
    end)
    btn.MouseButton2Click:Connect(function()
        ctx.place(pop, btn, PW, PH)
        ctx.open(pop)
    end)

    ctx.track(UserInputService.InputBegan:Connect(function(input, gp)
        if listening then
            local k
            if input.UserInputType == Enum.UserInputType.Keyboard then
                k = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                k = input.UserInputType
            end
            if k then
                listening = false
                key = (k ~= Enum.KeyCode.Escape) and k or nil
                btn.Text = keyText(key)
                btn.TextColor3 = Theme.TextDim
                if obj.KeyChanged then obj.KeyChanged(key) end
                changed() -- refresh the keybind list immediately
            end
            return
        end
        if gp or not key then return end
        if input.KeyCode == key or input.UserInputType == key then
            if mode == "Hold" then setActive(true)
            elseif mode == "Toggle" then setActive(not active)
            elseif mode == "Off" then setActive(false) end
        end
    end))
    ctx.track(UserInputService.InputEnded:Connect(function(input)
        if not key then return end
        if input.KeyCode == key or input.UserInputType == key then
            if mode == "Hold" then setActive(false)
            elseif mode == "Off" then setActive(true) end
        end
    end))

    function obj:Get() return active end
    function obj:SetActive(v) setActive(v) end
    function obj:GetKey() return key end
    function obj:SetKey(k)
        key = k
        btn.Text = keyText(key)
        if obj.KeyChanged then obj.KeyChanged(key) end
    end
    function obj:GetMode() return mode end
    function obj:SetMode(m) mode = m refreshModes() changed() end
    function obj:SetVisible(v) btn.Visible = v end

    if name and ctx.addKeybind then ctx.addKeybind(name, obj) end
    return obj
end

local function makeColorPicker(container, default, hasAlpha, callback, ctx)
