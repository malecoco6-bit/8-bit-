                        cur.Text = (selectedValue ~= nil) and tostring(selectedValue) or "-"
                    end
                    for o, b in pairs(buttons) do
                        b.TextColor3 = isOn(o) and Color3.new(1, 1, 1) or Theme.TextDim
                        b.Font = isOn(o) and Theme.FontBold or Theme.Font
                    end
                end
                local function build()
                    for _, b in pairs(buttons) do b:Destroy() end
                    table.clear(buttons)
                    for i, opt in ipairs(options) do
                        local b = new("TextButton", {
                            LayoutOrder = i,
                            Size = UDim2.new(1, 0, 0, ROW),
                            BackgroundTransparency = 1,
                            Text = "  " .. tostring(opt),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextColor3 = Theme.TextDim,
                            Font = Theme.Font,
                            TextSize = Theme.TextSize,
                            Parent = scroll,
                        })
                        buttons[opt] = b
                        b.MouseEnter:Connect(function() b.TextColor3 = Color3.new(1, 1, 1) end)
                        b.MouseLeave:Connect(function()
                            b.TextColor3 = isOn(opt) and Color3.new(1, 1, 1) or Theme.TextDim
                        end)
                        b.MouseButton1Click:Connect(function()
                            if multi then
                                selectedValue[opt] = (not selectedValue[opt]) or nil
                                refresh()
                                task.spawn(callback, selectedValue)
                                fire(selectedValue)
                            else
                                obj:Set(opt)
                                closePopup()
                            end
                        end)
                    end
                    refresh()
                end

                function obj:Set(v)
                    if multi then
                        selectedValue = {}
                        if type(v) == "table" then
                            for _, o in ipairs(v) do selectedValue[o] = true end
                        end
                    else
                        selectedValue = v
                    end
                    refresh()
                    task.spawn(callback, selectedValue)
                    fire(selectedValue)
                end
                function obj:Get() return selectedValue end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetOptions(newOptions)
                    options = newOptions or {}
                    if multi then
                        for k in pairs(selectedValue) do
                            if not table.find(options, k) then selectedValue[k] = nil end
                        end
                    elseif not table.find(options, selectedValue) then
                        selectedValue = options[1]
                    end
                    build()
                end

                head.MouseButton1Click:Connect(function()
                    local w = head.AbsoluteSize.X
                    local h = math.min(#options, MAXROWS) * ROW + 2
                    list.Size = UDim2.fromOffset(w, h)
                    ctx.place(list, head, w, h)
                    openPopup(list)
                end)
                build()
                reg(multi and "multi" or "dropdown", text, obj)
                return vis(obj, holder2)
            end

            function Section:AddMultiDropdown(text, options, default, callback)
                return Section:AddDropdown(text, options, default, callback, true)
            end

            function Section:AddListbox(text, options, default, callback, rows, multi)
                callback = callback or function() end
                options = options or {}
                rows = rows or 6
                local ROW = LIST_ROW_H
                local hasLabel = text ~= nil and text ~= ""
                local top = hasLabel and 15 or 2
                local onChanged, fire = emitter()
                local selectedValue
                if multi then
                    selectedValue = {}
                    if type(default) == "table" then
                        for _, o in ipairs(default) do selectedValue[o] = true end
                    end
                else
                    selectedValue = default
                end

                local holder2 = row(top + rows * ROW + 4)
                if hasLabel then
                    label(holder2, text, {
                        Position = UDim2.fromOffset(INDENT, 0),
                        Size = UDim2.new(1, -RESERVE, 0, 12),
                        ZIndex = 8,
                    })
                end
                local box = new("Frame", {
                    Position = UDim2.fromOffset(INDENT, top),
                    Size = UDim2.new(1, -INDENT, 0, rows * ROW + 2),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = holder2,
                })
                stroke(box, Theme.Outline, 1, Theme.OutlineTransparency)
                shine(box, 200)
                local scroll = new("ScrollingFrame", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Theme.ScrollBar,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 9,
                    Parent = box,
                })
                new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
                new("UIPadding", { PaddingTop = UDim.new(0, 1), Parent = scroll })

                local buttons = {}
                local obj = {}
                local function isOn(o)
                    if multi then return selectedValue[o] == true end
                    return selectedValue == o
                end
                local function refresh()
                    for o, b in pairs(buttons) do
                        local on = isOn(o)
                        b.TextColor3 = on and Theme.Accent or Theme.TextDim
                        b.Font = on and Theme.FontBold or Theme.Font
                        b.BackgroundTransparency = on and 0 or 1
                        local bar = b:FindFirstChild("Bar")
                        if bar then
                            bar.Visible = on
                            bar.BackgroundColor3 = Theme.Accent
                        end
                    end
                end
                onAccent(refresh)
                local function build()
                    for _, b in pairs(buttons) do b:Destroy() end
                    table.clear(buttons)
                    for i, opt in ipairs(options) do
                        local b = new("TextButton", {
                            LayoutOrder = i,
                            Size = UDim2.new(1, -4, 0, ROW),
                            BackgroundColor3 = Theme.Element,
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                            Text = "  " .. tostring(opt),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextColor3 = Theme.TextDim,
                            Font = Theme.Font,
                            TextSize = Theme.TextSize,
                            AutoButtonColor = false,
                            ZIndex = 10,
                            Parent = scroll,
                        })
                        new("Frame", {
                            Name = "Bar",
                            Size = UDim2.new(0, 2, 1, 0),
                            BackgroundColor3 = Theme.Accent,
                            BorderSizePixel = 0,
                            Visible = false,
                            ZIndex = 11,
                            Parent = b,
                        })
                        buttons[opt] = b
                        b.MouseEnter:Connect(function()
                            if not isOn(opt) then b.TextColor3 = Color3.new(1, 1, 1) end
                        end)
                        b.MouseLeave:Connect(function()
                            b.TextColor3 = isOn(opt) and Theme.Accent or Theme.TextDim
                        end)
                        b.MouseButton1Click:Connect(function()
                            if multi then
                                selectedValue[opt] = (not selectedValue[opt]) or nil
                                refresh()
                                task.spawn(callback, selectedValue)
                                fire(selectedValue)
                            else
                                obj:Set(opt)
                            end
                        end)
                    end
                    refresh()
                end
                function obj:Set(v)
                    if multi then
                        selectedValue = {}
                        if type(v) == "table" then
                            for _, o in ipairs(v) do selectedValue[o] = true end
                        end
                    else
                        selectedValue = v
                    end
                    refresh()
                    task.spawn(callback, selectedValue)
                    fire(selectedValue)
                end
                function obj:Get() return selectedValue end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetOptions(newOptions)
                    options = newOptions or {}
                    build()
                end
                function obj:Filter(q)
                    q = tostring(q or ""):lower()
                    for opt, b in pairs(buttons) do
                        b.Visible = (q == "") or (tostring(opt):lower():find(q, 1, true) ~= nil)
                    end
                end
                build()
                reg(multi and "multilist" or "listbox", text, obj)
                return vis(obj, holder2)
            end

            function Section:AddKeybind(text, key, mode, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rbox = rightBox(r)
                rbox.ZIndex = 8
                local obj = makeKeybind(rbox, key, mode, callback, ctx, text)
                reg("keybind", text, obj)
                return vis(obj, r)
            end

            function Section:AddColorPicker(text, color, alpha, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rbox = rightBox(r)
                rbox.ZIndex = 8
                local obj = makeColorPicker(rbox, color, alpha, callback, ctx)
                reg("color", text, obj)
                return vis(obj, r)
            end

            function Section:AddButton(text, callback)
                callback = callback or function() end
                local r = row(BUTTON_H + BUTTON_GAP)
                local b = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -INDENT, 0, BUTTON_H),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(b, Theme.Outline, 1, Theme.OutlineTransparency)
                shine(b, 200)
                local bl = label(b, text, {
                    Size = UDim2.fromScale(1, 1),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                })
                b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(44, 44, 44) end)
                b.MouseLeave:Connect(function() b.BackgroundColor3 = Theme.Element end)
                b.MouseButton1Click:Connect(function() task.spawn(callback) end)

                local obj = { Instance = b }
                function obj:SetText(t) bl.Text = t end
                return vis(obj, r)
            end

            function Section:AddLabel(text)
                local r = row(14)
                local l = label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    TextColor3 = Theme.TextDim,
                    ZIndex = 8,
                })
                local rbox
                local obj = { Instance = l }
                function obj:Set(t) l.Text = t end
                function obj:SetColor(c) l.TextColor3 = c end
                function obj:AddColorPicker(color, alpha, cb)
                    rbox = rbox or rightBox(r)
                    rbox.ZIndex = 8
                    local c = makeColorPicker(rbox, color, alpha, cb, ctx)
                    reg("color", text .. " colour", c)
                    return c
                end
                function obj:AddKeybind(key, mode, cb)
                    rbox = rbox or rightBox(r)
                    rbox.ZIndex = 8
                    local k = makeKeybind(rbox, key, mode, cb, ctx, text)
                    reg("keybind", text .. " key", k)
                    return k
                end
                return vis(obj, r)
            end

            function Section:AddInfo(text)
                local r = new("Frame", {
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    ZIndex = 7,
                    Parent = items,
                })
                local l = label(r, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    TextWrapped = true,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    TextColor3 = Theme.TextDim,
                    ZIndex = 8,
                })
                local obj = { Instance = l }
                function obj:Set(t) l.Text = t end
                function obj:SetColor(c) l.TextColor3 = c end
                return vis(obj, r)
            end

            -- text = "" gives a label-less box (search style). live = true fires the callback
            -- on every keystroke and adds a small magnifying glass on the right.
            -- The box ends at the same right edge as the buttons and the listbox.
            function Section:AddTextbox(text, default, callback, live)
                callback = callback or function() end
                local hasLabel = text ~= nil and text ~= ""
                local GAP = hasLabel and 3 or 2
                local TOP = hasLabel and 14 or 2

                local r = row(TOP + TEXTBOX_H + GAP)
                if hasLabel then
                    label(r, text, {
                        Position = UDim2.fromOffset(INDENT, 0),
                        Size = UDim2.new(1, -RESERVE, 0, 12),
                        ZIndex = 8,
                    })
                end
                local tb = new("TextBox", {
                    Position = UDim2.fromOffset(INDENT, TOP),
                    Size = UDim2.new(1, -RESERVE, 0, TEXTBOX_H),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = default or "",
                    PlaceholderText = "...",
                    PlaceholderColor3 = Theme.TextDim,
                    TextColor3 = Theme.Text,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(tb, Theme.Outline, 1, Theme.OutlineTransparency)
                shine(tb, 200)
                new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 18), Parent = tb })

                if live then
                    tb:GetPropertyChangedSignal("Text"):Connect(function() task.spawn(callback, tb.Text) end)

                    local ico = new("Frame", {
                        Name = "SearchIcon",
                        Size = UDim2.fromOffset(6, 6),
                        Position = UDim2.new(1, -13, 0, TOP + math.floor((TEXTBOX_H - 6) / 2)),
                        BackgroundTransparency = 1,
                        ZIndex = 9,
                        Parent = r,
                    })
                    local lens = new("Frame", {
                        Size = UDim2.fromOffset(4, 4),
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        ZIndex = 9,
                        Parent = ico,
                    })
                    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = lens })
                    local lensStroke = stroke(lens, Theme.TextDim, 1)
                    local handle = new("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromOffset(5, 5),
                        Size = UDim2.fromOffset(1, 2),
                        Rotation = -45,
                        BackgroundColor3 = Theme.TextDim,
                        BorderSizePixel = 0,
                        ZIndex = 9,
                        Parent = ico,
                    })
                    tb:GetPropertyChangedSignal("Text"):Connect(function()
                        local c = (tb.Text ~= "") and Theme.Text or Theme.TextDim
                        lensStroke.Color = c
                        handle.BackgroundColor3 = c
                    end)
                else
                    tb.FocusLost:Connect(function() task.spawn(callback, tb.Text) end)
                end

                local obj = { Instance = tb }
                function obj:Get() return tb.Text end
                function obj:Set(t)
                    tb.Text = tostring(t or "")
                    if not live then task.spawn(callback, tb.Text) end
                end
                if hasLabel then reg("textbox", text, obj) end
                return vis(obj, r)
            end

            function Section:AddSeparator()
                local r = row(8)
                new("Frame", {
                    Position = UDim2.new(0, INDENT, 0.5, 0),
                    Size = UDim2.new(1, -INDENT, 0, 1),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = r,
                })
                return vis({}, r)
            end

            function Section:AddSpacer(h)
                return vis({}, row(h or 8))
            end

            return Section
        end

        -- ───────── categories ─────────
        local categories = {}

        local CAT_IDLE = Theme.TabIcon
        local CAT_SIZE = 30

        local function selectCategory(c)
            for _, o in ipairs(categories) do
                local on = (o == c)
                o.Pane.frame.Visible = on
                o.Tint(on and Theme.TabIconSelected or CAT_IDLE)
            end
            Tab.ActiveCategory = c
            closePopup()
        end

        function Tab:AddCategory(catName, catIcon)
            if #categories == 0 then
                defaultPane.frame.Visible = false
                catBar.Visible = true
            end

            local pane = makePane(PANE_TOP)
            pane.frame.Visible = false

            local resolved = resolveIcon(catIcon)
            local cbtn, tint
            if resolved then
                cbtn = new("ImageButton", {
                    Size = UDim2.fromOffset(CAT_SIZE, CAT_SIZE),
                    BackgroundTransparency = 1,
                    Image = resolved,
                    ImageColor3 = CAT_IDLE,
                    AutoButtonColor = false,
                    LayoutOrder = #categories + 1,
                    ZIndex = 7,
                    Parent = catList,
                })
                tint = function(c) cbtn.ImageColor3 = c end
            else
                cbtn = new("TextButton", {
                    AutomaticSize = Enum.AutomaticSize.X,
                    Size = UDim2.fromOffset(0, CAT_SIZE),
                    BackgroundTransparency = 1,
                    Text = catName,
                    TextColor3 = CAT_IDLE,
                    Font = Theme.FontBold,
                    TextSize = Theme.TextSize,
                    AutoButtonColor = false,
                    LayoutOrder = #categories + 1,
                    ZIndex = 7,
                    Parent = catList,
                })
                tint = function(c) cbtn.TextColor3 = c end
            end

            ctx.addTip(cbtn).Text = catName

            local Category = { Name = catName, Pane = pane, Button = cbtn, Tint = tint }
            function Category:AddSection(secName, side, height)
                return buildSection(pane, catName, secName, side, height)
            end
            function Category:Select() selectCategory(Category) end

            cbtn.MouseEnter:Connect(function()
                if Tab.ActiveCategory ~= Category then tint(Theme.TabIconHover) end
            end)
            cbtn.MouseLeave:Connect(function()
                if Tab.ActiveCategory ~= Category then tint(CAT_IDLE) end
            end)
            cbtn.MouseButton1Click:Connect(function() selectCategory(Category) end)

            table.insert(categories, Category)
            if #categories == 1 then selectCategory(Category) end
            return Category
        end

        function Tab:SelectCategory(which)
            for i, c in ipairs(categories) do
                if i == which or c.Name == which then
                    selectCategory(c)
                    return true
                end
            end
            return false
        end

        function Tab:AddSection(secName, side, height)
            local target = categories[#categories]
            if target then
                return buildSection(target.Pane, target.Name, secName, side, height)
            end
            return buildSection(defaultPane, nil, secName, side, height)
        end

        return Tab
    end

    function Window:AddConfigTab(opts)
        opts = opts or {}
        local tab = Window:AddTab({ Name = "Config", Icon = opts.Icon or "config" })

        -- ── left: Presets ──
        local presets = tab:AddSection("Presets", "Left")
        local nameBox, list
        local function refreshList() list:SetOptions(Window:ListConfigs()) end
        local function result(ok, msg, good)
            Window:Notify(ok and good or ("Failed: " .. tostring(msg)))
        end

        presets:AddTextbox("", "", function(q) if list then list:Filter(q) end end, true)
            .Instance.PlaceholderText = "Search..."
        list = presets:AddListbox("", Window:ListConfigs(), nil, function(v)
            if nameBox and v then nameBox:Set(v) end
        end, 10)

        presets:AddSpacer(4)
        nameBox = presets:AddTextbox("Config name", "default")

        presets:AddButton("Load", function()
            local n = nameBox:Get()
            local ok, err = Window:LoadConfig(n)
            result(ok, err, "Loaded config " .. n)
        end)
        presets:AddButton("Save", function()
            local n = nameBox:Get()
            local ok, err = Window:SaveConfig(n)
            result(ok, err, "Saved config " .. n)
            refreshList()
        end)
        presets:AddButton("Delete", function()
            local n = nameBox:Get()
            local ok, err = Window:DeleteConfig(n)
            result(ok, err, "Deleted config " .. n)
            refreshList()
        end)
        presets:AddButton("Import from clipboard", function()
            if not getclipboard then
                Window:Notify("Failed: your executor has no getclipboard")
                return
            end
            local ok, err = Window:ImportConfig(getclipboard())
            result(ok, err, "Imported config")
        end)
        presets:AddButton("Export to clipboard", function()
            if setclipboard then
                setclipboard(Window:ExportConfig())
                Window:Notify("Config copied to clipboard")
            else
                Window:Notify("Failed: your executor has no setclipboard")
            end
        end)

        -- ── right: Settings ──
        local settings = tab:AddSection("Settings", "Right")
        settings:AddToggle("Watermark", wmTemplate ~= nil, function(v)
            Window:SetWatermark(v and DEFAULT_WATERMARK or nil)
        end)
        settings:AddToggle("Keybind list", kbEnabled, function(v) Window:SetKeybindList(v) end)
        settings:AddSlider("Menu scale", 50, 150, 100, function(v)
            Window:SetScale(v / 100)
        end, "%", 5)
        settings:AddButton("Clear all binds", function()
            for _, f in pairs(Flags) do
                if f.Kind == "keybind" then pcall(function() f.Obj:SetKey(nil) end) end
            end
            Window:Notify("Cleared all binds")
        end)

        return tab
    end

    if cfg.Watermark then
        Window:SetWatermark(cfg.Watermark == true and DEFAULT_WATERMARK or cfg.Watermark)
    end
    refreshKeybinds()

    return Window
end

return Library
