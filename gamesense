                Parent = items,
            })
            local function resize()
                if fixed then
                    body.Size = UDim2.new(1, 0, 0, height)
                    holder.Size = UDim2.new(1, 0, 0, height + 7)
                    return
                end
                local h = layout.AbsoluteContentSize.Y + 12 + 8
                body.Size = UDim2.new(1, 0, 0, h)
                holder.Size = UDim2.new(1, 0, 0, h + 7)
            end
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
            resize()

            local Section = { Holder = holder }
