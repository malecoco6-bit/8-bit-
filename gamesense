                    TextColor3 = Theme.TextDim,
                    TextSize = 8,
                    ZIndex = 9,
                })

                local list = new("Frame", {
                    Size = UDim2.fromOffset(100, #options * 16 + 2),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Visible = false,
                    Active = true,
                    ZIndex = 2,
                    Parent = popupLayer,
                })
                stroke(list, Theme.Outline, 1)

                local buttons = {}
                local obj = {}
                local function isOn(o)
                    if multi then return selectedValue[o] == true end
                    return selectedValue == o
                end
                local function refresh()
                    if multi then
                        local t = {}
                        for _, o in ipairs(options) do
                            if selectedValue[o] then t[#t + 1] = tostring(o) end
                        end
                        cur.Text = (#t > 0) and table.concat(t, ", ") or "-"
                    else
                        cur.Text = (selectedValue ~= nil) and tostring(selectedValue) or "-"
                    end
                    for o, b in pairs(buttons) do
                        b.TextColor3 = isOn(o) and Color3.new(1, 1, 1) or Theme.TextDim
                        b.Font = isOn(o) and Theme.FontBold or Theme.Font
                    end
                end
                local function build()
                    for _, b in pairs(buttons) do b:Destroy() end
                    table.clear(buttons)
                    for i, opt in ipairs(options) do
                        local b = new("TextButton", {
                            Position = UDim2.fromOffset(0, (i - 1) * 16 + 1),
                            Size = UDim2.new(1, 0, 0, 16),
                            BackgroundTransparency = 1,
                            Text = "  " .. tostring(opt),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextColor3 = Theme.TextDim,
                            Font = Theme.Font,
                            TextSize = Theme.TextSize,
                            Parent = list,
                        })
                        buttons[opt] = b
                        b.MouseButton1Click:Connect(function()
                            if multi then
                                selectedValue[opt] = (not selectedValue[opt]) or nil
                                refresh()
                                task.spawn(callback, selectedValue)
                            else
                                obj:Set(opt)
                                closePopup()
                            end
                        end)
                    end
                    refresh()
                end

                function obj:Set(v)
                    if multi then
                        selectedValue = {}
                        if type(v) == "table" then
                            for _, o in ipairs(v) do selectedValue[o] = true end
                        end
                    else
                        selectedValue = v
                    end
                    refresh()
                    task.spawn(callback, selectedValue)
                end
                function obj:Get() return selectedValue end
                function obj:SetOptions(newOptions)
                    options = newOptions or {}
                    if multi then
                        for k in pairs(selectedValue) do
                            if not table.find(options, k) then selectedValue[k] = nil end
                        end
                    elseif not table.find(options, selectedValue) then
                        selectedValue = options[1]
                    end
                    build()
                end

                head.MouseButton1Click:Connect(function()
                    local ap, as = head.AbsolutePosition, head.AbsoluteSize
                    local h = #options * 16 + 2
                    list.Size = UDim2.fromOffset(as.X, h)
                    local y = ap.Y + as.Y + 1 -- opens below the box
                    if y + h > screenSize().Y then y = ap.Y - h - 1 end -- only flips up if there is no room
                    list.Position = UDim2.fromOffset(ap.X, y)
                    openPopup(list)
                end)
                build()
                reg(multi and "multi" or "dropdown", text, obj)
                return vis(obj, holder2)
            end

            function Section:AddMultiDropdown(text, options, default, callback)
                return Section:AddDropdown(text, options, default, callback, true)
            end

            -- standalone keybind: "Label                [-]"
            function Section:AddKeybind(text, key, mode, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rb = rightBox(r)
                rb.ZIndex = 8
                local obj = makeKeybind(rb, key, mode, callback, ctx)
                reg("keybind", text, obj)
                return vis(obj, r)
            end

            -- standalone colour picker: "Label                [###]"
            function Section:AddColorPicker(text, color, alpha, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rb = rightBox(r)
                rb.ZIndex = 8
                local obj = makeColorPicker(rb, color, alpha, callback, ctx)
                reg("color", text, obj)
                return vis(obj, r)
            end

            -- button
            function Section:AddButton(text, callback)
                callback = callback or function() end
                local r = row(20)
                local b = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 1, 0),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Theme.Text,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    AutoButtonColor = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(b, Theme.Outline, 1)
                b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(46, 46, 46) end)
                b.MouseLeave:Connect(function() b.BackgroundColor3 = Theme.Element end)
                b.MouseButton1Click:Connect(function() task.spawn(callback) end)
                local obj = { Instance = b }
                function obj:SetText(t) b.Text = t end
                return vis(obj, r)
            end

            -- label
            function Section:AddLabel(text)
                local r = row(14)
                local l = label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    TextColor3 = Theme.TextDim,
                    ZIndex = 8,
                })
                local obj = { Instance = l }
                function obj:Set(t) l.Text = t end
                function obj:SetColor(c) l.TextColor3 = c end
                return vis(obj, r)
            end

            -- textbox
            function Section:AddTextbox(text, default, callback)
                callback = callback or function() end
                local r = row(36)
                label(r, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 12),
                    ZIndex = 8,
                })
                local tb = new("TextBox", {
                    Position = UDim2.fromOffset(INDENT, 15),
                    Size = UDim2.new(1, -RESERVE, 0, 18),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = default or "",
                    PlaceholderText = "...",
                    PlaceholderColor3 = Theme.TextDim,
                    TextColor3 = Theme.Text,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(tb, Theme.Outline, 1)
                new("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = tb })
                tb.FocusLost:Connect(function() task.spawn(callback, tb.Text) end)
                local obj = { Instance = tb }
                function obj:Get() return tb.Text end
                function obj:Set(t) tb.Text = tostring(t or "") task.spawn(callback, tb.Text) end
                reg("textbox", text, obj)
                return vis(obj, r)
            end

            -- thin line between groups of controls
            function Section:AddSeparator()
                local r = row(8)
                new("Frame", {
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = r,
                })
                return vis({}, r)
            end

            function Section:AddSpacer(h)
                return vis({}, row(h or 8))
            end

            return Section
        end

        return Tab
    end

    -- ready made config tab (uses the config icon)
    function Window:AddConfigTab(opts)
        opts = opts or {}
        local tab = Window:AddTab({ Name = "Config", Icon = opts.Icon or "config" })

        local presets = tab:AddSection("Presets", "Left")
        local nameBox
        local list = presets:AddDropdown("Config list", Window:ListConfigs(), nil, function(v)
            if nameBox and v then nameBox:Set(v) end
        end)
        nameBox = presets:AddTextbox("Config name", "default")
        local function refreshList() list:SetOptions(Window:ListConfigs()) end
        local function result(ok, msg, good)
            Window:Notify(ok and good or ("Failed: " .. tostring(msg)))
        end
        presets:AddButton("Save", function()
            local n = nameBox:Get()
            local ok, err = Window:SaveConfig(n)
            result(ok, err, "Saved config " .. n)
            refreshList()
        end)
        presets:AddButton("Load", function()
            local n = nameBox:Get()
            local ok, err = Window:LoadConfig(n)
            result(ok, err, "Loaded config " .. n)
        end)
        presets:AddButton("Delete", function()
            local n = nameBox:Get()
            local ok, err = Window:DeleteConfig(n)
            result(ok, err, "Deleted config " .. n)
            refreshList()
        end)
        presets:AddButton("Refresh list", refreshList)

        local share = tab:AddSection("Share", "Right")
        share:AddButton("Export to clipboard", function()
            if setclipboard then
                setclipboard(Window:ExportConfig())
                Window:Notify("Config copied to clipboard")
            else
                Window:Notify("Failed: your executor has no setclipboard")
            end
        end)
        local importBox = share:AddTextbox("Import string", "")
        share:AddButton("Import", function()
            local ok, err = Window:ImportConfig(importBox:Get())
            result(ok, err, "Imported config")
        end)
        share:AddSeparator()
        share:AddButton("Unload UI", function() Window:Destroy() end)
        return tab
    end

    return Window
end

return Library
