                local minus = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT - 8, 12),
                    Size = UDim2.fromOffset(8, 12),
                    BackgroundTransparency = 1,
                    Text = "-",
                    TextColor3 = Theme.TextDim,
                    Font = Theme.Font,
                    TextSize = 11,
                    ZIndex = 8,
                    Parent = holder2,
                })
                local plus = new("TextButton", {
                    Position = UDim2.new(1, -(RESERVE - INDENT) + 3, 0, 12),
                    Size = UDim2.fromOffset(8, 12),
                    BackgroundTransparency = 1,
                    Text = "+",
                    TextColor3 = Theme.TextDim,
                    Font = Theme.Font,
                    TextSize = 11,
                    ZIndex = 8,
                    Parent = holder2,
                })

                local function format(x)
                    if type(fmt) == "function" then return tostring(fmt(x)) end
                    return tostring(x) .. (fmt or "")
                end
                local obj = {}
                local function render()
                    local a = (max == min) and 0 or (value - min) / (max - min)
                    fill.Size = UDim2.new(a, 0, 1, 0)
                    valueLabel.AnchorPoint = Vector2.new(a, 0)
                    valueLabel.Position = UDim2.new(a, 0, 0, 0)
                    valueLabel.Text = format(value)
                end
                function obj:Set(x)
                    value = snap(x)
                    render()
                    task.spawn(callback, value)
                end
                function obj:Get() return value end
                function obj:SetText(t) lbl.Text = t end
                render()

                minus.MouseButton1Click:Connect(function() obj:Set(value - step) end)
                plus.MouseButton1Click:Connect(function() obj:Set(value + step) end)

                local dragging = false
                local function update(x)
                    local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
