-- ───────────────────────── keybind widget ─────────────────────────
local MODES = {
    { "Always on", "Always" },
    { "On hotkey", "Hold" },
    { "Toggle", "Toggle" },
    { "Off hotkey", "Off" },
}

local function keyText(k)
    if not k then return "[-]" end
    local n = k.Name
    if k == Enum.UserInputType.MouseButton2 then n = "M2" end
    if k == Enum.UserInputType.MouseButton3 then n = "M3" end
    return "[" .. n .. "]"
end

local function makeKeybind(container, key, mode, callback, ctx)
    callback = callback or function() end
    mode = mode or "Hold"
    local listening = false
    local active = (mode == "Always") or (mode == "Off")

    local btn = new("TextButton", {
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, 12),
        BackgroundTransparency = 1,
        Text = keyText(key),
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        AutoButtonColor = false,
        LayoutOrder = #container:GetChildren(),
        Parent = container,
    })

    local function setActive(v)
        if v ~= active then
            active = v
            task.spawn(callback, active)
        end
    end

    -- mode popup (right click)
    local pop = new("Frame", {
        Size = UDim2.fromOffset(84, #MODES * 16 + 2),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Visible = false,
        Active = true,
        ZIndex = 2,
        Parent = ctx.layer,
    })
    stroke(pop, Theme.Outline, 1)
    local modeButtons = {}
    local function refreshModes()
        for m, b in pairs(modeButtons) do
            b.TextColor3 = (m == mode) and Theme.Text or Theme.TextDim
            b.Font = (m == mode) and Theme.FontBold or Theme.Font
        end
    end
    for i, m in ipairs(MODES) do
        local b = new("TextButton", {
            Position = UDim2.fromOffset(0, (i - 1) * 16 + 1),
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text = "  " .. m[1],
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = Theme.TextDim,
            Font = Theme.Font,
            TextSize = 11,
            Parent = pop,
        })
        modeButtons[m[2]] = b
        b.MouseButton1Click:Connect(function()
            mode = m[2]
            if mode == "Always" or mode == "Off" then setActive(true) else setActive(false) end
            refreshModes()
            ctx.close()
        end)
    end
    refreshModes()

    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "[...]"
        btn.TextColor3 = Theme.Accent
    end)
    btn.MouseButton2Click:Connect(function()
        local ap = btn.AbsolutePosition
        local screen = ctx.screen()
        local x = math.min(ap.X, screen.X - 84 - 4)
        local y = ap.Y + btn.AbsoluteSize.Y + 2
        if y + #MODES * 16 + 2 > screen.Y then y = ap.Y - (#MODES * 16 + 2) - 2 end
        pop.Position = UDim2.fromOffset(x, y)
        ctx.open(pop)
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if listening then
            local k
            if input.UserInputType == Enum.UserInputType.Keyboard then
                k = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                k = input.UserInputType
            end
            if k then
                listening = false
                key = (k ~= Enum.KeyCode.Escape) and k or nil
                btn.Text = keyText(key)
                btn.TextColor3 = Theme.TextDim
            end
            return
        end
        if gp or not key then return end
        if input.KeyCode == key or input.UserInputType == key then
            if mode == "Hold" then setActive(true)
            elseif mode == "Toggle" then setActive(not active)
            elseif mode == "Off" then setActive(false) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not key then return end
        if input.KeyCode == key or input.UserInputType == key then
            if mode == "Hold" then setActive(false)
            elseif mode == "Off" then setActive(true) end
        end
    end)

    local obj = { Instance = btn }
    function obj:Get() return active end
    function obj:GetKey() return key end
    function obj:SetKey(k) key = k btn.Text = keyText(key) end
    function obj:GetMode() return mode end
    function obj:SetMode(m) mode = m refreshModes() end
    function obj:SetVisible(v) btn.Visible = v end
    return obj
end

-- ───────────────────────── colour picker widget ─────────────────────────
local function makeColorPicker(container, default, hasAlpha, callback, ctx)
    callback = callback or function() end
    local color = default or Color3.fromRGB(255, 255, 255)
    local h, s, v = color:ToHSV()
    local alpha = 1

    local box = new("TextButton", {
        Size = UDim2.fromOffset(17, 9),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = #container:GetChildren(),
        Parent = container,
    })
    stroke(box, Theme.Outline, 1)

    local W = 186
    local H = hasAlpha and 190 or 170
    local pop = new("Frame", {
        Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Visible = false,
        Active = true,
        ZIndex = 2,
        Parent = ctx.layer,
    })
    stroke(pop, Theme.Border, 1)

    -- saturation / value square
    local sv = new("Frame", {
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.fromOffset(150, 150),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = pop,
    })
    stroke(sv, Theme.Outline, 1)
    local white = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sv,
    })
    new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = sv,
    })
    new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black })
    local svCursor = new("Frame", {
        Size = UDim2.fromOffset(6, 6),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = sv,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = svCursor })
    stroke(svCursor, Theme.Outline, 1)
    local svHit = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 6,
        Parent = sv,
    })

    -- hue bar
    local hueBar = new("TextButton", {
        Position = UDim2.fromOffset(166, 8),
        Size = UDim2.fromOffset(12, 150),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 1,
        Parent = pop,
    })
    stroke(hueBar, Theme.Outline, 1)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,     Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1,     Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hueBar,
    })
    local hueCursor = new("Frame", {
        Size = UDim2.fromOffset(16, 2),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = hueBar,
    })
    stroke(hueCursor, Theme.Outline, 1)

    -- alpha bar
    local alphaBar, alphaFill, alphaCursor
    if hasAlpha then
        alphaBar = new("TextButton", {
            Position = UDim2.fromOffset(8, 166),
            Size = UDim2.fromOffset(150, 10),
            BackgroundColor3 = Color3.fromRGB(70, 70, 70),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 1,
            Parent = pop,
        })
        stroke(alphaBar, Theme.Outline, 1)
        alphaFill = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = alphaBar,
        })
        new("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = alphaFill })
        alphaCursor = new("Frame", {
            Size = UDim2.fromOffset(2, 14),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 5,
            Parent = alphaBar,
        })
        stroke(alphaCursor, Theme.Outline, 1)
    end

    local function refresh(fire)
        color = Color3.fromHSV(h, s, v)
        box.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(0.5, h)
        if hasAlpha then
            alphaFill.BackgroundColor3 = color
            alphaCursor.Position = UDim2.fromScale(alpha, 0.5)
        end
        if fire then task.spawn(callback, color, alpha) end
    end
    refresh(false)

    local mode
    local function update(pos)
        if mode == "sv" then
            s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        elseif mode == "hue" then
            h = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
        elseif mode == "alpha" and hasAlpha then
            alpha = math.clamp((pos.X - alphaBar.AbsolutePosition.X) / alphaBar.AbsoluteSize.X, 0, 1)
        end
        refresh(true)
    end
    local function hook(obj, m)
        obj.InputBegan:Connect(function(input)
            if isPress(input) then
                mode = m
                update(input.Position)
            end
        end)
    end
    hook(svHit, "sv")
    hook(hueBar, "hue")
    if hasAlpha then hook(alphaBar, "alpha") end
    UserInputService.InputChanged:Connect(function(input)
        if mode and isMove(input) then update(input.Position) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if isPress(input) then mode = nil end
    end)

    box.MouseButton1Click:Connect(function()
        local ap = box.AbsolutePosition
        local screen = ctx.screen()
        local x = math.max(4, math.min(ap.X, screen.X - W - 4))
        local y = ap.Y + box.AbsoluteSize.Y + 4
        if y + H > screen.Y then y = ap.Y - H - 4 end
        pop.Position = UDim2.fromOffset(x, y)
        ctx.open(pop)
    end)

    local obj = { Instance = box }
    function obj:Get() return color, alpha end
    function obj:Set(c, a)
        h, s, v = c:ToHSV()
        if a then alpha = a end
        refresh(true)
    end
    function obj:SetVisible(vis) box.Visible = vis end
    return obj
end

-- ───────────────────────── window ─────────────────────────
function Library:CreateWindow(cfg)
    cfg = cfg or {}
    local bind = cfg.Bind or Enum.KeyCode.RightShift
    local size = cfg.Size or Vector2.new(660, 560)
    local TAB_W = 80
    local HEADER = 14 -- drag strip at the top

    local gui = new("ScreenGui", {
        Name = "GamesenseLib",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = getParent(),
    })

    -- layered borders (black / grey / black) like skeet
    local outer = new("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(size.X, size.Y),
        Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = gui,
    })
    stroke(outer, Theme.Outline, 1)

    local mid = new("Frame", {
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.fromOffset(1, 1),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = outer,
    })
    stroke(mid, Theme.Border, 1)

    local inner = new("Frame", {
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.fromOffset(1, 1),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = mid,
    })
    stroke(inner, Theme.Outline, 1)

    gradientLine(inner)

    -- popups (dropdown lists, colour pickers, keybind modes) live above everything
    local popupLayer = new("Frame", {
        Name = "Popups",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 100,
        Parent = gui,
    })
    local blocker = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Visible = false,
        ZIndex = 1,
        Parent = popupLayer,
    })
    local activePopup
    local function closePopup()
        if activePopup then
            activePopup.Visible = false
            activePopup = nil
        end
        blocker.Visible = false
    end
    local function openPopup(frame)
        closePopup()
        activePopup = frame
        frame.Visible = true
        blocker.Visible = true
    end
    blocker.MouseButton1Down:Connect(closePopup)
    blocker.MouseButton2Down:Connect(closePopup)

    local ctx = { gui = gui, layer = popupLayer, open = openPopup, close = closePopup, screen = screenSize }

    -- notifications (top left)
    local notifyLayer = new("Frame", {
        Name = "Notifications",
        Size = UDim2.new(0, 320, 1, -20),
        Position = UDim2.fromOffset(10, 10),
        BackgroundTransparency = 1,
        ZIndex = 200,
        Parent = gui,
    })
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
        Parent = notifyLayer,
    })

    -- textured background behind the tabs (darker than the page texture)
    local tabBg = new("ImageLabel", {
        Name = "TabTexture",
        Size = UDim2.new(0, TAB_W, 1, -2),
        Position = UDim2.fromOffset(0, 2),
        BackgroundColor3 = Theme.TabBase,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Image = Theme.Texture,
        ImageColor3 = Theme.TabColor,
        ImageTransparency = Theme.TextureTransparency,
        ScaleType = Enum.ScaleType.Tile,
        TileSize = UDim2.fromOffset(Theme.TextureTile, Theme.TextureTile),
        ZIndex = 2,
        Parent = inner,
    })

    -- holds the tab buttons (transparent so the texture shows through)
    local tabBar = new("Frame", {
        Size = UDim2.new(0, TAB_W, 1, -2 - HEADER),
        Position = UDim2.fromOffset(0, 2 + HEADER),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = inner,
    })
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 0),
        Parent = tabBar,
    })

    -- page area
    local content = new("Frame", {
        Size = UDim2.new(1, -TAB_W, 1, -2),
        Position = UDim2.fromOffset(TAB_W, 2),
        BackgroundColor3 = Theme.TextureBase,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 3,
        Parent = inner,
