                function obj:Set(v)
                    if multi then
                        selectedValue = {}
                        if type(v) == "table" then
                            for _, o in ipairs(v) do selectedValue[o] = true end
                        end
                    else
                        selectedValue = v
                    end
                    refresh()
                    task.spawn(callback, selectedValue)
                    fire(selectedValue)
                end
                function obj:Get() return selectedValue end
                function obj:OnChanged(fn) onChanged(fn) return obj end
                function obj:SetOptions(newOptions)
                    options = newOptions or {}
                    build()
                end
                build()
                reg(multi and "multilist" or "listbox", text, obj)
                return vis(obj, holder2)
            end

            function Section:AddKeybind(text, key, mode, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rbox = rightBox(r)
                rbox.ZIndex = 8
                local obj = makeKeybind(rbox, key, mode, callback, ctx, text)
                reg("keybind", text, obj)
                return vis(obj, r)
            end

            function Section:AddColorPicker(text, color, alpha, callback)
                local r = row(16)
                label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    ZIndex = 8,
                })
                local rbox = rightBox(r)
                rbox.ZIndex = 8
                local obj = makeColorPicker(rbox, color, alpha, callback, ctx)
                reg("color", text, obj)
                return vis(obj, r)
            end

            function Section:AddButton(text, callback)
                callback = callback or function() end
                local r = row(20)
                local b = new("TextButton", {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 1, 0),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(b, Theme.Outline, 1)
                shine(b, 200)
                local bl = label(b, text, {
                    Size = UDim2.fromScale(1, 1),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                })
                b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(46, 46, 46) end)
                b.MouseLeave:Connect(function() b.BackgroundColor3 = Theme.Element end)
                b.MouseButton1Click:Connect(function() task.spawn(callback) end)
                local obj = { Instance = b }
                function obj:SetText(t) bl.Text = t end
                return vis(obj, r)
            end

            function Section:AddLabel(text)
                local r = row(14)
                local l = label(r, text, {
                    Size = UDim2.new(1, -INDENT, 1, 0),
                    Position = UDim2.fromOffset(INDENT, 0),
                    TextColor3 = Theme.TextDim,
                    ZIndex = 8,
                })
                local rbox
                local obj = { Instance = l }
                function obj:Set(t) l.Text = t end
                function obj:SetColor(c) l.TextColor3 = c end
                function obj:AddColorPicker(color, alpha, cb)
                    rbox = rbox or rightBox(r)
                    rbox.ZIndex = 8
                    local c = makeColorPicker(rbox, color, alpha, cb, ctx)
                    reg("color", text .. " colour", c)
                    return c
                end
                function obj:AddKeybind(key, mode, cb)
                    rbox = rbox or rightBox(r)
                    rbox.ZIndex = 8
                    local k = makeKeybind(rbox, key, mode, cb, ctx, text)
                    reg("keybind", text .. " key", k)
                    return k
                end
                return vis(obj, r)
            end

            function Section:AddInfo(text)
                local r = new("Frame", {
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(),
                    ZIndex = 7,
                    Parent = items,
                })
                local l = label(r, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    TextWrapped = true,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    TextColor3 = Theme.TextDim,
                    ZIndex = 8,
                })
                local obj = { Instance = l }
                function obj:Set(t) l.Text = t end
                function obj:SetColor(c) l.TextColor3 = c end
                return vis(obj, r)
            end

            function Section:AddTextbox(text, default, callback)
                callback = callback or function() end
                local r = row(36)
                label(r, text, {
                    Position = UDim2.fromOffset(INDENT, 0),
                    Size = UDim2.new(1, -RESERVE, 0, 12),
                    ZIndex = 8,
                })
                local tb = new("TextBox", {
                    Position = UDim2.fromOffset(INDENT, 15),
                    Size = UDim2.new(1, -RESERVE, 0, 18),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = default or "",
                    PlaceholderText = "...",
                    PlaceholderColor3 = Theme.TextDim,
                    TextColor3 = Theme.Text,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 8,
                    Parent = r,
                })
                stroke(tb, Theme.Outline, 1)
                shine(tb, 200)
                new("UIPadding", { PaddingLeft = UDim.new(0, 6), Parent = tb })
                tb.FocusLost:Connect(function() task.spawn(callback, tb.Text) end)
                local obj = { Instance = tb }
                function obj:Get() return tb.Text end
                function obj:Set(t) tb.Text = tostring(t or "") task.spawn(callback, tb.Text) end
                reg("textbox", text, obj)
                return vis(obj, r)
            end

            function Section:AddSeparator()
                local r = row(8)
                new("Frame", {
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = r,
                })
                return vis({}, r)
            end

            function Section:AddSpacer(h)
                return vis({}, row(h or 8))
            end

            return Section
        end

        return Tab
    end

    function Window:AddConfigTab(opts)
        opts = opts or {}
        local tab = Window:AddTab({ Name = "Config", Icon = opts.Icon or "config" })

        local presets = tab:AddSection("Presets", "Left")
        local nameBox
        local list = presets:AddDropdown("Config list", Window:ListConfigs(), nil, function(v)
            if nameBox and v then nameBox:Set(v) end
        end)
        nameBox = presets:AddTextbox("Config name", "default")
        local function refreshList() list:SetOptions(Window:ListConfigs()) end
        local function result(ok, msg, good)
            Window:Notify(ok and good or ("Failed: " .. tostring(msg)))
        end
        presets:AddButton("Save", function()
            local n = nameBox:Get()
            local ok, err = Window:SaveConfig(n)
            result(ok, err, "Saved config " .. n)
            refreshList()
        end)
        presets:AddButton("Load", function()
            local n = nameBox:Get()
            local ok, err = Window:LoadConfig(n)
            result(ok, err, "Loaded config " .. n)
        end)
        presets:AddButton("Delete", function()
            local n = nameBox:Get()
            local ok, err = Window:DeleteConfig(n)
            result(ok, err, "Deleted config " .. n)
            refreshList()
        end)
        presets:AddButton("Refresh list", refreshList)

        local menu = tab:AddSection("Menu", "Left")
        menu:AddLabel("Menu accent"):AddColorPicker(Theme.Accent, false, function(c) Window:SetAccent(c) end)
        menu:AddToggle("Keybind list", kbEnabled, function(v) Window:SetKeybindList(v) end)
        menu:AddToggle("Watermark", wmTemplate ~= nil, function(v)
            Window:SetWatermark(v and DEFAULT_WATERMARK or nil)
        end)
        local menuKey = menu:AddKeybind("Menu key", bind, "Always")
        menuKey.KeyChanged = function(k)
            if k and typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then
                Window:SetBind(k)
            end
        end

        local share = tab:AddSection("Right", "Right")
        share:AddButton("Export to clipboard", function()
            if setclipboard then
                setclipboard(Window:ExportConfig())
                Window:Notify("Config copied to clipboard")
            else
                Window:Notify("Failed: your executor has no setclipboard")
            end
        end)
        local importBox = share:AddTextbox("Import string", "")
        share:AddButton("Import", function()
            local ok, err = Window:ImportConfig(importBox:Get())
            result(ok, err, "Imported config")
        end)
        share:AddSeparator()
        share:AddButton("Unload UI", function() Window:Destroy() end)
        return tab
    end

    if cfg.Watermark then
        Window:SetWatermark(cfg.Watermark == true and DEFAULT_WATERMARK or cfg.Watermark)
    end
    refreshKeybinds()

    return Window
end

return Library
