local function label(parent, text, props)
    props = props or {}
    local l = new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Theme.Font,
        TextSize = Theme.TextSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    })
    local noShadow = props.NoShadow
    for k, v in pairs(props) do
        if k ~= "NoShadow" then l[k] = v end
    end
    if noShadow then return l end

    local sh = new("TextLabel", {
        Name = "Shadow",
        BackgroundTransparency = 1,
        Text = l.Text,
        TextColor3 = Color3.new(0, 0, 0),
        Font = l.Font,
        TextSize = l.TextSize,
        TextXAlignment = l.TextXAlignment,
        TextYAlignment = l.TextYAlignment,
        TextWrapped = l.TextWrapped,
        TextTruncate = l.TextTruncate,
        AutomaticSize = l.AutomaticSize,
        AnchorPoint = l.AnchorPoint,
        Size = l.Size,
        Position = l.Position + UDim2.fromOffset(1, 1),
        ZIndex = math.max(l.ZIndex - 1, 1),
        Parent = parent,
    })
    local function sync()
        sh.Text = l.Text
        sh.Size = l.Size
        sh.Position = l.Position + UDim2.fromOffset(1, 1)
        sh.AnchorPoint = l.AnchorPoint
        sh.Visible = l.Visible
        sh.TextTransparency = l.TextTransparency
    end
    for _, p in ipairs({ "Text", "Size", "Position", "AnchorPoint", "Visible", "TextTransparency" }) do
        l:GetPropertyChangedSignal(p):Connect(sync)
    end
    return l, sh
end

local function padLabel(l, sh, props)
    local a = {}
    local b = {}
    for k, v in pairs(props) do a[k] = v b[k] = v end
    a.Parent = l
    new("UIPadding", a)
    if sh then
        b.Parent = sh
        new("UIPadding", b)
    end
end

