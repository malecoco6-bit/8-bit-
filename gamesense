local function resolveIcon(icon)
    if type(icon) == "string" and ICON_NAMES[icon:lower()] then
        icon = ICON_NAMES[icon:lower()]
    end
    if type(icon) == "number" and ICONS[icon] then
        icon = ICONS[icon]
    end
    if icon == nil then return nil end
    icon = tostring(icon)
    if icon:match("^%d+$") then
        icon = "rbxassetid://" .. icon
    end
    return icon
end

