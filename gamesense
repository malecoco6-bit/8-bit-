    stroke(box, Theme.Outline, 1)
    shine(box, 190)

    local PAD, SVS, HUEW = 4, 150, 12
    local FULLW = SVS + 4 + HUEW            -- width of the bars under the square
    local W = PAD * 2 + FULLW
    local H = PAD + SVS + 4 + (hasAlpha and 12 or 0) + 8 + PAD
    local pop = makePanel(ctx, W, H)

    local sv = new("Frame", {
        Position = UDim2.fromOffset(PAD, PAD),
        Size = UDim2.fromOffset(SVS, SVS),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = pop,
    })
    stroke(sv, Theme.Outline, 1)
    local white = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sv,
    })
    new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = sv,
    })
    new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black })
    -- dragger: a small square dot (no UICorner)
    local svCursor = new("Frame", {
        Size = UDim2.fromOffset(4, 4),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = sv,
    })
    stroke(svCursor, Color3.new(0, 0, 0), 1)
    local svHit = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 6,
        Parent = sv,
    })

    local hueBar = new("TextButton", {
        Position = UDim2.fromOffset(PAD + SVS + 4, PAD),
        Size = UDim2.fromOffset(HUEW, SVS),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 1,
        Parent = pop,
    })
    stroke(hueBar, Theme.Outline, 1)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,     Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1,     Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hueBar,
    })
    local hueCursor = new("Frame", {
        Size = UDim2.new(1, 2, 0, 2),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = hueBar,
    })
    stroke(hueCursor, Theme.Outline, 1)

    local alphaBar, alphaFill, alphaCursor
    local nextY = PAD + SVS + 4
    if hasAlpha then
        alphaBar = new("TextButton", {
            Position = UDim2.fromOffset(PAD, nextY),
            Size = UDim2.fromOffset(FULLW, 8),
            BackgroundColor3 = Color3.fromRGB(70, 70, 70),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ClipsDescendants = true,
            ZIndex = 1,
            Parent = pop,
        })
        stroke(alphaBar, Theme.Outline, 1)
        -- transparency checkerboard (4px squares) behind the colour fade
        for cx = 0, math.ceil(FULLW / 4) - 1 do
            for cy = 0, 1 do
                new("Frame", {
                    Position = UDim2.fromOffset(cx * 4, cy * 4),
                    Size = UDim2.fromOffset(4, 4),
                    BackgroundColor3 = ((cx + cy) % 2 == 0) and Color3.fromRGB(205, 205, 205) or Color3.fromRGB(140, 140, 140),
                    BorderSizePixel = 0,
                    ZIndex = 1,
                    Parent = alphaBar,
                })
            end
        end
        alphaFill = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = alphaBar,
        })
        new("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = alphaFill })
        alphaCursor = new("Frame", {
            Size = UDim2.new(0, 2, 1, 2),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 5,
            Parent = alphaBar,
        })
        stroke(alphaCursor, Theme.Outline, 1)
        nextY = nextY + 12
    end

    -- solid preview bar at the bottom
    local preview = new("Frame", {
        Position = UDim2.fromOffset(PAD, nextY),
        Size = UDim2.fromOffset(FULLW, 8),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = pop,
    })
    stroke(preview, Theme.Outline, 1)
    shine(preview, 205)

    local function refresh(fire)
        color = Color3.fromHSV(h, s, v)
        box.BackgroundColor3 = color
        preview.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(0.5, h)
        if hasAlpha then
            alphaFill.BackgroundColor3 = color
            alphaCursor.Position = UDim2.fromScale(alpha, 0.5)
        end
        if fire then task.spawn(callback, color, alpha) end
    end
    refresh(false)

    local mode
    local function update(pos)
        if mode == "sv" then
            s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        elseif mode == "hue" then
            h = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
        elseif mode == "alpha" and hasAlpha then
            alpha = math.clamp((pos.X - alphaBar.AbsolutePosition.X) / alphaBar.AbsoluteSize.X, 0, 1)
        end
        refresh(true)
    end
    local function hook(obj, m)
        obj.InputBegan:Connect(function(input)
            if isPress(input) then
                mode = m
                update(input.Position)
            end
        end)
    end
    hook(svHit, "sv")
    hook(hueBar, "hue")
    if hasAlpha then hook(alphaBar, "alpha") end
    ctx.track(UserInputService.InputChanged:Connect(function(input)
        if mode and isMove(input) then update(input.Position) end
    end))
    ctx.track(UserInputService.InputEnded:Connect(function(input)
        if isPress(input) then mode = nil end
    end))

    box.MouseButton1Click:Connect(function()
        ctx.place(pop, box, W, H)
        ctx.open(pop)
    end)

    local obj = { Instance = box }
    function obj:Get() return color, alpha end
    function obj:Set(c, a)
        h, s, v = c:ToHSV()
        if a then alpha = a end
        refresh(true)
    end
    function obj:SetVisible(vis) box.Visible = vis end
    return obj
end

local function hoverable(inst, root, m)
    local p = inst
    while p and p ~= root do
        if p:IsA("GuiObject") then
            if not p.Visible then return false end
            if p.ClipsDescendants and p ~= inst then
                local pp, ps = p.AbsolutePosition, p.AbsoluteSize
                if m.X < pp.X or m.X > pp.X + ps.X or m.Y < pp.Y or m.Y > pp.Y + ps.Y then
                    return false
                end
            end
        end
        p = p.Parent
    end
    return true
end

