    if Library.FontFace then
        local fontFace = Library.FontFace
        local boldFace = Library.FontFaceBold or fontFace
        local busy = {}
        local wantBold = {}
        local function skin(d)
            if busy[d] then return end
            busy[d] = true
            pcall(function() d.FontFace = wantBold[d] and boldFace or fontFace end)
            busy[d] = nil
        end
        local function hookText(d)
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                wantBold[d] = (d.Font == Enum.Font.ArialBold)
                skin(d)
                d:GetPropertyChangedSignal("Font"):Connect(function()
                    if busy[d] then return end
                    if d.Font == Enum.Font.ArialBold then
                        wantBold[d] = true
                    elseif d.Font == Enum.Font.Arial or d.Font == Enum.Font.SourceSans then
                        wantBold[d] = false
                    end
                    task.defer(skin, d)
                end)
