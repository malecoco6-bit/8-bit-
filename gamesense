    local Flags = Window.Flags
    local function register(path, kind, obj)
        local p, n = path, 1
        while Flags[p] do
            n += 1
            p = path .. " (" .. n .. ")"
        end
        Flags[p] = { Kind = kind, Obj = obj }
    end

    local function serialize(kind, obj)
        if kind == "toggle" or kind == "slider" or kind == "dropdown" or kind == "textbox" or kind == "listbox" then
            return obj:Get()
        elseif kind == "multi" or kind == "multilist" then
            local t = {}
            for k in pairs(obj:Get()) do t[#t + 1] = k end
            table.sort(t)
            return t
        elseif kind == "color" then
            local c, a = obj:Get()
            return { c.R, c.G, c.B, a }
        elseif kind == "keybind" then
            local k = obj:GetKey()
            return {
                Key = k and k.Name or nil,
                Type = k and ((k.EnumType == Enum.KeyCode) and "KeyCode" or "UserInputType") or nil,
                Mode = obj:GetMode(),
            }
        end
    end

    local function apply(kind, obj, val)
        if kind == "toggle" then obj:Set(val == true)
        elseif kind == "slider" then obj:Set(tonumber(val) or 0)
        elseif kind == "dropdown" or kind == "multi" or kind == "listbox" or kind == "multilist" or kind == "textbox" then obj:Set(val)
        elseif kind == "color" then obj:Set(Color3.new(val[1], val[2], val[3]), val[4])
        elseif kind == "keybind" then
            local k
            if val.Key then
                local enum = (val.Type == "KeyCode") and Enum.KeyCode or Enum.UserInputType
                k = enum[val.Key]
            end
            obj:SetKey(k)
            if val.Mode then obj:SetMode(val.Mode) end
        end
    end

    function Window:GetFlag(path)
        local f = Flags[path]
        if not f then return nil end
        local ok, v = pcall(serialize, f.Kind, f.Obj)
        if ok then return v end
    end

    function Window:ExportConfig()
        local data = {}
        for path, f in pairs(Flags) do
            local ok, v = pcall(serialize, f.Kind, f.Obj)
            if ok and v ~= nil then data[path] = v end
        end
        return HttpService:JSONEncode(data)
    end

    function Window:ImportConfig(json)
        local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
        if not ok or type(data) ~= "table" then return false, "invalid config" end
        for path, val in pairs(data) do
            local f = Flags[path]
            if f then pcall(apply, f.Kind, f.Obj, val) end
        end
        return true
    end

    local function cleanName(n) return (tostring(n):gsub("[^%w _%-]", "")) end
    local function hasFiles() return writefile and readfile and isfile and true or false end
    local function cfgPath(n) return Library.ConfigFolder .. "/" .. cleanName(n) .. ".json" end

    function Window:SaveConfig(name)
        if not hasFiles() then return false, "your executor has no file functions" end
        if isfolder and makefolder and not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
        writefile(cfgPath(name), Window:ExportConfig())
        Window:SetConfigName(cleanName(name))
        return true
    end
    function Window:LoadConfig(name)
        if not hasFiles() then return false, "your executor has no file functions" end
        if not isfile(cfgPath(name)) then return false, "config not found" end
        local ok, err = Window:ImportConfig(readfile(cfgPath(name)))
        if ok then Window:SetConfigName(cleanName(name)) end
        return ok, err
    end
    function Window:DeleteConfig(name)
        if delfile and isfile and isfile(cfgPath(name)) then
            delfile(cfgPath(name))
            return true
        end
        return false, "could not delete"
    end
    function Window:ListConfigs()
